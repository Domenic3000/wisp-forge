// Samples a GSxGS grid of cell types around the player, aligned with the player's
// local "up". The CPU uses it for collisions, liquids and hazards (bits 0-5: the material; bit 6:
// furniture in the background, bit 7: a built back wall, for build mode).
// pc.a = (GS, slot, 0, 0); pc.c = (centreX, centreY, angle, 0). Each player slot has its own grid.
#include "common"
#include "world"
#include "params"
#include "surf_ro"
#include "bglayer"
#include "clouds"
layout(std430, set = 0, binding = 7) restrict writeonly buffer Grid { uint g[]; } grid;
// counts (CNT a mage, names from defs.gd): C_FALL_N = falling blocks overlapping the mage, C_FALL_MAX = the
// longest fall among them, C_CHEST = nearest chest within 44 cells: (4095 - dist^2) << 20 | centreJ << 10 | centreI,
// C_CREAK_N = creaking blocks nearby, C_CREAK = one of them: random << 20 | j << 10 | i,
// C_FELL_N = cells of a felled tree or bush nearby (cut loose, not yet lifted out), C_FELL = one
// of them, packed the same way (scripts/chunks.gd lifts the piece out whole and lets it topple)
layout(std430, set = 0, binding = 3) restrict buffer Counts { uint n[]; } counts;
layout(local_size_x = 16, local_size_y = 16) in;

void main() {
	int GS = pc.a.x;
	int gx4 = int(gl_GlobalInvocationID.x), j = int(gl_GlobalInvocationID.y);
	if (gx4 * 4 >= GS || j >= GS) return;
	vec2 G = pc.c.xy;
	float A = pc.c.z;
	int slot = pc.a.y;
	uint cb = uint(slot) * CNT;
	int goff = slot * GS * (GS / 4);
	vec2 R = vec2(sin(A), -cos(A)), D = vec2(-cos(A), -sin(A));
	// C_FOG: how deep in cloud this mage stands (0-1000)
	if (gx4 == 0 && j == 0) counts.n[cb + C_FOG] = uint(cloudDensity(G) * 1000.0);
	uint pk = 0u;
	for (int q = 0; q < 4; q++) {
		int i = gx4 * 4 + q;
		vec2 pos = G + R * (float(i - GS / 2) + 0.5) + D * (float(j - GS / 2) + 0.5);
		uint full = cellAt(pos);
		uint t = full & 255u;
		uint lifeF = (full >> 16) & 255u;
		float di = float(i - GS / 2) + 0.5, dj = float(j - GS / 2) + 0.5;
		bool looseF = KIND[t] == K_SOLID && (full & ST_ANCHOR) == 0u && stOf(full) > SPAN[t];
		if (looseF && lifeF >= 128u && di * di + dj * dj < 160.0 * 160.0) {
			atomicAdd(counts.n[cb + C_CREAK_N], 1u);
			uint hsh = hashu(uint(i) * 7919u ^ uint(j) * 104729u ^ uint(P.p[0].y)) & 0xfffu;
			atomicMax(counts.n[cb + C_CREAK], (hsh << 20) | (uint(j) << 10) | uint(i));
		}
		if (di * di + dj * dj < 150.0 * 150.0) {
			int pi2 = idxAt(pos);
			uint ap = pi2 < 0 ? 0u : aux.a[pi2];
			if ((ap & 0x80000000u) != 0u && (ap & 255u) != 0u && ((ap >> 8) & 63u) >= 62u) {
				atomicAdd(counts.n[cb + C_FELL_N], 1u);
				uint hp = hashu(uint(i) * 3571u ^ uint(j) * 7919u ^ uint(P.p[0].y)) & 0xfffu;
				atomicMax(counts.n[cb + C_FELL], (hp << 20) | (uint(j) << 10) | uint(i));
			}
		}
		if (abs(di) <= 44.5 && abs(dj) <= 44.5) {
			int ci = idxAt(pos);
			uint a8 = ci < 0 ? 0u : aux.a[ci];
			bool fgChest = t == M_TREASURE;
			if (fgChest || (a8 & 255u) == M_TREASURE) {
				// this cell knows which part of its 12 x 9 chest it is: find the chest's centre
				uint v = fgChest ? (full >> 8) & 255u : (a8 >> 16) & 255u;
				float pi = float(v & 15u), pj = float((v >> 4) & 15u);
				// columns grow against the grid's x axis, rows grow along its y axis
				float ic = float(i) + (pi - 5.5);
				float jc = float(j) + (4.0 - pj);
				uint d2 = uint(min(di * di + dj * dj, 4095.0));
				atomicMax(counts.n[cb + C_CHEST], ((4095u - d2) << 20) | (uint(clamp(jc, 0.0, 1023.0)) << 10) | uint(clamp(ic, 0.0, 1023.0)));
			}
		}
		// (only through the upper half: a clod sliding down beside your legs as you drop into a pit
		// you dug isn't one falling on you)
		if (looseF && lifeF > 0u && lifeF < 128u && abs(di) <= 4.5 && dj >= -11.5 && dj <= 0.0) {
			atomicAdd(counts.n[cb + C_FALL_N], 1u);
			atomicMax(counts.n[cb + C_FALL_MAX], lifeF);
		}
		// falling sand / snow / rain (nothing under it yet) never blocks or drags bodies
		if (KIND[t] == K_POWDER || KIND[t] == K_LIQUID) {
			uint b = cellTypeAt(pos + D) & 255u;
			if (b == 0u || KIND[b] == K_GAS || KIND[b] == K_FIRE) t = 0u;
		}
		// lone pixels (open on three or four sides) never snag bodies, however hard they are
		if (isBlock(t)) {
			int open = 0;
			if (!isBlock(cellTypeAt(pos - D) & 255u)) open++;
			if (!isBlock(cellTypeAt(pos + D) & 255u)) open++;
			if (!isBlock(cellTypeAt(pos - R) & 255u)) open++;
			if (!isBlock(cellTypeAt(pos + R) & 255u)) open++;
			if (open >= 3) t = 0u;
		}
		// what's built in the background here (build mode reads it): 0x40 furniture, a torch or an opened
		// chest; 0x80 a built back wall; 0xC0 a tree (material ids stay below 64, so the top two bits are free)
		int bi = idxAt(pos);
		uint ab = bi < 0 ? 0u : aux.a[bi];
		uint bm = ab & 255u;
		uint bgf = 0u;
		if (bm == M_DECOR || bm == M_TORCH || bm == M_OPENCHEST) bgf = 0x40u;
		else if (bm != 0u && (ab & BG_WALL) != 0u) bgf = 0x80u;
		else if (bm != 0u && bm != M_ROOT && (ab & 0xC0000000u) == 0x80000000u) bgf = 0xC0u;   // a tree (building over it would fell it; a bush or roots are just covered)
		pk |= (t | bgf) << (8 * q);
	}
	grid.g[goff + j * (GS / 4) + gx4] = pk;
}
