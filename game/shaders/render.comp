// Final picture, 16-bit style. One thread per screen pixel: maps the pixel onto
// the round planet, textures the cell (ramps, lit top edges, shaded undersides),
// draws background plants, cave walls, parallax hills, sky, clouds and space,
// applies banded lighting and quantises everything to 15-bit colour with an
// ordered (Bayer) dither, like a SNES.
// pc.a = (VW, VH, LW, LH)
#include "common"
#include "world"
#include "params"
#include "surf_ro"
#include "bglayer"
#include "clouds"
#include "seen"
layout(std430, set = 0, binding = 4) restrict readonly buffer LightIn { vec4 l[]; } li;
layout(std430, set = 0, binding = 6) restrict writeonly buffer View { uint px[]; } view;
layout(local_size_x = 16, local_size_y = 16) in;

const float BAYER[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
float DITH;      // ordered-dither offset for this pixel, scaled by the Dithering setting (0.5 = none)
float LSTEPS;    // lighting steps
float TIME;

// the light at a pixel (rgb) and how clear of fog it is (a), between the light grid's points
vec4 lightAt(vec2 px, int LW, int LH, float LS) {
	vec2 f = px / LS - 0.5;
	vec2 fl = floor(f);
	vec2 t = clamp(f - fl, 0.0, 1.0);
	int x0 = clamp(int(fl.x), 0, LW - 1), y0 = clamp(int(fl.y), 0, LH - 1);
	int x1 = min(x0 + 1, LW - 1), y1 = min(y0 + 1, LH - 1);
	vec4 a = li.l[y0 * LW + x0], b = li.l[y0 * LW + x1], c = li.l[y1 * LW + x0], d = li.l[y1 * LW + x1];
	return mix(mix(a, b, t.x), mix(c, d, t.x), t.y);
}

vec3 ramp(uint t, int l) { return palColor(t, uint(clamp(l, 0, 3))); }

// stable world-cell coordinates for texture patterns (the cell's column in surface-shell units, row)
ivec2 cellCoord(vec2 p) {
	float r = length(p);
	int y = clamp(int(floor(R_TOP - r)), -ORBIT_ROWS, ROWS - 1);
	int s = shellOf(y);
	int x = min(int(angleOf(p) / TAU * float(SH_N(s))), SH_N(s) - 1);
	return ivec2((x * NS) / SH_N(s), y);
}

bool solidC(uint c) { return isBlock(c & 255u); }

// texture level 0 (dark) .. 3 (light) for a material at a cell
int pattern(uint t, ivec2 w, uint v) {
	vec2 fw = vec2(w);
	float h = float(v) / 255.0;
	if (t == M_STONE || t == M_DEEPSTONE || t == M_MAGMAROCK || t == M_OBSIDIAN) {
		if (abs(vnoise(fw / 6.0, 11) - 0.5) < 0.03) return 0;
		return 1 + int(vnoise(fw / 2.5, 7) * 2.4);
	}
	if (t == M_ICE) return 1 + int(vnoise(fw / 3.0, 9) * 2.5);
	if (t == M_DIRT || t == M_ASH) {
		if (h > 0.95) return 3;
		return int(vnoise(fw / 2.0, 5) * 2.2 + h * 0.6);
	}
	if (t == M_SAND || t == M_SNOW || t == M_GRAVEL) return int(vnoise(fw / 1.5, 3) * 2.0 + h * 1.9);
	if (t == M_GRASS) return (hashu(uint(w.x) * 7u) & 1u) == 0u ? 2 : 1;
	if (t == M_WOOD || t == M_CACTUS) { int k = w.x % 3; return k == 0 ? 0 : (k == 1 ? 2 : 1); }
	if (t == M_PLANK) return (w.y % 3 == 0 || (w.x + (w.y / 3) * 5) % 9 == 0) ? 0 : 2;
	// scaffold: boards with a lit top edge and a dark seam every 5 cells (reads as a walkway)
	if (t == M_SCAFFOLD) return (w.x % 5 == 0) ? 0 : ((w.y % 2 == 0) ? 3 : 1);
	if (t == M_LEAF) return int(vnoise(fw / 2.2, 13) * 3.6);
	if (t == M_GLASS) return ((w.x + w.y) % 5 == 0) ? 3 : 1;
	return int(vnoise(fw / 1.4, 17) * 3.99);
}

vec3 torchColor(ivec2 w) {
	return ramp(M_TORCH, int(hashu(uint(w.x) * 31u ^ uint(w.y) * 17u ^ uint(TIME * 0.2)) & 3u));
}
// a chest is 6 x 4 cells; each cell's variant says which part it is (column 0-5, row 0-3)
// A 12 x 9 treasure chest: a planked lid (rows 0-3) with iron straps, the gold seam and lock
// (rows 3-6), a planked body, gold corners and feet. Opened: the lid is thrown back and the
// inside glints with what's left.
vec3 chestColor(uint v, bool open) {
	int ci = int(v & 15u), cj = int((v >> 4) & 15u);
	vec3 wood = vec3(0.50, 0.31, 0.16), woodL = vec3(0.62, 0.40, 0.21), woodD = vec3(0.33, 0.20, 0.10);
	vec3 iron = vec3(0.32, 0.31, 0.36), ironL = vec3(0.50, 0.49, 0.55);
	vec3 gold = ramp(M_TREASURE, 2), bright = ramp(M_TREASURE, 3), goldD = ramp(M_TREASURE, 0) * 0.8;
	bool edge = ci == 0 || ci == 11;
	bool strap = ci == 2 || ci == 9;
	bool corner = (ci <= 1 || ci >= 10) && (cj == 0 || cj == 8);
	if (open && cj <= 4) {
		if (cj == 0) return edge ? goldD : woodD;                        // the lid's edge, thrown back
		if (edge) return gold * 0.85;
		if (cj == 4 && ((ci * 7 + cj * 3) % 3 == 0)) return bright;     // coins left inside
		if (cj == 4) return gold * 0.7;
		return vec3(0.07, 0.05, 0.03) + vec3(0.03, 0.02, 0.0) * float(cj);  // dark inside
	}
	if (corner) return gold;
	if (cj == 8) return ci <= 1 || ci >= 10 ? goldD : woodD;            // the base
	if (edge) return cj == 4 ? bright : gold * 0.9;
	// the lock plate on the seam
	if ((ci == 5 || ci == 6) && cj >= 3 && cj <= 6) {
		if (cj == 5) return ci == 5 ? vec3(0.08, 0.05, 0.03) : goldD;      // keyhole
		return cj == 3 ? bright : gold;
	}
	if (cj == 4) return gold;                                            // the seam band
	if (strap) return cj == 0 || cj == 7 ? ironL : iron;
	if (cj == 0) return woodL;
	// planks: lid grain runs across, the body's boards alternate
	if (cj <= 3) return (cj == 3) ? woodD : ((cj % 2 == 0) ? wood * 1.08 : wood);
	return ((ci / 2) % 2 == 0) ? wood : wood * 0.9;
}
bool isMasonry(uint t) {
	return t == M_BRICK || t == M_MASONRY || t == M_MOSSBLOCK || t == M_SANDSTONE || t == M_TILE || t == M_TREASURE || t == M_RUNESTONE;
}
// textured colour of a material, without edge shading; building blocks get mortar lines
vec3 blockTex(uint t, ivec2 w, uint v) {
	vec2 fw = vec2(w);
	if (t == M_BRICK) {
		int row = w.y / 3;
		bool mortar = (w.y % 3 == 0) || ((w.x + row * 3) % 6 == 0);
		return mortar ? vec3(0.42, 0.39, 0.36) : ramp(t, (v & 1u) == 0u ? 2 : 3);
	}
	if (t == M_RUNESTONE) {
		// big dressed blocks; one in four carries a rune that glows a faint cyan, slowly pulsing
		int row = w.y / 6;
		int bx = w.x + (row & 1) * 5;
		bool mortar = (w.y % 6 == 0) || (bx % 10 == 0);
		uint bh = hashu(uint(bx / 10) * 911u ^ uint(row) * 3571u);
		vec3 col = mortar ? ramp(t, 0) * 0.7 : ramp(t, 1 + int(bh % 2u));
		if (w.y % 6 == 1 && !mortar) col = ramp(t, 3);
		if (!mortar && bh % 4u == 0u) {
			int lx = bx % 10, ly = w.y % 6;
			bool stroke = (lx == 5 && ly >= 1 && ly <= 5) || (ly == 2 + int(bh >> 3 & 1u) && lx >= 3 && lx <= 7)
				|| ((bh >> 5 & 1u) == 1u && ly == 5 - (lx - 3) && lx >= 3 && lx <= 7);
			if (stroke) col = vec3(0.32, 0.78, 0.95) * (0.65 + 0.35 * sin(TIME * 0.04 + float(bh & 63u)));
		}
		return col;
	}
	if (t == M_MASONRY || t == M_MOSSBLOCK) {
		int row = w.y / 4;
		int bx = w.x + (row & 1) * 4;
		bool mortar = (w.y % 4 == 0) || (bx % 8 == 0);
		uint bh = hashu(uint(bx / 8) * 911u ^ uint(row) * 3571u);
		int l = 1 + int(bh % 2u);
		if (w.y % 4 == 1) l = 3;
		vec3 col = mortar ? ramp(t, 0) * 0.72 : ramp(t, l);
		if (t == M_MOSSBLOCK && vnoise(fw / 3.0, 41) > 0.5) col = mortar ? vec3(0.18, 0.27, 0.13) : mix(col, vec3(0.33, 0.53, 0.24), 0.7);
		return col;
	}
	if (t == M_SANDSTONE) {
		int row = w.y / 3;
		bool mortar = (w.y % 3 == 0) || ((w.x + row * 5) % 10 == 0);
		return mortar ? ramp(t, 0) * 0.82 : ramp(t, 1 + int(vnoise(fw / 2.0, 43) * 2.4));
	}
	if (t == M_TILE) {
		int row = w.y / 2;
		int k = (w.x + (row & 1) * 2) % 4;
		if (w.y % 2 == 1 && k == 0) return ramp(t, 0);
		return ramp(t, k == 1 ? 3 : 2);
	}
	if (t == M_TREASURE) return chestColor(v, false);
	if (t == M_TORCH) return torchColor(w);
	return ramp(t, pattern(t, w, v));
}

// a closed door, from which part of it a cell is (v = row << 2 | column): vertical planks, a dark
// frame top and bottom, two iron straps with rivets, a small barred window and a brass handle
vec3 doorColor(uint v) {
	int row = int(v >> 2u), col = int(v & 3u);
	vec3 c = ramp(M_WOODDOOR, col == 0 ? 3 : (col == 2 ? 1 : 2));
	if ((row * 7 + col * 3) % 11 == 0) c *= 0.88;                              // grain
	if (row == 0 || row >= 29) return ramp(M_WOODDOOR, 0);
	if (row == 5 || row == 6 || row == 23 || row == 24) {
		c = col == 0 ? vec3(0.55, 0.55, 0.6) : vec3(0.3, 0.3, 0.34);
		if ((row == 5 || row == 23) && col == 1) c = vec3(0.75, 0.75, 0.8);   // rivet
	}
	if (row >= 9 && row <= 12 && col == 1) c = (row == 10) ? vec3(0.35, 0.33, 0.3) : vec3(0.08, 0.06, 0.05);
	if ((row == 15 || row == 16) && col == 2) c = row == 15 ? vec3(0.95, 0.78, 0.35) : vec3(0.7, 0.52, 0.2);
	return c;
}

vec3 fgColor(uint t, uint c, ivec2 w, uint cu, uint cd, uint cl, uint cr) {
	uint v = (c >> 8) & 255u;
	if (t == M_WOODDOOR) return doorColor(v);
	uint ut = cu & 255u;
	bool openUp = ut == 0u || KIND[ut] == K_GAS;
	if (t == M_WATER) {
		if (openUp) {
			// (27 Nov; user: "a more fleshed out water with proper vfx") the top: light running along it in glints
			// and a little foam, drifting
			float sf = vnoise(vec2(float(w.x) / 5.0 + TIME * 0.03, TIME * 0.013), 65);
			return sf > 0.68 ? vec3(0.9, 0.97, 1.0) : (sf > 0.5 ? vec3(0.66, 0.87, 1.0) : vec3(0.5, 0.76, 0.97));
		}
		// (27 Nov; user: "in large bodies of water the water texture looks very tiled": it was two sine waves, one
		// a diagonal stripe every few cells, so a sea was one little lattice over and over) now slow drifting
		// noise at two sizes, never repeating, cut into the ramp's bands (pixel art, no smooth gradient) with a
		// dither where bands meet, and the odd cell catching the light
		vec2 fw = vec2(w);
		float n1 = vnoise(vec2(fw.x / 16.0 + TIME * 0.0035, fw.y / 4.0 - TIME * 0.0012), 63);
		float n2 = vnoise(vec2(fw.x / 31.0 - TIME * 0.0016, fw.y / 14.0 + TIME * 0.0007), 64);
		uint hw = hashu(uint(w.x) * 2654435761u ^ uint(w.y) * 40503u);
		float n = n1 * 0.55 + n2 * 0.45 + (float(hw & 15u) / 15.0 - 0.5) * 0.06;
		if (n1 > 0.82 && (hashu(hw ^ uint(TIME * 0.05) * 977u) % 19u) == 0u) return ramp(t, 3) * 1.1;
		if (n < 0.3) return ramp(t, 2) * 0.92;          // (water's ramp, darkest to lightest: 2, 0, 1, 3)
		if (n < 0.45) return ramp(t, 0);
		if (n < 0.68) return ramp(t, 1);
		return mix(ramp(t, 1), ramp(t, 3), 0.5);
	}
	if (t == M_LAVA) {
		if (openUp) return vec3(1.0, 0.92, 0.55);
		float sh = sin(TIME * 0.05 + float(w.x) * 0.7) + sin(TIME * 0.07 - float(w.y) * 0.9 + float(w.x) * 0.3);
		return ramp(t, int(sh * 0.9 + 1.6));
	}
	if (t == M_MUD) {
		// mud reads as wet, never as dry dirt: dark and glossy, with slow swirling flow lines, a
		// shining wet skin along its top that catches the light, and the odd bubble
		float fl = vnoise(vec2(float(w.x) / 7.0 + TIME * 0.004, float(w.y) / 1.6 + vnoise(vec2(w) / 9.0, 51) * 1.4), 52);
		vec3 mc = ramp(t, clamp(int(fl * 2.7), 0, 2));
		if (openUp) {
			float gl = sin(TIME * 0.03 + float(w.x) * 0.37) + sin(TIME * 0.021 - float(w.x) * 0.61);
			mc = gl > 1.25 ? ramp(t, 3) * 1.3 : mix(ramp(t, 3), ramp(t, 2), 0.45);
			if ((hashu(uint(w.x) * 73u ^ uint(TIME * 0.02) * 19u) % 61u) == 0u) mc = ramp(t, 0);   // a bubble popping
		} else if ((hashu(uint(w.x) * 31u ^ uint(w.y) * 57u ^ uint(TIME * 0.015) * 7u) % 211u) == 0u) {
			mc = ramp(t, 3);   // a bubble rising through it
		}
		return mc;
	}
	if (t == M_FIRE) return ramp(t, int(hashu(uint(w.x) * 31u ^ uint(w.y) * 17u ^ uint(TIME * 0.25)) & 3u));
	if (KIND[t] == K_GAS) return ramp(t, int(vnoise(vec2(w) / 2.0 + vec2(TIME * 0.01, 0.0), 21) * 3.99));
	if (t == M_TORCH) return torchColor(w);
	if (t == M_SANDSTONE && (c & ST_BUILT) == 0u) {
		// the planet's own sandstone (sand packed hard): soft wavy strata, not dressed blocks
		float sn = vnoise(vec2(float(w.x) / 11.0, float(w.y) / 2.4 + vnoise(vec2(w) / 13.0, 49) * 1.6), 47) + vnoise(vec2(w) / 2.0, 48) * 0.35;
		vec3 sc = ramp(t, clamp(int(sn * 2.7), 0, 3));
		if (openUp) sc *= 1.1;
		else if (!solidC(cd)) sc *= 0.72;
		if (!solidC(cl) || !solidC(cr)) sc *= 0.88;
		return sc;
	}
	if (isMasonry(t)) {
		vec3 bc = blockTex(t, w, v);
		if (openUp) bc *= 1.15;
		else if (!solidC(cd)) bc *= 0.7;
		if (!solidC(cl) || !solidC(cr)) bc *= 0.88;
		return bc;
	}
	int l = pattern(t, w, v);
	if (!isBlock(t)) return ramp(t, l);
	bool td = !solidC(cd), tl = !solidC(cl), tr = !solidC(cr);
	bool tu = !solidC(cu);
	if (tu) l = 3;
	vec3 col = ramp(t, l);
	if (tu) col *= 1.12;
	else if (td) col *= 0.66;
	if (tl || tr) col *= 0.84;
	return col;
}

// Trees, bushes and cacti, shaded from their shape: light from the upper left, so top and left
// edges catch it and the right side and undersides fall into shadow. Leaves clump, bark has
// grooves and knots, cacti have ribs, spines and the odd flower on top, charred wood glints.
vec3 plantColor(uint b, uint ab, ivec2 w, uint bu, uint bd, uint bl, uint br) {
	uint hs = hashu(uint(w.x) * 2654435761u ^ uint(w.y) * 40503u ^ 0x77u);
	float hr = float(hs & 1023u) / 1024.0;
	int l = 1;
	if (b == M_CAP) {
		// each mushroom its own colour (from its plant id): spotted red, violet, teal (glowing spots)
		// or amber; lit on top, dark gills underneath
		uint pid = hashu((ab >> 16) * 2246822519u + 7u);
		uint kind = pid % 4u;
		vec3 base = kind == 0u ? vec3(0.74, 0.18, 0.22) : (kind == 1u ? vec3(0.5, 0.26, 0.66) : (kind == 2u ? vec3(0.16, 0.55, 0.58) : vec3(0.82, 0.5, 0.18)));
		float sh = bu != M_CAP ? 1.25 : (bd != M_CAP ? 0.5 : 0.9 + vnoise(vec2(w) / 3.0, 17) * 0.2);
		if (br != M_CAP && bu == M_CAP) sh *= 0.8;
		vec3 c = base * sh;
		if (bd != M_CAP && bu == M_CAP) return vec3(0.32, 0.24, 0.2) * (0.8 + hr * 0.4);   // gills
		// spots: round dots on a coarse grid, jittered per cell block
		ivec2 sp = w / 4;
		uint sj = hashu(uint(sp.x) * 73856093u ^ uint(sp.y) * 19349663u ^ pid);
		vec2 so = vec2(float(sj & 3u), float((sj >> 2) & 3u));
		if ((sj >> 4) % 3u == 0u && length(vec2(w - sp * 4) - so) < 1.1)
			c = kind == 2u ? vec3(0.6, 1.0, 0.95) : vec3(0.95, 0.92, 0.85);
		return c;
	}
	if (b == M_STALK) {
		bool le = bl != M_STALK, re = br != M_STALK;
		l = (w.x % 3 == 0) ? 1 : 2;
		if (le) l = 3;
		if (re) l = 0;
		if (bu == M_CAP) l = 0;                       // in the cap's shadow
		return ramp(b, l) * 0.9;
	}
	if (b == M_DRYGRASS) {
		// blades: each column its own shade, the tips lighter
		uint cb = hashu(uint(w.x) * 2654435761u ^ 0x3du);
		l = int(cb % 3u);
		if (bu != M_DRYGRASS) l = 3;
		if ((cb >> 8) % 29u == 0u && bu != M_DRYGRASS) return vec3(0.95, 0.9, 0.6);   // a seed head
		return ramp(b, l) * 0.88;
	}
	if (b == M_LEAF) {
		float n = vnoise(vec2(w) / 2.4, 13) + (vnoise(vec2(w) / 6.0, 14) - 0.5) * 0.5;
		l = n < 0.32 ? 0 : (n < 0.58 ? 1 : 2);
		if (bl != M_LEAF && bl != M_SNOW) l = min(l + 1, 3);
		if (br != M_LEAF && br != M_SNOW) l = max(l - 1, 0);
		if (bu != M_LEAF && bu != M_SNOW) l = 3;
		else if (bd != M_LEAF) l = 0;
		if (hr < 0.035) l = 3;                        // a sunlit leaf
		else if (hr > 0.97 && l > 0) l = 0;           // a gap in the foliage
		return ramp(b, l) * 0.86;
	}
	if (b == M_WOOD || b == M_COAL || b == M_ROOT) {
		bool le = bl != b, re = br != b;
		int groove = (w.x + int(vnoise(vec2(0.0, float(w.y)) / 5.0, 21) * 3.0)) % 3;
		l = groove == 0 ? 0 : (groove == 1 ? 1 : 2);
		if (le && !re) l = 2;
		if (re && !le) l = 0;
		if (hr < 0.025) l = 0;                        // a knot
		vec3 c = ramp(b, l) * 0.86;
		if (b == M_COAL && hr > 0.992) c = vec3(1.0, 0.45, 0.12);   // an ember still glowing
		return c;
	}
	// cactus
	bool le = bl != M_CACTUS, re = br != M_CACTUS;
	l = (w.x % 2 == 0) ? 2 : 1;
	if (le) l = 2;
	if (re) l = 0;
	if (bu != M_CACTUS) {
		l = 3;
		if ((hashu(uint(w.x) * 13u ^ 0x51u) & 7u) == 0u) return (hs & 1u) == 0u ? vec3(0.96, 0.45, 0.62) : vec3(1.0, 0.86, 0.32);
	}
	if (hr < 0.07 && !le && !re) return vec3(0.93, 0.9, 0.72) * 0.9;   // spines
	return ramp(b, l) * 0.86;
}

vec3 bgObjColor(uint b, uint ab, ivec2 w, uint v, uint bu, uint bd, uint bl, uint br, uint cu, uint cd) {
	if (b == M_TORCH) return torchColor(w);
	if (b == M_DECOR) return DECOR_PAL[(ab >> 16) & 63u];
	if (b == M_TREASURE) return chestColor((ab >> 16) & 255u, false);
	if (b == M_OPENCHEST) return chestColor((ab & 0xff0000u) != 0u ? (ab >> 16) & 255u : v, true);
	if ((ab & BG_WALL) != 0u) {
		// a building's back wall: same texture, much darker, shaded under floors
		vec3 col = blockTex(b, w, v) * 0.58;
		if (solidC(cu)) col *= 0.72;
		return col;
	}
	int l = pattern(b, w, v);
	if (b == M_LEAF) {
		if (bu != M_LEAF) l = 3;
		else if (bd != M_LEAF) l = 0;
	}
	vec3 col = ramp(b, l);
	if (SELFL[b] == 0u) col *= 0.86;
	return col;
}

vec3 wallColor(float r, vec4 sa, vec4 sb, ivec2 w, uint cu, uint cl, uint cr) {
	vec3 c;
	// (the bands' edges wander in lobes and grains, so a cave's back wall never changes colour along a
	// line that follows the surface's curve: the user saw sharp seams there)
	float rr = r + (vnoise(vec2(w) / 11.0, 35) - 0.5) * 16.0 + (vnoise(vec2(w) / 3.0, 36) - 0.5) * 6.0;
	if (rr > sa.x - 22.0) c = vec3(56.0, 40.0, 30.0);
	else if (rr > sa.z) c = vec3(38.0, 39.0, 48.0);
	else if (rr > sa.w) c = vec3(31.0, 28.0, 43.0);
	else if (rr > sb.x) c = vec3(50.0, 22.0, 16.0);
	else c = vec3(74.0, 61.0, 28.0);
	float lv = floor(vnoise(vec2(w) / 5.0, 31) * 3.0) / 3.0;
	vec3 col = c / 255.0 * (0.78 + lv * 0.3);
	if (abs(vnoise(vec2(w) / 9.0, 33) - 0.5) < 0.025) col *= 0.6;
	if (solidC(cu) || solidC(cl) || solidC(cr)) col *= 0.72;
	return col;
}

// the biome at an angle of a background layer's own coordinates (any angle: wrapped round the planet)
int layerBiome(float a) { return int(surfA(mod(a, TAU)).y); }
// the colour of the land a background layer stands for at angle a of its own coordinates: the biome's top
// ground, averaged over a box 7 samples wide sliding smoothly (a fixed grid of 26 columns, the end samples
// weighted by how far between grid points this is), so across a border it ramps without steps
vec3 layerLand(float a, uint shade) {
	vec3 acc = vec3(0.0);
	float gc = a * RS0 / 26.0;
	float g0 = floor(gc), gf = gc - g0;
	for (int k = -3; k <= 4; k++) {
		float wk = k == -3 ? 1.0 - gf : (k == 4 ? gf : 1.0);
		uint tm = uint(P.p[8 + 2 * layerBiome((g0 + float(k)) * 26.0 / RS0)].z);
		acc += palColor(tm, shade) * wk;
	}
	return acc / 7.0;
}

float hillH(float ang, float scale, int seed) {
	return fbm(vec2(ang * RS0 / scale, 0.5), seed, 3);
}

// above the atmosphere: nothing built in the orbit band here (or above it altogether)
bool orbitEmpty(vec2 p) {
	int i = idxAt(p);
	return i < 0 || ((world.cells[i] & 255u) == 0u && (aux.a[i] & 255u) == 0u);
}

vec3 skyColor(vec2 pos, float r, float rs, vec2 px, float th) {
	vec2 up = pos / r;
	vec2 sd = sunDir();
	float sdot = dot(up, sd);
	float day = clamp(sdot * 1.6 + 0.15, 0.025, 1.0);
	float dusk = clamp(1.0 - abs(sdot) * 4.0, 0.0, 1.0);
	float alt = clamp((r - rs) / (R_TOP - rs), 0.0, 1.0);
	float low = 1.0 - alt;
	vec3 zen = mix(vec3(12.0, 14.0, 34.0), vec3(64.0, 112.0, 210.0), day) / 255.0;
	vec3 hor = mix(vec3(28.0, 34.0, 64.0), vec3(156.0, 204.0, 248.0), day) / 255.0;
	vec3 col = mix(zen, hor, low * low);
	col = mix(col, vec3(0.94, 0.47, 0.35), dusk * low * low * 0.55);
	float rain = P.p[3].z;
	if (rain > 0.0) { float g = dot(col, vec3(0.333)) * 0.8; col = mix(col, vec3(g), rain * 0.45); }
	col *= P.p[4].rgb;
	float space = smoothstep(0.45, 1.0, alt);
	col = mix(col, vec3(0.008, 0.008, 0.03), space);
	vec3 horizon = col;
	// Stars first, so hills and clouds are drawn in front of them. Two layers that barely move as
	// you travel (they're very far away): the far one drifts a pixel for every ~80 the ground
	// moves, the near one one for every ~25; rising lifts them a little. They fade in with the
	// dark (blended, so they never pop in once the sky gets dark enough).
	float starA = max(clamp(1.0 - day * 2.2, 0.0, 1.0), smoothstep(0.15, 0.85, alt)) * smoothstep(0.0, 0.25, 1.0 - day + alt);
	if (starA > 0.01) {
		float camU = P.p[121].w;
		float camH = length(P.p[1].xy) - RS0;
		for (int layer = 0; layer < 2; layer++) {
			float kx = layer == 0 ? 100.0 : 330.0;
			float ky = layer == 0 ? 0.012 : 0.04;
			ivec2 sp = ivec2(floor(px + vec2(camU * kx, camH * ky)));
			int seed = layer == 0 ? 991 : 993;
			float h = h2(sp, seed);
			float dens = layer == 0 ? 0.0035 : 0.0012;
			if (h < dens) {
				float tw = 0.6 + 0.4 * sin(TIME * 0.05 + h * 9000.0);
				vec3 sc = h < dens * 0.3 ? vec3(1.0, 0.85, 0.7) : (h < dens * 0.6 ? vec3(0.75, 0.85, 1.0) : vec3(1.0));
				col = mix(col, sc, starA * tw * (layer == 0 ? 0.75 : 1.0));
			} else if (layer == 1) {
				// bright stars get a little cross
				float hl = h2(sp + ivec2(1, 0), seed), hr = h2(sp - ivec2(1, 0), seed), hu = h2(sp + ivec2(0, 1), seed), hd = h2(sp - ivec2(0, 1), seed);
				if (min(min(hl, hr), min(hu, hd)) < 0.00035) col = mix(col, vec3(0.7), starA * 0.6);
			}
		}
	}

	// sky events (main `sky_level`): an aurora's curtains (P.p[125].y) and a blood moon's red night (.z),
	// both only in the dark and below space
	float night = clamp(1.0 - day * 1.8, 0.0, 1.0) * (1.0 - space);
	float aur = P.p[125].y * night;
	if (aur > 0.01) {
		float u = px.x + P.p[121].w * 160.0;
		float yv = px.y - P.p[123].w;                      // (rows from the top of the screen)
		float wave = sin(u * 0.009 + TIME * 0.003) * 0.08 + sin(u * 0.023 - TIME * 0.005) * 0.04;
		float hem = P.p[2].y * (0.42 + wave);              // the curtain's lower hem, waving
		float hang = clamp(1.0 - (yv - hem * 0.15) / max(hem, 1.0), 0.0, 1.0) * (1.0 - smoothstep(hem - 10.0, hem + 6.0, yv));
		float rays = 0.45 + 0.55 * pow(0.5 + 0.5 * sin(u * 0.15 + sin(u * 0.037 + TIME * 0.012) * 5.0), 2.0);
		float band = 0.5 + 0.5 * sin(u * 0.006 + TIME * 0.002);
		vec3 ac = mix(vec3(0.25, 1.0, 0.55), vec3(0.55, 0.35, 1.0), band * (1.0 - smoothstep(0.0, max(hem, 1.0), yv)));
		float bright = smoothstep(hem - 26.0, hem - 2.0, yv) * 0.5 + 0.5;   // (brightest along its hem)
		col = mix(col, ac, clamp(aur * hang * rays * bright * 0.75, 0.0, 0.8));
	}
	float bm = P.p[125].z * night;
	if (bm > 0.01) col = mix(col, col * vec3(1.9, 0.45, 0.42) + vec3(0.06, 0.0, 0.0), bm * 0.8);

	// sun and moon next, also behind hills and clouds
	{
		float camDay = dot(normalize(P.p[1].xy), sd);
		if (camDay > -0.15) {
			vec2 sc = P.p[2].xy * 0.5 + P.p[123].zw + vec2(dot(sd, camR()), dot(sd, camD())) * P.p[2].y * 0.42;
			float dist = length(px - sc);
			if (dist < 5.5) col = vec3(1.0, 0.97, 0.8);
			else if (dist < 7.5) col = mix(col, vec3(1.0, 0.88, 0.55), 0.6);
			else if (dist < 10.5) col = mix(col, vec3(1.0, 0.85, 0.6), 0.25);
		}
		if (camDay < 0.15) {
			vec2 mcn = P.p[2].xy * 0.5 + P.p[123].zw - vec2(dot(sd, camR()), dot(sd, camD())) * P.p[2].y * 0.42;
			vec2 dm = px - mcn;
			if (dot(dm, dm) < 17.0) col = vec3(dm.x + dm.y > 2.0 ? 0.64 : 0.88) * mix(vec3(1.0), vec3(1.3, 0.35, 0.3), clamp(P.p[125].z, 0.0, 1.0));
		}
	}
	float zoom = P.p[1].w;
	float camA = P.p[1].z;
	float d = th - camA; d -= TAU * floor(d / TAU + 0.5);
	// The parallax background (user, 22 Nov: "make the background look higher detail and fade into each
	// other better"): far mountains, far hills, near hills with a tree line, back to front. Each layer
	// is textured in its own coordinates (so its detail drifts with it), lit from the sun's side, takes
	// the colour of the land it stands for, and fades into the haze toward its foot, so where a nearer
	// layer rises in front of it there's a soft band of mist between them instead of a hard edge.
	// (a gas giant has no land to stand behind it: no mountains or hills, only its sky)
	if (zoom < 2.5 && P.p[125].x > -0.5) {
		// (P.p[121].w is the camera's angle unwrapped, so nothing jumps when it wraps)
		float camU = P.p[121].w;
		float sunX = dot(sd, camR());                       // the sun to the right (+) or left (-)
		float lit = 0.3 + 0.7 * day;
		// --- the heights of the three layers in this column ---
		// mountains: ridged noise, a sharp crest line over broad flanks
		float uM = camU * 0.12 + d;
		float xM = uM * RS0 / 150.0;
		float rid = 0.0, amp = 0.55, fq = 1.0;
		for (int o = 0; o < 4; o++) {
			float n = 1.0 - abs(vnoise(vec2(xM * fq, 3.5 + float(o)), 411 + o) * 2.0 - 1.0);
			rid += n * n * amp; amp *= 0.5; fq *= 2.1;
		}
		float hm = RS0 + 40.0 + 230.0 * rid;
		float uF = camU * 0.25 + d;
		float hf = RS0 + 25.0 + 120.0 * hillH(uF, 257.0, 401);
		float uN = camU * 0.5 + d;
		float hn = RS0 + 8.0 + 70.0 * hillH(uN, 100.0, 402);
		// the near hills' tree line: each far-off tree takes its kind from the biome under it (sampled at
		// its own place), so it thins out tree by tree across a biome border
		float tl = 0.0, tcx = 0.0, tth = 1.0;
		int tkind = 0;
		float arcN = uN * RS0;
		float bi = floor(arcN / 6.0);
		for (int k = -3; k <= 3; k++) {
			float bk = bi + float(k);
			float cx = (bk + 0.5) * 6.0;
			int ftk = int(P.p[9 + 2 * layerBiome(2.0 * cx / RS0)].w) >> 4;
			// (the elder trees' and the mangroves' woods show as round crowns, the meadow's lone oaks thinly)
			if (ftk == 16 || ftk == 14) ftk = 7;
			if (ftk == 17) { if (h2(ivec2(int(bk), 405), 9) > 0.15) continue; ftk = 1; }
			if (!(ftk == 1 || ftk == 2 || ftk == 4 || ftk == 5 || ftk == 7)) continue;
			float hr = h2(ivec2(int(bk), 403), 9);
			if (hr > (ftk == 5 ? 0.3 : (ftk == 2 ? 0.95 : 0.75))) continue;
			float th2 = 8.0 + hr * 13.0;
			float dx = abs(arcN - cx);
			float top = 0.0;
			if (ftk == 2) top = th2 - dx * 2.6;                      // pines: narrow triangles
			else if (ftk == 5) top = dx < 0.6 ? th2 : 0.0;           // dead trees: bare poles
			else {                                                   // round crowns on short stems
				float rr = th2 * 0.42;
				float lump = (h2(ivec2(int(bk), int(arcN * 2.0)), 404) - 0.5) * 1.2;   // a ragged edge
				top = dx < rr ? th2 - rr + sqrt(rr * rr - dx * dx) * 0.9 + lump : (dx < 0.7 ? th2 - rr : 0.0);
			}
			if (top > tl) { tl = top; tcx = cx; tth = th2; tkind = ftk; }
		}
		float hnT = hn + tl;
		// the colour of the land the near and far hills stand for: the top ground of the biome there
		// (averaged over a wide stretch, so across a biome border the hills change colour gradually: taken
		// column by column they changed at a hard vertical line)
		// (a box 7 samples wide sliding smoothly: samples on a fixed grid of 26 columns, the end ones
		// weighted by how far between grid points this column is, so the colour ramps without steps)
		// (each layer's land is read in the layer's OWN coordinates (2 x uN for the near hills, 4 x uF for the
		// far ones), so it drifts with the layer and a tree never changes kind or vanishes as you walk (the
		// user saw them pop in and out at a biome border); scaled so a border on the hills lines up with the
		// real one just as you cross it)
		vec3 landN = layerLand(2.0 * uN, 1u);
		vec3 landF = layerLand(4.0 * uF, 2u);
		vec3 haze = horizon;
		if (r < hnT) {
			// --- near hills and their trees ---
			vec3 base = mix(vec3(0.2, 0.32, 0.36), landN * 0.7, 0.7) * lit * P.p[4].rgb;
			vec3 hc = mix(haze, base, 0.8);
			float ax = arcN;
			if (r >= hn) {
				// a tree: darker than the hill, lit on the sun's side and toward its top, leaves speckled
				float ty = clamp((r - hn) / max(tth, 1.0), 0.0, 1.0);
				float side = clamp((ax - tcx) * sign(sunX) / 3.0, -1.0, 1.0);
				float sh = 0.78 + 0.16 * ty + 0.1 * side * abs(sunX);
				float sp = h2(ivec2(int(ax * 2.0), int(r)), 405);
				if (tkind != 2 && tkind != 5 && sp < 0.18) sh += 0.08;
				if (tkind == 2 && fract((r - hn) / 3.0) < 0.34) sh -= 0.06;       // a pine's tiers
				vec3 tc = mix(vec3(0.16, 0.3, 0.26), vec3(0.3, 0.26, 0.22), tkind == 5 ? 1.0 : 0.0) * lit * P.p[4].rgb;
				col = mix(haze, tc, 0.82) * sh;
			} else {
				// the hill: mottled in patches, a lit rim along its crest, darker in its folds
				float m = vnoise(vec2(ax / 9.0, r / 5.0), 406) * 0.6 + vnoise(vec2(ax / 3.0, r / 2.0), 407) * 0.4;
				float band = floor(m * 3.0) / 3.0;
				col = hc * (0.88 + band * 0.18);
				if (r > hn - 1.5 && tl < 0.5) col = hc * 1.22;
				else if (r > hn - 3.5 && tl < 0.5) col = hc * 1.08;
			}
		} else if (r < hf) {
			// --- far hills: softer, bluer, misted where the near hills rise in front ---
			vec3 base = mix(vec3(0.36, 0.46, 0.66), landF * 0.75, 0.4) * lit * P.p[4].rgb;
			vec3 hc = mix(haze, base, 0.55);
			float ax = uF * RS0;
			float m = vnoise(vec2(ax / 14.0, r / 7.0), 408);
			col = hc * (0.93 + floor(m * 3.0) / 3.0 * 0.12);
			if (r > hf - 1.5) col = hc * 1.15;
			float mist = 1.0 - smoothstep(0.0, 26.0, r - hn);      // (the hills, not each tree: no tree-shaped edges)
			col = mix(col, haze * 1.03, mist * 0.55);
		} else if (r < hm) {
			// --- far mountains: crests lit on the sun's side, rock strata, snow on the high peaks ---
			float ax = uM * RS0;
			float e = 1.5 / 150.0;                                  // (one picture pixel along the range)
			float rid2 = 0.0, amp2 = 0.55, fq2 = 1.0;
			for (int o = 0; o < 4; o++) {
				float n2 = 1.0 - abs(vnoise(vec2((xM + e) * fq2, 3.5 + float(o)), 411 + o) * 2.0 - 1.0);
				rid2 += n2 * n2 * amp2; amp2 *= 0.5; fq2 *= 2.1;
			}
			float slope = (rid2 - rid) * 230.0 / 1.5;               // rising to the right (+)
			float face = clamp(-slope * sign(sunX) * 0.8, -1.0, 1.0) * abs(sunX);
			vec3 rock = vec3(0.42, 0.46, 0.58) * lit * P.p[4].rgb;
			// (strata: long bands along the range that wander up and down, not blotches)
			float strata = floor(vnoise(vec2(ax / 90.0, r / 3.0 + vnoise(vec2(ax / 60.0, 0.0), 413) * 4.0), 414) * 4.0) / 4.0;
			vec3 mc = rock * (0.9 + 0.22 * face + (strata - 0.5) * 0.1);
			float snowline = RS0 + 40.0 + 230.0 * 0.62 + (vnoise(vec2(ax / 12.0, 1.0), 415) - 0.5) * 18.0;
			if (r > snowline && r > hm - 30.0) mc = mix(mc, vec3(0.92, 0.95, 1.0) * lit * (0.92 + 0.12 * face), 0.75);
			col = mix(haze, mc, 0.38);
			if (r > hm - 1.2) col = mix(col, haze * 1.25, 0.35);    // (a pale crest against the sky)
			float mist = 1.0 - smoothstep(0.0, 40.0, r - max(hf, hn));
			col = mix(col, haze * 1.04, mist * 0.6);
		}
	}
	vec3 q = floor(col * 20.0 + DITH) / 20.0;
	// the thin blue rim of the atmosphere, seen from above it (smooth, after the sky's colour steps)
	if (r >= R_TOP) { float limb = clamp(1.0 - (r - R_TOP) / 60.0, 0.0, 1.0); q += vec3(0.15, 0.3, 0.6) * limb * limb * 0.6; }
	return q;
}

void main() {
	int VW = pc.a.x, VH = pc.a.y;
	int ix = int(gl_GlobalInvocationID.x), iy = int(gl_GlobalInvocationID.y);
	if (ix >= VW || iy >= VH) return;
	// Dithering setting (P.p[122].x): 0 off (clean hard bands, SNES-style), 1 subtle, 2 retro
	float dmode = P.p[122].x;
	float amp = dmode > 1.5 ? 1.0 : (dmode > 0.5 ? 0.35 : 0.0);
	DITH = 0.5 + ((BAYER[(iy & 3) * 4 + (ix & 3)] + 0.5) / 16.0 - 0.5) * amp;
	LSTEPS = dmode > 1.5 ? 9.0 : 12.0;
	TIME = P.p[0].x;
	vec2 px = vec2(float(ix) + 0.5, float(iy) + 0.5);
	vec2 pos = screenToWorld(px);
	float r = length(pos);
	// out in space, past the orbit band: clear (space.gd draws the stars there, under this picture)
	if ((int(P.p[122].w + 0.5) & 2) != 0 && r >= R_SPACE) { view.px[iy * VW + ix] = 0u; return; }
	float th = angleOf(pos);
	vec4 sa = surfA(th), sb = surfB(th);
	vec3 col; int flag = 0; // 0 lit, 1 self-lit, 2 sky
	float alpha = 1.0;

	if (r < R_IN) {
		float ring = floor(sin(r * 0.25 - TIME * 0.08) * 1.5 + 1.5);
		col = mix(vec3(1.0, 0.78, 0.35), vec3(1.0, 0.97, 0.8), ring / 3.0); flag = 1;
	} else if (r >= R_TOP && orbitEmpty(pos)) {
		col = skyColor(pos, r, sa.x, px, th); flag = 2;
		// high up, space's own starfield is drawn behind this picture (space.gd `backdrop`, bit 8): the sky
		// thins out into it over the top of the atmosphere and the orbit band, rather than meeting it at a line
		if ((int(P.p[122].w + 0.5) & 8) != 0) alpha = 1.0 - smoothstep(R_TOP - 40.0, R_TOP + 110.0, r);
	} else {
		int ci = idxAt(pos);
		uint c = ci < 0 ? 0u : world.cells[ci];
		uint ab = ci < 0 ? 0u : aux.a[ci];
		// (28 Nov; user: "the snow has snowflake and also pixel snow same with the rain. i like the newer fancier
		// graphics they should be the only one"): rain, snow and ash still falling from the clouds (life 1, react.comp,
		// nothing under them yet) aren't drawn: weather.gd's drops and flakes are what you see falling; the cells
		// show once they land, and gather as before
		if (((c >> 16) & 255u) == 1u && ((c & 255u) == M_WATER || (c & 255u) == M_SNOW || (c & 255u) == M_ASH)) {
			uint under = cellAt(pos - pos / max(r, 1.0)) & 255u;
			if (under == 0u || KIND[under] == K_GAS) c = 0u;
		}
		uint t = c & 255u, b = ab & 255u;
		ivec2 w = cellCoord(pos);
		uint cu = cellAt(screenToWorld(px + vec2(0.0, -1.0)));
		uint cd = cellAt(screenToWorld(px + vec2(0.0, 1.0)));
		uint cl = cellAt(screenToWorld(px + vec2(-1.0, 0.0)));
		uint cr = cellAt(screenToWorld(px + vec2(1.0, 0.0)));
		vec3 bg = vec3(0.0); int bgf = 0;
		bool opaque = t != 0u && ALPHA[t] >= 1.0;
		if (!opaque) {
			if (b != 0u) {
				uint bu = 0u, bd = 0u, bl = 0u, br = 0u;
				bool plant = (b == M_LEAF || b == M_WOOD || b == M_ROOT || b == M_CACTUS || b == M_COAL || b == M_CAP || b == M_STALK || b == M_DRYGRASS) && (ab & BG_WALL) == 0u;
				if (plant) {
					bu = bgAtPos(screenToWorld(px + vec2(0.0, -1.0))); bd = bgAtPos(screenToWorld(px + vec2(0.0, 1.0)));
					bl = bgAtPos(screenToWorld(px + vec2(-1.0, 0.0))); br = bgAtPos(screenToWorld(px + vec2(1.0, 0.0)));
					bg = plantColor(b, ab, w, bu, bd, bl, br);
					// a flower meadow's (flora 17): the heads of its flowers and the tops of its hedges in bloom
					if (b == M_LEAF && bu != M_LEAF && r < sa.x + 10.0 && (int(P.p[9 + 2 * int(sa.y)].w) >> 4) == 17) {
						uint ph = hashu(uint(w.x) * 2654435761u ^ uint(w.y) * 40503u ^ 0x3f1u);
						if ((ph & 7u) < 5u) {
							uint pk = (ph >> 4) % 5u;
							bg = pk == 0u ? vec3(0.95, 0.45, 0.62) : (pk == 1u ? vec3(1.0, 0.86, 0.3) : (pk == 2u ? vec3(0.96, 0.95, 0.92) : (pk == 3u ? vec3(0.66, 0.46, 0.96) : vec3(0.92, 0.28, 0.26))));
						}
					}
				} else {
					bg = bgObjColor(b, ab, w, (c >> 8) & 255u, bu, bd, bl, br, cu, cd);
				}
				bgf = SELFL[b] == 1u ? 1 : 0;
			}
			else if (r > sa.x) { bg = skyColor(pos, r, sa.x, px, th); bgf = 2; }
			else { bg = wallColor(r, sa, sb, w, cu, cl, cr); bgf = 0; }
			// grass tufts and the odd flower on top of grass
			if (t == 0u && b == 0u && (cd & 255u) == M_MYCELIUM) {
				uint mh = hashu(uint(w.x) * 2654435761u ^ 0x6c1u);
				if ((mh & 7u) < 3u) { bg = ramp(M_MYCELIUM, 2 + int((mh >> 3) & 1u)); bgf = 0; }
				if ((mh >> 8) % 17u == 0u) { bg = vec3(0.55, 0.95, 0.85); bgf = 1; }     // a glowing speck
			}
			if (t == 0u && b == 0u && (cd & 255u) == M_DRYGRASS) {
				uint dh = hashu(uint(w.x) * 2654435761u ^ 0x2a7u);
				if ((dh & 7u) < 5u) { bg = ramp(M_DRYGRASS, 2 + int((dh >> 3) & 1u)); bgf = 0; }
			}
			if (t == 0u && b == 0u && (cd & 255u) == M_GRASS) {
				uint gh = hashu(uint(w.x) * 2654435761u ^ 0x5bd1u);
				if ((gh & 7u) < 5u) { bg = ramp(M_GRASS, (gh & 8u) != 0u ? 3 : 2); bgf = 0; }
				uint fm = (int(P.p[9 + 2 * int(sa.y)].w) >> 4) == 17 ? 4u : 23u;     // (a meadow: flowers all over)
				if ((gh >> 8) % fm == 0u) { bg = (gh & 16u) != 0u ? vec3(0.95, 0.35, 0.4) : ((gh & 32u) != 0u ? vec3(0.66, 0.46, 0.96) : vec3(1.0, 0.86, 0.3)); bgf = 0; }
			}
		}
		if (t == 0u) { col = bg; flag = bgf; }
		else {
			vec3 mc = fgColor(t, c, w, cu, cd, cl, cr);
			// (27 Nov, water's look) shafts of light slanting down from the sea's top, swaying, gone by 90 down
			if (t == M_WATER && sb.y > 0.0 && r < sb.y && r > sa.x && r > sb.y - 90.0) {
				float dpt = sb.y - r;
				float shf = vnoise(vec2((th * RS0 + dpt * 0.45) / 6.0 + TIME * 0.004, 3.5), 66);
				mc += vec3(0.16, 0.24, 0.26) * smoothstep(0.6, 0.85, shf) * (1.0 - dpt / 90.0);
			}
			// each kind of world's own biome's touches, by the biome's flora (26 Nov): the salt flats' crust white
			// with cracks, glowing fissures through the basalt, a blue glint in the crystal fields' snow
			int fh2 = int(P.p[9 + 2 * int(sa.y)].w) >> 4;
			if (fh2 >= 11 && r > sa.x - 45.0) {
				uint hb2 = hashu(uint(w.x) * 73856093u ^ uint(w.y) * 19349663u ^ 0x77u);
				if (fh2 == 13 && (t == M_SAND || t == M_SANDSTONE) && r > sa.x - 26.0) {
					mc = mix(mc, vec3(0.93, 0.92, 0.89), 0.78);
					if ((hb2 & 31u) == 0u) mc *= 0.8;
				}
			}
			if (t == M_WATER && bgf == 2) {
				// open water over the sky: no sky through the sea, and lit like everything else, so a sea grows
				// dark with depth (light.comp) and at night (user, 23 Nov: deep ocean worlds)
				col = mc * 0.82; flag = 0;
			}
			else if (ALPHA[t] < 1.0) { col = mix(bg, mc, ALPHA[t]); flag = SELFL[t] == 1u ? 1 : bgf; }
			else { col = mc; flag = int(SELFL[t]); }
			if (fh2 == 11 && t == M_DEEPSTONE && r > sa.x - 40.0) {
				float fn = abs(vnoise(vec2(w) / 9.0, 61) - 0.5);
				if (fn < 0.02 + 0.008 * sin(TIME * 0.05 + float(w.x) * 0.1)) { col = mix(vec3(1.0, 0.35, 0.08), vec3(1.0, 0.72, 0.25), fract(float(w.y) * 0.37)); flag = 1; }
			}
			if (fh2 == 15 && t == M_SNOW && r > sa.x - 45.0 && hashu(uint(w.x) * 2246822519u ^ uint(w.y) * 3266489917u) % 31u == 0u) { col = vec3(0.55, 0.85, 1.0); flag = 1; }
		}
		// the salt pillars, white too
		if (t == 0u && b == M_SANDSTONE && (int(P.p[9 + 2 * int(sa.y)].w) >> 4) == 13) col = mix(col, vec3(0.86, 0.85, 0.82), 0.7);
	}
	vec4 L4 = lightAt(px, pc.a.z, pc.a.w, P.p[2].z);
	if (flag == 0) {
		vec3 L = L4.rgb;
		L = sqrt(max(L, vec3(0.0)) + 0.008);
		L = min(floor(L * LSTEPS + DITH) / LSTEPS, vec3(1.3));
		col *= L;
	}
	// fog over the underground you haven't seen: what's lit now is marked seen (not from the map or out in
	// space), and the fog (light.comp's w, blurred with the light, so its edge falls off softly) is a
	// dark mist that drifts a little, over everything there, lava and glowing ore too
	if (r > R_IN && r < R_TOP) {
		float under = fogUnder(r, sa.x);
		if (under > 0.0) {
			if ((int(P.p[122].w + 0.5) & 2) == 0) markSeen(pos, visNow(L4.rgb));
			float fa = clamp(1.0 - L4.a, 0.0, 1.0);
			if (fa > 0.003) {
				float drift = vnoise(vec2(th * RS0 * 0.05 + TIME * 0.012, r * 0.05 - TIME * 0.008), 91);
				float wisp = vnoise(vec2(th * RS0 * 0.14 - TIME * 0.02, r * 0.14), 92);
				vec3 fogc = vec3(0.05, 0.056, 0.085) * (0.65 + 0.7 * drift) + vec3(0.02, 0.022, 0.035) * wisp;
				col = mix(col, fogc, fa * 0.96);
			}
		}
	}
	// clouds: drawn over everything at their height (sky, hills, mountain tops, and you when you
	// fly in). Lit tops, darker bellies (darker still in rain), and stippled pixel edges and
	// drifting wisps inside, from a fixed 4x4 pattern so the fog reads as pixel art.
	// a marsh world's ground fog: a soft mist over the land, see-through (clouds.comp `groundFog`), green-grey by
	// day, dim at night, drifting
	float gfog = groundFog(pos);
	if (gfog > 0.0) {
		vec2 upf = pos / max(r, 1.0);
		float dayf = clamp(dot(upf, sunDir()) * 1.6 + 0.15, 0.06, 1.0);
		float wf = vnoise(vec2(th * RS0 * 0.06 + TIME * 0.015, r * 0.08 - TIME * 0.01), 93);
		vec3 fc = mix(vec3(0.09, 0.11, 0.1), vec3(0.6, 0.67, 0.57), dayf) * P.p[4].rgb;
		col = mix(col, fc, clamp(gfog * (0.7 + 0.6 * wf), 0.0, 0.42));
	}
	float cdn = cloudSky(pos);
	if (cdn > 0.0) {
		vec2 up = pos / max(r, 1.0);
		float above = cloudSky(pos + up * 6.0);
		float below = cloudSky(pos - up * 5.0);
		float day = clamp(dot(up, sunDir()) * 1.6 + 0.15, 0.025, 1.0);
		float rain = P.p[3].z;
		float cl = (70.0 + 185.0 * max(0.15, day) * (1.0 - rain * 0.45)) / 255.0;
		vec3 cc = vec3(cl, cl, cl * 1.05) * P.p[4].rgb;
		float lit = clamp(cdn - above + 0.45, 0.0, 1.0);
		cc *= lit > 0.62 ? 1.08 : (lit > 0.4 ? 0.92 : 0.8);
		if (below < 0.15) cc *= 0.82 - rain * 0.12;          // the underside
		// a gas giant's deck: banded amber and rust, the bands drifting slowly, and wholly opaque deep in
		float dk = cloudDeck(pos);
		if (dk > 0.0) {
			float band = 0.5 + 0.5 * sin((r - RS0) * 0.09 + fbm(vec2(th * RS0 / 180.0 + TIME * 0.004, 2.5), 4264, 2) * 6.0);
			cc *= mix(vec3(1.1, 0.88, 0.62), vec3(0.82, 0.52, 0.36), band) * (0.75 + 0.25 * dk);
			if (dk > 0.85) cdn = 2.0;
		}
		float wisp = vnoise(vec2(th * RS0 * 0.33 + TIME * 0.02, r * 0.33), 77);
		float a = cdn * 1.5 + (wisp - 0.5) * 0.7;
		float bay = (BAYER[(iy & 3) * 4 + (ix & 3)] + 0.5) / 16.0;
		if (flag == 2) {
			if (a > bay * 0.8 + 0.12) col = cc;
		} else if (a > bay * 1.2 + 0.25) {
			col = mix(col, cc, 0.75);                           // fog over ground caught in cloud
		}
	}
	col.r += P.p[6].y * 0.2;
	col = floor(clamp(col, 0.0, 1.0) * 31.0 + DITH) / 31.0;
	if (alpha < 1.0 && dmode > 0.5) {
		// (with dithering on, faded in steps of the Bayer pattern like everything else: whole pixels)
		float bay2 = (BAYER[(iy & 3) * 4 + (ix & 3)] + 0.5) / 16.0;
		alpha = alpha > bay2 ? 1.0 : 0.0;
	}
	view.px[iy * VW + ix] = alpha <= 0.0 ? 0u : packUnorm4x8(vec4(col, alpha));
}
