// Builds the per-column surface table: terrain height, biome and layer radii.
#include "common"
#include "params"
layout(std430, set = 0, binding = 2) restrict buffer Surf { vec4 s[]; } S;
layout(local_size_x = 64) in;

void main() {
	int i = int(gl_GlobalInvocationID.x);
	if (i >= pc.a.x) return;
	float th = (float(i) + 0.5) / float(NS) * TAU;
	vec2 dir = vec2(cos(th), sin(th));
	int nb = max(1, int(P.p[4].w));
	// each biome starts where P.p[24..25] says (a share of the way round: they have widths of their own)
	float u = th / TAU;
	int bi = nb - 1;
	for (int k = 1; k < nb; k++) {
		if (u < P.p[24 + k / 4][k % 4]) { bi = k - 1; break; }
	}
	float blo = P.p[24 + bi / 4][bi % 4];
	float bhi = bi + 1 < nb ? P.p[24 + (bi + 1) / 4][(bi + 1) % 4] : 1.0;
	float local = clamp((u - blo) / max(bhi - blo, 1e-5), 0.0, 1.0);
	float E = 0.07;
	int b0 = bi, b1 = bi; float t = 0.0;
	if (local > 1.0 - E) { b1 = (bi + 1) % nb; t = (local - (1.0 - E)) / (2.0 * E); }
	else if (local < E) { b0 = (bi - 1 + nb) % nb; t = 0.5 + local / (2.0 * E); }
	t = t * t * (3.0 - 2.0 * t);
	vec4 A = P.p[8 + 2 * b0], B = P.p[8 + 2 * b1];
	float off = mix(A.x, B.x, t), amp = mix(A.y, B.y, t);
	int bsel = t < 0.5 ? b0 : b1;
	int seed = int(P.p[0].w);
	float rs;
	float swell = 0.0;          // (terrain 2's broad rise or basin here: a bog's or lava lake's level follows it)
	if (P.p[26].x > 1.5) {
		// terrain 2 (new journeys from 26 Nov; user: "more height variation to the planets and just more detailed
		// surfaces in general with more natural land shapes going deeper and higher"): broad rises and basins
		// across the biomes, taller hills, sharp ridges, steeper short slopes and the ground's own roughness
		float n0 = fbm(dir * RS0 / 420.0, seed + 6, 2) - 0.5;
		float n1b = fbm(dir * RS0 / 120.0, seed + 1, 3) - 0.5;
		float rg = 1.0 - abs(fbm(dir * RS0 / 70.0, seed + 7, 3) * 2.0 - 1.0);
		float n2b = fbm(dir * RS0 / 24.0, seed + 2, 2) - 0.5;
		float n3 = fbm(dir * RS0 / 7.0, seed + 8, 2) - 0.5;
		float relief = amp * (1.0 + smoothstep(10.0, 40.0, amp) * 0.3);
		swell = n0 * (26.0 + amp * 1.2);
		// meadows and plateaus between the rough stretches: there the knolls and roughness fade and the hills
		// soften, so level ground to build on is about as common as before (measured offline)
		float flt = smoothstep(0.44, 0.62, fbm(dir * RS0 / 260.0, seed + 9, 2));
		// (rg averages 0.77: centred there, so the ridges stand up from the ground's mean instead of sinking it)
		rs = RS0 - off - swell - n1b * relief * 3.8 * (1.0 - 0.45 * flt) - (rg - 0.77) * relief * 1.4 * (1.0 - 0.7 * flt)
			- n2b * amp * 0.8 * (1.0 - 0.85 * flt) - n3 * min(amp + 2.0, 12.0) * 0.3 * (1.0 - 0.8 * flt);
	} else {
		float n1 = fbm(dir * RS0 / 110.0, seed + 1, 3) - 0.5;
		float n2 = fbm(dir * RS0 / 26.0, seed + 2, 2) - 0.5;
		rs = RS0 - off - n1 * amp * 3.4 - n2 * amp * 0.7;
	}
	float magmaR = P.p[7].x + (fbm(dir * RS0 / 50.0, seed + 4, 2) - 0.5) * 50.0;
	float deepR = min(RS0 - 270.0 + (fbm(dir * RS0 / 60.0, seed + 3, 2) - 0.5) * 40.0, rs - 40.0);
	deepR = max(deepR, magmaR + 30.0);
	float coreR = RS0 * 0.322 + (fbm(dir * RS0 / 40.0, seed + 5, 2) - 0.5) * 24.0;

	// surface liquids: sea level, bog ponds, lava lakes
	float flags = P.p[8 + 2 * bsel].w;
	int fl = int(flags);
	float waterR = -1.0, waterMat = float(M_WATER);
	if (P.p[7].y >= 0.0) waterR = RS0 - P.p[7].y;
	if ((fl & 2) != 0) waterR = max(waterR, RS0 - P.p[8 + 2 * bsel].x - 2.0 - swell);
	if ((fl & 4) != 0 && waterR < 0.0) { waterR = RS0 - P.p[8 + 2 * bsel].x - 6.0 - swell; waterMat = float(M_LAVA); }
	// (a dying star's: its sea is molten, flags 16 on either biome of the border so the shore never turns to water)
	if (((int(A.w) | int(B.w)) & 16) != 0 && waterR >= 0.0) waterMat = float(M_LAVA);

	S.s[2 * i] = vec4(rs, float(bsel), deepR, magmaR);
	// the two biomes this column sits between, and how far across the border it is, so the ground
	// can blend their layers instead of switching at one column: (b0 * 16 + b1) + t * 0.9
	S.s[2 * i + 1] = vec4(coreR, waterR, waterMat, float(b0 * 16 + b1) + t * 0.9);
}
