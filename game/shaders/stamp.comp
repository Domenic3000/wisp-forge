// Writes one generated structure (house, tower, castle, ruin, catacomb...) into the planet.
// The blueprint is a w x h grid in shell 0, column x0.., row y0.. (row grows toward the core).
// Each blueprint cell: bits 0-7 foreground (255 = keep what is there), bits 8-15 background
// (255 = keep), bit 16 = fill only where there is no solid ground yet, bit 17 = anchored
// (generated structures are part of the planet until you dig near them; this anchors the
// background wall too), bit 18 = background is a built back wall,
// bits 19-26 = colour variant, used when bit 27 is set (chests use it to know which part they are),
// bits 28-31 = a furniture piece's kind (props.gd KINDS), kept in background bits 24-27.
// pc.a = (x0, y0, w, h)  pc.b = (dataOffset, seed, mode, 0)
// mode 1 (raw, scripts/chunks.gd setting a fallen piece down): two words per cell, the front cell and
// the background cell exactly as they go in the world (0xffffffff = leave it); each only lands where
// that layer is empty (a front cell where nothing solid is, a background cell where there's none).
#include "common"
#include "world"
#include "bglayer"
layout(std430, set = 0, binding = 9) restrict readonly buffer Blue { uint d[]; } blue;
layout(local_size_x = 16, local_size_y = 16) in;

// one blueprint cell into the world cell idx (column col, row row)
void put(int idx, int i, int j, int w, int col, int row) {
	uint d = blue.d[pc.b.x + j * w + i];
	uint fc = d & 255u, bc = (d >> 8) & 255u;
	if (fc != 255u) {
		uint c = world.cells[idx];
		uint kc = KIND[c & 255u];
		bool fillOnly = (d & 0x10000u) != 0u;
		if (!fillOnly || !(kc == K_SOLID || kc == K_POWDER)) {
			uint v = (d & 0x8000000u) != 0u ? ((d >> 19) & 255u) : (hashu(uint(col) * 2654435761u ^ uint(row) * 40503u ^ uint(pc.b.y)) & 255u);
			uint anchor = ((d & 0x20000u) != 0u && KIND[fc] == K_SOLID) ? ST_ANCHOR : 0u;
			world.cells[idx] = fc | (v << 8) | anchor | (KIND[fc] == K_SOLID ? ST_BUILT : 0u);
		}
	}
	if (bc != 255u) {
		uint a = bc == 0u ? 0u : (bc | ((d & 0x40000u) != 0u ? BG_WALL : 0u) | ((d & 0x20000u) != 0u ? BG_ANCHOR : 0u));
		if (bc != 0u && (d & 0x8000000u) != 0u) a |= (((d >> 19) & 255u) << 16) | (((d >> 28) & 15u) << 24);   // which part of a chest; a prop's colour and kind
		if (bc == M_DECOR) {
			// the wall this piece stands in front of: the back wall already here (furniture set down
			// in a room), or else the nearest wall beside it along its row in the blueprint (a
			// generated room's furniture takes the place of the wall it covers)
			uint old = aux.a[idx];
			uint om = old & 255u;
			uint bi = om == M_DECOR ? behindIdx(old) : (((old & BG_WALL) != 0u) ? behindIndexOf(om) : 0u);
			if (bi == 0u) {
				uint lb = 255u, rb = 255u;
				int ld = 999, rd = 999;
				for (int k = 1; k <= 48 && (lb == 255u || rb == 255u); k++) {
					if (lb == 255u && i - k >= 0) {
						uint dl = blue.d[pc.b.x + j * w + i - k];
						uint bl = (dl >> 8) & 255u;
						if (bl != 255u && bl != M_DECOR && bl != M_TORCH) { lb = ((dl & 0x40000u) != 0u) ? bl : 0u; ld = k; }
					}
					if (rb == 255u && i + k < w) {
						uint dr = blue.d[pc.b.x + j * w + i + k];
						uint br = (dr >> 8) & 255u;
						if (br != 255u && br != M_DECOR && br != M_TORCH) { rb = ((dr & 0x40000u) != 0u) ? br : 0u; rd = k; }
					}
				}
				uint wm = ld <= rd ? lb : rb;
				if (wm == 255u) wm = ld <= rd ? rb : lb;
				bi = (wm == 255u) ? 0u : behindIndexOf(wm);
			}
			a = withBehind(a, bi);
		}
		aux.a[idx] = a;
	}
}

void main() {
	int i = int(gl_GlobalInvocationID.x), j = int(gl_GlobalInvocationID.y);
	int w = pc.a.z, h = pc.a.w;
	if (i >= w || j >= h) return;
	int row = pc.a.y + j;
	if (row < -ORBIT_ROWS || row >= SH_Y0[1]) return;
	int col = wrapc(pc.a.x + i, SH_N[0]);
	// a blueprint is laid out in surface columns; in the orbit band (twice the columns) each of its
	// cells covers two
	int reps = row < 0 ? 2 : 1;
	for (int q = 0; q < reps; q++) {
		int ri = row < 0 ? cellIdx(ORB, row, col * 2 + q) : cellIdx(0, row, col);
		if (pc.b.z == 1) {
			uint fw = blue.d[pc.b.x + 2 * (j * w + i)], bw = blue.d[pc.b.x + 2 * (j * w + i) + 1];
			if (fw != 0xffffffffu) {
				uint kc = KIND[world.cells[ri] & 255u];
				if (!(kc == K_SOLID || kc == K_POWDER)) world.cells[ri] = fw;
			}
			if (bw != 0xffffffffu && (aux.a[ri] & 255u) == 0u) aux.a[ri] = bw;
			continue;
		}
		put(ri, i, j, w, col, row);
	}
}
