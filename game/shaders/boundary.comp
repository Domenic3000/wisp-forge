// Moves material across the seams between neighbouring shells (the move pass never pairs rows
// across one): straight down, and diagonally where straight down is taken. Each thread owns one inner cell m (the top row of the shell below a seam) and the
// outer cells over it: the ones whose middles map into m (colTo), one or two since the outer shell
// has at most about an eighth more columns. One dispatch covers every seam in the window.
// pc.a = (first outer shell, window y0, window y1, -)  pc.b = (-, frame, 0, 0)  pc.d = window angles
// Dispatched (widest inner shell's columns) x (seams).
#include "common"
#include "world"
layout(local_size_x = 64) in;

// the first outer column (in shell s, No columns) over inner column m (Ni columns)
int firstOver(int m, int No, int Ni) { return (2 * m * No + Ni - 1) / (2 * Ni); }

void main() {
	int s = pc.a.x + int(gl_GlobalInvocationID.y);
	int si = shBelow(s);
	if (s >= NSH || si < 0) return;
	int yo = SH_Y1(s) - 1, yi = SH_Y0(si);
	if (yo < pc.a.y || yi >= pc.a.z) return;          // (this seam isn't in the window)
	int k = int(gl_GlobalInvocationID.x);
	if (k >= winCount(si)) return;
	int Ni = SH_N(si), No = SH_N(s);
	int m = wrapc(winX0(si) + k, Ni);
	int xa = firstOver(m, No, Ni);
	int xb = m + 1 == Ni ? No : firstOver(m + 1, No, Ni);
	int n = min(xb - xa, 3);
	if (n <= 0) return;
	int ii = cellIdx(si, yi, m);
	uint in_ = world.cells[ii];
	uint ti = in_ & 255u;
	int first = int(rnd3(uint(ii), uint(pc.b.y), 9u) * float(n));
	// Every write to an inner cell is a compare-and-swap: a neighbour's thread may slide something
	// into this one diagonally at the same moment, and only one of them may land (nothing is lost
	// or doubled). The outer cells are only ever written by their owner, after its swap landed.
	// Something that falls or flows over it drops in (in a random order among those over it)...
	for (int q = 0; q < n; q++) {
		int io = cellIdx(s, yo, xa + (first + q) % n);
		uint o = world.cells[io];
		uint to = o & 255u;
		if ((KIND[to] == K_POWDER || KIND[to] == K_LIQUID) && canDisp(to, ti)) {
			if (atomicCompSwap(world.cells[ii], in_, o) == in_) world.cells[io] = in_;
			return;
		}
	}
	// ...gas under an open cell rises through...
	if (KIND[ti] == K_GAS) {
		for (int q = 0; q < n; q++) {
			int io = cellIdx(s, yo, xa + (first + q) % n);
			uint o = world.cells[io];
			if ((o & 255u) == 0u) {
				if (atomicCompSwap(world.cells[ii], in_, o) == in_) world.cells[io] = in_;
				return;
			}
		}
	}
	// ...and powder or liquid that can't drop straight in slides down past it, into the inner cell
	// beside it (as it slides diagonally inside a shell), so a pile has no step where a seam crosses it
	int dir = rnd3(uint(ii), uint(pc.b.y), 23u) < 0.5 ? -1 : 1;
	for (int q = 0; q < n; q++) {
		int io = cellIdx(s, yo, xa + (first + q) % n);
		uint o = world.cells[io];
		uint to = o & 255u;
		uint ko = KIND[to];
		if (ko != K_POWDER && ko != K_LIQUID) continue;
		for (int e = 0; e < 2; e++) {
			int d = e == 0 ? dir : -dir;
			int ij = cellIdx(si, yi, wrapc(m + d, Ni));
			uint t = world.cells[ij];
			if (!canDisp(to, t & 255u)) continue;
			if (atomicCompSwap(world.cells[ij], t, o) == t) world.cells[io] = t;
			return;
		}
	}
}
