// Terrain magic: excavate, explode, fill, freeze, place, chip.
// Brushes live in P.p[88 + 2k] = (x, y, radius, mode) and P.p[89 + 2k] = (mat, power, budget, exclR)
// (excavating, mode 1: budget is how much faster than usual the staff digs).
// counts[t] = cells collected per material; C_HARD = blocked by hardness; C_PLACED = placed;
// C_CHEST_OPEN = chest cells opened (mode 7). Mode 9 opens or closes a door; mode 10 paints back walls (build mode); mode 11 only wakes what's round it (build mode's precise removal). Each player has their own CNT counters: owner = mode >> 4.
// pc.a = (-, y0, y1, -)  pc.d = window angles (common winCount)  pc.b = (-, frame, 0, 0)
#include "common"
#include "world"
#include "params"
#include "bglayer"
layout(std430, set = 0, binding = 3) restrict buffer Counts { uint n[]; } counts;
layout(local_size_x = 16, local_size_y = 16) in;

void main() {
	int y = pc.a.y + int(gl_GlobalInvocationID.y);
	if (y >= pc.a.z) return;
	int s = shellOf(y);
	int k = int(gl_GlobalInvocationID.x);
	if (k >= winCount(s)) return;
	int x = wrapc(winX0(s) + k, SH_N(s));
	int i = cellIdx(s, y, x);
	vec2 p = cellCenter(s, y, x);
	int nb = int(P.p[6].x);
	uint c = world.cells[i];
	uint ab = aux.a[i];
	for (int bi = 0; bi < nb; bi++) {
		vec4 A = P.p[88 + 2 * bi], B = P.p[89 + 2 * bi];
		float dist = distance(p, A.xy);
		int mode = int(A.w) & 15;
		uint ob = uint(int(A.w) >> 4) * CNT;   // whose satchel this brush fills (CNT counters per player)
		float rad = A.z;
		uint t = c & 255u;
		float R = rnd3(uint(i), uint(pc.b.y), uint(bi) * 31u + 5u);
		uint power = uint(B.y);
		uint bgm = ab & 255u;
		// digging and blasts disturb the ground around them: natural rock nearby is no longer
		// treated as part of the planet, so a piece you cut free will fall
		// (only what this staff could dig: a wall of something harder, like a vault's obsidian,
		// stays exactly where it is even if you dig all the way round it)
		if ((mode == 1 || mode == 2 || mode == 6 || mode == 8 || mode == 11) && dist < rad + 12.0) {
			if ((c & ST_ANCHOR) != 0u && HARD[t] <= power) c &= ~ST_ANCHOR;
			if (HARD[bgm] <= power) ab &= ~BG_ANCHOR;    // a generated building's walls wake up too
		}
		if (mode == 2 && B.x > 0.5 && B.x < 1.5 && dist < rad + 2.5 && R < 0.5) {
			// fire spells set burnable things alight (foreground and background plants)
			if (FUEL[t] > 0u && t != M_TORCH) { c = M_FIRE | (c & 0xff00u) | (FUEL[t] << 16); continue; }
			if (t == 0u && bgm != 0u && FUEL[bgm] > 0u && bgm != M_TORCH) { c = M_FIRE | (c & 0xff00u) | (FUEL[bgm] << 16); ab = decorGone(ab); continue; }
		}
		if (mode == 11) continue;   // (only that: what was round cells taken away precisely wakes)
		if (mode == 1 && dist > rad && dist < rad + 1.6) {
			// knock off lone pixels around the hole so the mage doesn't snag on them
			if (isBlock(t) && HARD[t] <= power && COLLECT[t] == 1u) {
				int open = 0;
				for (int dd = 0; dd < 4; dd++) { if (!isBlock(tAt(nbr(s, y, x, dd)))) open++; }
				if (open >= 3) { atomicAdd(counts.n[ob + (collectAs(t))], 1u); c = withFG(c, 0u, 0u); }
			}
			continue;
		}
		if (dist > rad) continue;
		if (mode == 1) { // excavate
			bool keepBg = (ab & BG_WALL) != 0u || bgm == M_TREASURE || bgm == M_OPENCHEST || bgm == M_DECOR || bgm == M_TORCH;
			if ((t == 0u || KIND[t] == K_GAS) && bgm != 0u && !keepBg) {
				// nothing in front: harvest the background plant / decoration (never a building's
				// walls or furniture: those need the deconstruct action)
				if (HARD[bgm] > power) { atomicAdd(counts.n[ob + C_HARD], 1u); continue; }
				if (R > 0.3) continue;
				atomicAdd(counts.n[ob + (collectAs(bgm))], 1u);
				ab = 0u;
				continue;
			}
			if (t == 0u || COLLECT[t] == 0u) continue;
			if (t == M_TREASURE) { atomicAdd(counts.n[ob + C_TREASURE], 1u); continue; }   // digging at a chest opens it
			if (HARD[t] > power) { atomicAdd(counts.n[ob + C_HARD], 1u); continue; }
			float rate = (KIND[t] == K_LIQUID ? 0.25 : 0.32 / (1.0 + float(HARD[t]) * 1.2)) * (1.0 + B.z);   // (B.z: a faster staff)
			if (R > rate) continue;
			atomicAdd(counts.n[ob + (collectAs(t))], 1u);
			c = withFG(c, 0u, 0u);
		} else if (mode == 2 || mode == 6) { // explode / chip
			if (t == 0u || KIND[t] == K_LIQUID || KIND[t] == K_GAS) {
				if (mode == 2 && B.x > 0.5 && B.x < 1.5 && t == 0u && R < 0.18) c = withFG(c, M_FIRE, 12u + uint(R * 100.0));
				continue;
			}
			if (!isBlock(t) || HARD[t] > power) continue;
			if (mode == 6 && R > 0.7) continue;
			float edge = dist / max(rad, 0.001);
			uint nt = 0u; uint life = 0u;
			if (B.x > 1.5 && edge > 0.75 && (t == M_STONE || t == M_DEEPSTONE) && R < 0.5) nt = M_GRAVEL;
			else if (mode == 6 && HARD[t] >= 1u && R < 0.2) nt = M_GRAVEL;
			else if (B.x > 0.5 && B.x < 1.5 && R < 0.12) { nt = M_FIRE; life = 10u + uint(R * 200.0); }
			c = withFG(c, nt, life);
		} else if (mode == 7) { // open a chest: the treasure is taken, an opened chest stays behind
			if (bgm == M_TREASURE) {
				atomicAdd(counts.n[ob + C_CHEST_OPEN], 1u);
				ab = B.x > 0.5 ? (M_OPENCHEST | (ab & 0xff0000u)) : 0u;
			} else if (t == M_TREASURE) {   // a chest (it stands in the foreground; you walk through it)
				atomicAdd(counts.n[ob + C_CHEST_OPEN], 1u);
				ab = B.x > 0.5 ? (M_OPENCHEST | (((c >> 8) & 255u) << 16)) : 0u;
				c = withFG(c, 0u, 0u);
			}
		} else if (mode == 8) { // deconstruct: take background tiles (back walls, furniture, plants)
			if (bgm != 0u && bgm != M_TREASURE) {
				if (HARD[bgm] > power) { atomicAdd(counts.n[ob + C_HARD], 1u); continue; }
				if (R > 0.35) continue;
				// (a torch's flame goes out: torches come back whole, picked up as a piece)
				if (bgm == M_TORCH) { ab = 0u; continue; }
				atomicAdd(counts.n[ob + (collectAs(bgm))], 1u);
				ab = decorGone(ab);          // (furniture: the wall behind it stays)
			}
		} else if (mode == 3) { // fill with liquid
			if (t == 0u || KIND[t] == K_GAS || KIND[t] == K_FIRE) c = withFG(c, uint(B.x), uint(B.x) == M_FIRE ? 20u : 0u);
		} else if (mode == 4) { // freeze
			if (t == M_WATER) c = withFG(c, M_ICE, 0u);
			else if (t == M_LAVA) c = withFG(c, M_OBSIDIAN, 0u);
			else if (t == M_FIRE) c = withFG(c, 0u, 0u);
			else if (t == M_STEAM) c = withFG(c, M_SNOW, 0u);
			else if (t == M_MUD) c = withFG(c, M_DIRT, 0u);
		} else if (mode == 9) { // a door: B.x = 1 closes it (fills its doorway), 0 opens it; B.y, B.z = half width, height
			vec2 rdir = normalize(A.xy);
			vec2 tg = vec2(-rdir.y, rdir.x);
			vec2 dd = p - A.xy;
			float u = dot(dd, tg), vv = dot(dd, rdir);
			if (abs(u) < B.y && abs(vv) < B.z) {
				if (B.x > 0.5) {
					if (t == 0u || KIND[t] == K_GAS || KIND[t] == K_LIQUID || t == M_SNOW || t == M_ASH) {
						uint row = uint(clamp(B.z - vv, 0.0, 31.0));
						uint col = uint(clamp(u + B.y, 0.0, 3.0));
						c = M_WOODDOOR | (((row << 2) | col) << 8) | ST_ANCHOR | ST_BUILT;
					}
				} else if (t == M_WOODDOOR) {
					c = 0u;
				}
			}
		} else if (mode == 10) { // build: a back wall of material B.x where there is no background yet (budget B.z)
			if (bgm != 0u) continue;
			uint usedw = atomicAdd(counts.n[ob + C_PLACED], 1u);
			if (usedw < uint(B.z)) ab = uint(B.x) | BG_WALL;
		} else if (mode == 5) { // conjure from the satchel
			uint m = uint(B.x);
			// into air, smoke or flames, or pushing water and lava aside (a stone bridge over a pond)
			if (!(t == 0u || KIND[t] == K_GAS || KIND[t] == K_FIRE || (KIND[t] == K_LIQUID && t != m))) continue;
			if (isBlock(m) && distance(p, P.p[6].zw) < B.w) continue;
			uint used = atomicAdd(counts.n[ob + C_PLACED], 1u);
			// (what you conjure is built: dressed blocks look like blocks, not the planet's own rock)
			if (used < uint(B.z)) c = withFG(c, m, m == M_FIRE ? 30u : 0u) | (KIND[m] == K_SOLID ? ST_BUILT : 0u);
		}
	}
	world.cells[i] = c;
	aux.a[i] = ab;
}
