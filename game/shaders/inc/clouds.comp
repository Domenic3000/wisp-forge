// ---- clouds: one world-space layer, shared by render.comp (drawn, and flown through as fog),
// react.comp (rain, snow and ash fall from their undersides) and grid.comp (how deep in cloud
// each mage is). They sit at a fixed height above the planet's mean surface, so mountains rise
// into them, and drift around the planet with the wind (P.p[121].y). Flat-ish bottoms, billowing
// tops; more of the sky clouds over while it rains (P.p[3].z).
float cloudLow(vec2 pos) {
	float r = length(pos);
	float hgt = r - RS0;
	if (hgt < 60.0 || hgt > 290.0) return 0.0;
	float wnd = P.p[121].y;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	float base = 120.0 + (fbm(q / 320.0, 4244, 1) - 0.5) * 44.0;
	float top = base + 26.0 + fbm(q / 95.0, 4245, 2) * 80.0;
	if (hgt < base - 4.0 || hgt > top + 8.0) return 0.0;
	float edge = smoothstep(base - 4.0, base + 7.0, hgt) * (1.0 - smoothstep(top - 22.0, top + 8.0, hgt));
	float n = fbm(q / 52.0, 4242, 3);
	float cover = 0.565 - P.p[3].z * 0.2;
	return clamp((n - cover) * 6.0, 0.0, 1.0) * edge;
}

// The upper weather layer: wide, flat sheets 225-360 cells above the mean surface, well over the
// highest peaks, moving faster than the low clouds. Mostly clear in fine weather; it closes over
// in rain. Rain, snow and ash fall from its underside (react.comp), so snow drifts down onto the
// mountains instead of starting right on top of them.
float cloudHigh(vec2 pos) {
	float r = length(pos);
	float hgt = r - RS0;
	if (hgt < 215.0 || hgt > 370.0) return 0.0;
	float wnd = P.p[121].y * 1.7;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	// sheets stretched along the sky: sample in (arc, height) with the height squeezed
	vec2 s2 = vec2(atan(q.y, q.x) * RS0, hgt * 2.6);
	float base = 238.0 + (fbm(s2 / vec2(420.0, 9000.0), 4246, 1) - 0.5) * 30.0;
	float top = base + 22.0 + fbm(s2 / vec2(150.0, 9000.0), 4247, 2) * 64.0;
	if (hgt < base - 4.0 || hgt > top + 8.0) return 0.0;
	float edge = smoothstep(base - 4.0, base + 6.0, hgt) * (1.0 - smoothstep(top - 18.0, top + 8.0, hgt));
	float n = fbm(s2 / 110.0, 4248, 3);
	float cover = 0.6 - P.p[3].z * 0.32;
	return clamp((n - cover) * 5.0, 0.0, 1.0) * edge;
}

// Ground fog (a marsh world's: P.p[125].w): low wisps lying in the lowlands, below the mean surface and a
// little above it, drifting slowly; never thick enough to hide the way.
float groundFog(vec2 pos) {
	float f = P.p[125].w;
	if (f <= 0.0) return 0.0;
	float hgt = length(pos) - RS0;
	if (hgt < -70.0 || hgt > 46.0) return 0.0;
	float wnd = P.p[121].y * 0.5;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	float n = fbm(q / 38.0, 4251, 3);
	float edge = 1.0 - smoothstep(14.0, 46.0, hgt);
	return clamp((n - 0.44) * 2.6, 0.0, 0.5) * edge * f;
}

float cloudDensity(vec2 pos) { return max(max(cloudLow(pos), cloudHigh(pos)), groundFog(pos)); }
