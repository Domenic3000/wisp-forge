// ---- clouds: one world-space layer, shared by render.comp (drawn, and flown through as fog),
// react.comp (rain, snow and ash fall from their undersides) and grid.comp (how deep in cloud
// each mage is). They sit at a fixed height above the planet's mean surface, so mountains rise
// into them, and drift around the planet with the wind (P.p[121].y). Flat-ish bottoms, billowing
// tops; more of the sky clouds over while it rains (P.p[3].z).
float cloudLow(vec2 pos) {
	float r = length(pos);
	float hgt = r - RS0;
	if (hgt < 60.0 || hgt > 290.0) return 0.0;
	float wnd = P.p[121].y;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	float base = 120.0 + (fbm(q / 320.0, 4244, 1) - 0.5) * 44.0;
	float top = base + 26.0 + fbm(q / 95.0, 4245, 2) * 80.0;
	if (hgt < base - 4.0 || hgt > top + 8.0) return 0.0;
	float edge = smoothstep(base - 4.0, base + 7.0, hgt) * (1.0 - smoothstep(top - 22.0, top + 8.0, hgt));
	float n = fbm(q / 52.0, 4242, 3);
	float cover = 0.565 - P.p[3].z * 0.2;
	return clamp((n - cover) * 6.0, 0.0, 1.0) * edge;
}

// The upper weather layer: wide, flat sheets 225-360 cells above the mean surface, well over the
// highest peaks, moving faster than the low clouds. Mostly clear in fine weather; it closes over
// in rain. Rain, snow and ash fall from its underside (react.comp), so snow drifts down onto the
// mountains instead of starting right on top of them.
float cloudHigh(vec2 pos) {
	float r = length(pos);
	// (terrain 4's worlds have taller peaks and a higher sky: the upper layer sits 130 higher, still over them)
	float hgt = r - RS0 - (P.p[26].x > 3.5 ? 130.0 : 0.0);
	if (hgt < 215.0 || hgt > 370.0) return 0.0;
	float wnd = P.p[121].y * 1.7;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	// sheets stretched along the sky: sample in (arc, height) with the height squeezed
	vec2 s2 = vec2(atan(q.y, q.x) * RS0, hgt * 2.6);
	float base = 238.0 + (fbm(s2 / vec2(420.0, 9000.0), 4246, 1) - 0.5) * 30.0;
	float top = base + 22.0 + fbm(s2 / vec2(150.0, 9000.0), 4247, 2) * 64.0;
	if (hgt < base - 4.0 || hgt > top + 8.0) return 0.0;
	float edge = smoothstep(base - 4.0, base + 6.0, hgt) * (1.0 - smoothstep(top - 18.0, top + 8.0, hgt));
	float n = fbm(s2 / 110.0, 4248, 3);
	float cover = 0.6 - P.p[3].z * 0.32;
	return clamp((n - cover) * 5.0, 0.0, 1.0) * edge;
}

// Ground fog (a marsh world's: P.p[125].w; user, 26 Nov: "the fog was hard to see through, and it cut off abruptly
// under the surface with a straight edge ... it only exists above the surface and in a thin layer"; chose fog over
// all the land): a mist lying on the land itself (each column's ground, the surface table: surf_ro must come before
// this), fading in a few cells under the ground line so it has no edge of its own, thickest low down and thinning
// up to ~150 cells over the ground, a little thicker in the lowlands and thinner on the hills; patchy, drifting.
// render.comp draws it as a soft see-through haze, not as cloud; grid.comp's fog depth (the miasma) reads it.
float groundFog(vec2 pos) {
	float f = P.p[125].w;
	if (f <= 0.0) return 0.0;
	float r = length(pos);
	float hgt = r - RS0;
	if (hgt < -420.0 || hgt > 420.0) return 0.0;
	float th = atan(pos.y, pos.x);
	if (th < 0.0) th += TAU;
	float sr = surfA(th).x;
	float above = r - sr;
	if (above < -10.0 || above > 150.0) return 0.0;
	float wnd = P.p[121].y * 0.5;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	float n = fbm(q / 46.0, 4251, 3);
	float low = clamp(0.8 + (RS0 - sr) / 140.0, 0.6, 1.15);
	float edge = smoothstep(-10.0, 3.0, above) * (1.0 - smoothstep(24.0, 150.0, above));
	return clamp(0.36 + (n - 0.5) * 0.6, 0.06, 0.62) * low * edge * f;
}

// A gas giant's cloud deck (P.p[125].x < -0.5; user, 24 Nov: "gas giants with no ground or only clouds"):
// from about 40 cells under the mean surface down, a sea of cloud with no bottom you can see. Its top
// billows in long swells that drift with the wind; under it everything is hidden, and flown into it is a
// thick fog. (Its floor lies hundreds of cells further down, where the air crushes you: main `_hazard_level`.)
float cloudDeck(vec2 pos) {
	if (P.p[125].x > -0.5) return 0.0;
	float hgt = length(pos) - RS0;
	if (hgt > 10.0) return 0.0;
	float wnd = P.p[121].y * 0.8;
	float cw = cos(wnd), sw = sin(wnd);
	vec2 q = vec2(pos.x * cw - pos.y * sw, pos.x * sw + pos.y * cw);
	float arc = atan(q.y, q.x) * RS0;
	float top = -40.0 + (fbm(vec2(arc / 260.0, 0.5), 4261, 3) - 0.5) * 56.0 + (fbm(vec2(arc / 55.0, 1.5), 4262, 2) - 0.5) * 16.0;
	if (hgt > top + 6.0) return 0.0;
	float edge = 1.0 - smoothstep(top - 12.0, top + 6.0, hgt);
	float n = fbm(q / 40.0, 4263, 3);
	return clamp(0.62 + n * 0.5 + smoothstep(top - 12.0, top - 70.0, hgt), 0.0, 1.0) * edge;
}

// the clouds drawn as clouds (render.comp draws the ground fog apart, as haze)
float cloudSky(vec2 pos) { return max(max(cloudLow(pos), cloudHigh(pos)), cloudDeck(pos)); }
float cloudDensity(vec2 pos) { return max(cloudSky(pos), groundFog(pos)); }
