// ---- shared helpers (pure functions, no buffer access) ----
// Main cell layout: bits 0-7 foreground material, 8-15 colour variant, 16-23 life
// (for falling blocks: how far they have fallen), 24-29 SUPPORT distance (how far
// this solid reaches out from something resting on the ground; above SPAN[t] it
// breaks loose), bit 30 ANCHORED (untouched natural terrain: part of the planet).
// The background layer (trees, back walls...) lives in a second buffer, see "aux".
#define ST_ANCHOR 0x40000000u
// bit 31 BUILT: put there by a blueprint (a structure, yours or the planet's), not the planet's own
// ground. An anchored built cell wakes when a built neighbour is awake (support.comp), so once you
// dig near any part of a building the whole of it obeys the physics and can come down.
#define ST_BUILT 0x80000000u
#define ST_MAX 63u
uint stOf(uint c) { return (c >> 24) & 63u; }
uint withST(uint c, uint st) { return (c & 0xc0ffffffu) | (min(st, ST_MAX) << 24); }
// changing a cell's material resets its structure state (not anchored, support 0)
uint withFG(uint c, uint t, uint life) { return t | (c & 0xff00u) | (life << 16); }
// what excavating a material puts in the satchel
uint collectAs(uint t) { return (t == M_TIMBER || t == M_ROOT) ? M_WOOD : (t == M_LITTER ? M_LEAF : ((t == M_OPENCHEST || t == M_DECOR || t == M_WOODDOOR) ? M_PLANK : t)); }
layout(push_constant, std430) uniform PC { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;
// the planet's geometry and shell table (Defs.shell_table): per shell (first row, end row, columns,
// offset in the world). Not compiled in, so the shaders are the same for every planet.
layout(std430, set = 0, binding = 10) restrict readonly buffer Shells { vec4 geo[2]; ivec4 sh[]; } SHL;
#define R_TOP (SHL.geo[0].x)
#define RS0 (SHL.geo[0].y)
#define R_SPACE (SHL.geo[0].z)
#define ROWS (int(SHL.geo[0].w))
#define NSH (int(SHL.geo[1].x))
#define SURF (int(SHL.geo[1].y))
#define NS (int(SHL.geo[1].z))
#define SH_Y0(s) (SHL.sh[s].x)
#define SH_Y1(s) (SHL.sh[s].y)
#define SH_N(s) (SHL.sh[s].z)
#define SH_OFF(s) (SHL.sh[s].w)

uint hashu(uint x) {
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}
float rnd3(uint a, uint b, uint c) { return float(hashu(a ^ hashu(b ^ hashu(c)))) * (1.0 / 4294967296.0); }
float h2(ivec2 p, int s) {
	return float(hashu(uint(p.x) * 73856093u ^ hashu(uint(p.y) * 19349663u ^ uint(s) * 83492791u))) * (1.0 / 4294967296.0);
}
float vnoise(vec2 p, int s) {
	vec2 i = floor(p); vec2 f = p - i; vec2 u = f * f * (3.0 - 2.0 * f);
	ivec2 ii = ivec2(i);
	float a = h2(ii, s), b = h2(ii + ivec2(1, 0), s), c = h2(ii + ivec2(0, 1), s), d = h2(ii + ivec2(1, 1), s);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p, int s, int oct) {
	float sum = 0.0, amp = 1.0, norm = 0.0;
	for (int o = 0; o < oct; o++) { sum += vnoise(p, s + o * 101) * amp; norm += amp; amp *= 0.5; p *= 2.03; }
	return sum / norm;
}

// shells: rings of rows, stored top (orbit band, negative rows) to bottom (the heart), each with its
// own number of columns (SH_N); neighbouring shells differ by about a sixteenth (Defs.set_geometry).
int shellOf(int y) {
	int lo = 0, hi = NSH - 1;
	while (lo < hi) {
		int mid = (lo + hi + 1) >> 1;
		if (y >= SH_Y0(mid)) lo = mid; else hi = mid - 1;
	}
	return lo;
}
int shAbove(int s) { return s - 1; }
int shBelow(int s) { return s + 1 < NSH ? s + 1 : -1; }
// the column of shell `to` (a neighbour of shell `from`) whose middle is nearest column x's
int colTo(int from, int to, int x) { return ((2 * x + 1) * SH_N(to)) / (2 * SH_N(from)); }
// a surface-shell column (the surface table, sites) in shell s, by angle
int colIn(int s, int c) { return ((2 * c + 1) * SH_N(s)) / (2 * NS); }
// (x mod n, 0..n-1, for any x: % is only ever taken of non-negative numbers. Vulkan leaves % of a
// negative number undefined, and on NVIDIA it came out right only for widths that are a power of two:
// a planet 8192 columns round worked, one of 12288 sent stamps anchored to their right astray)
int wrapc(int x, int n) { return x >= 0 ? x % n : n - 1 - ((-x - 1) % n); }
// A stamp's column k (counted from its anchor column ax, of an anchor aw wide) in shell s: one cell
// per blueprint column in every shell, centred on the anchor's middle (Defs.stamp_x), so a building
// is the same pixel for pixel at any depth. In the surface shell it is column ax + k.
int stampLeft(int n, int ax, int aw) {
	// (its left edge: the cell nearest half its width left of the anchor's middle, which lies at
	// (2 ax + aw) n / 2 NS cells; the 2 NS aw keeps the division on positive numbers)
	return ((2 * ax + aw) * n + (1 - aw) * NS + 2 * NS * aw) / (2 * NS) - aw;
}
int stampX(int s, int ax, int aw, int k) {
	int n = SH_N(s);
	return wrapc(stampLeft(n, ax, aw) + k, n);
}
// a surface column's offset from an anchor, the short way round
int kOf(int col, int ax) { int k = wrapc(col - ax, NS); return k > NS / 2 ? k - NS : k; }
int cellIdx(int s, int y, int x) { return SH_OFF(s) + (y - SH_Y0(s)) * SH_N(s) + x; }
// neighbour coordinates (shell, row, column) across shells: dir 0 up (outward), 1 down, 2 left,
// 3 right; ivec3(-1) if none
ivec3 stepC(int s, int y, int x, int dir) {
	int n = SH_N(s);
	if (dir == 2) return ivec3(s, y, x == 0 ? n - 1 : x - 1);
	if (dir == 3) return ivec3(s, y, x == n - 1 ? 0 : x + 1);
	if (dir == 0) {
		int yy = y - 1;
		if (yy < SH_Y0(s)) { int a = shAbove(s); return a < 0 ? ivec3(-1) : ivec3(a, yy, colTo(s, a, x)); }
		return ivec3(s, yy, x);
	}
	int yy = y + 1;
	if (yy >= SH_Y1(s)) { int b = shBelow(s); return b < 0 ? ivec3(-1) : ivec3(b, yy, colTo(s, b, x)); }
	return ivec3(s, yy, x);
}
// The simulated window: rows pc.a.y .. pc.a.z, and in each shell the columns from the window's
// start angle (pc.d.x, radians) across its span (pc.d.y; TAU or more: the whole ring). A pass
// dispatches the widest shell's count; each thread works out its own shell from its row.
int winCount(int s) {
	int n = SH_N(s);
	if (pc.d.y >= TAU) return n;
	int c = int(ceil(pc.d.y / TAU * float(n))) + 2;
	c += c & 1;
	return min(c, n);
}
int winX0(int s) { return pc.d.y >= TAU ? 0 : int(floor(pc.d.x / TAU * float(SH_N(s)))); }
vec2 cellCenter(int s, int y, int x) {
	float r = R_TOP - (float(y) + 0.5);
	float th = (float(x) + 0.5) / float(SH_N(s)) * TAU;
	return vec2(cos(th), sin(th)) * r;
}
float angleOf(vec2 p) { float t = atan(p.y, p.x); return t < 0.0 ? t + TAU : t; }
// index of the cell containing world position p, or -1 outside the simulated shells
int idxAt(vec2 p) {
	float r = length(p);
	if (r >= R_SPACE || r < R_IN) return -1;
	int y = min(int(floor(R_TOP - r)), ROWS - 1);
	int s = shellOf(y);
	int x = min(int(angleOf(p) / TAU * float(SH_N(s))), SH_N(s) - 1);
	return cellIdx(s, y, x);
}
vec3 palColor(uint t, uint v) {
	uint c = PAL[t * 4u + (v & 3u)];
	return vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0;
}
// is material t able to move into a cell holding u (falling / flowing)
bool canDisp(uint t, uint u) {
	uint ku = KIND[u];
	if (u == 0u || ku == K_GAS || ku == K_FIRE) return true;
	if (ku == K_LIQUID && DENS[u] < DENS[t]) return true;
	return false;
}
bool isBlock(uint t) { return KIND[t] == K_SOLID || KIND[t] == K_POWDER; }
