// ---- binding 1: per-frame parameters (array of vec4, see gpu_world.gd for layout) ----
layout(std430, set = 0, binding = 1) restrict readonly buffer Params { vec4 p[]; } P;

// camera: p[1] = (Cx, Cy, angle, zoom), p[2] = (VW, VH, LS, numLights)
vec2 camR() { float a = P.p[1].z; return vec2(sin(a), -cos(a)); }
vec2 camD() { float a = P.p[1].z; return vec2(-cos(a), -sin(a)); }
// The picture is the screen with a margin round it (P.p[123] = PW, PH, PMX, PMY).
// The view is the world as it is, turned so that up points away from the planet's centre (a pixel is
// always P.p[1].w world units, at any height).
// The close view (P.p[122].w bit 4) is drawn a CELL a pixel instead: picture row j is the cell row
// P.p[124].y + j, and its pixels are that row's own shell's columns, counted from the one under the
// camera (P.p[ROWT + j] = N, that column; main._cell_rows), right to left as the screen goes. The view's
// shader (main VIEW_SHADER) lays it onto the screen in true world shape, so no cell is drawn twice or
// dropped (the world view a world unit a pixel did that wherever cells aren't exactly a unit wide, which
// showed as bands that stayed put as you walked).
// With the "unrolled" setting (bit 1, only in the close view) it is drawn in strips: screen x follows the
// angle around the planet (one pixel = one column of the shell the camera is in) and screen y the height,
// so the ground reads flat and every building stands straight anywhere on screen, but what's above and
// below you is stretched.
#define ROWT 128
vec2 cellPicToWorld(vec2 px) {
	int j = clamp(int(floor(px.y)), 0, 1023);
	vec4 rw = P.p[ROWT + j];
	float xi = rw.y + floor(P.p[123].x * 0.5) - 1.0 - floor(px.x);
	float ang = (xi + 0.5) / rw.x * TAU;
	float rad = R_TOP - (P.p[124].y + float(j)) - 0.5;
	return vec2(cos(ang), sin(ang)) * rad;
}
vec2 screenToWorld(vec2 px) {
	int vf = int(P.p[122].w + 0.5);
	if ((vf & 4) != 0) return cellPicToWorld(px);
	vec2 o = (px - P.p[123].zw - P.p[2].xy * 0.5) * P.p[1].w;
	if ((vf & 1) != 0) {
		float ustep = P.p[122].z > 0.0 ? P.p[122].z : TAU / float(NS);   // one column of the camera's shell per pixel
		float th = P.p[1].z - o.x * ustep;
		float r = length(P.p[1].xy) - o.y;
		return vec2(cos(th), sin(th)) * r;
	}
	return P.p[1].xy + camR() * o.x + camD() * o.y;
}
vec2 sunDir() { float a = P.p[0].z; return vec2(cos(a), sin(a)); }
