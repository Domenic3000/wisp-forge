// Planet generation. One thread per cell; runs once per planet in row bands.
// pc.a = (shell, rowStart, rowEnd, 0)
#include "common"
#include "world"
#include "params"
#include "surf_ro"
#include "bglayer"
// building sites (surface-shell column ranges) where no trees grow: s[0].x = count, s[1 + k] = (x0, x1, 0, 0)
layout(std430, set = 0, binding = 9) restrict readonly buffer Sites { vec4 s[]; } sites;
layout(local_size_x = 16, local_size_y = 16) in;

int SEED;

bool onSite(float th, float margin) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(NS);
	float N0 = float(NS);
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start, 0..N0
		if (d0 < q.y - q.x + margin || d0 > N0 - margin) return true;
	}
	return false;
}

vec4 biomeA(int b) { return P.p[8 + 2 * b]; }   // off, amp, topMat, flags
vec4 biomeB(int b) { return P.p[9 + 2 * b]; }   // subMat, topD, subD, ug + flora*16

// how many surface columns from the nearest building site (0 inside one)
float siteDist(float th) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(NS);
	float N0 = float(NS);
	float best = 1e6;
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start
		float len = q.y - q.x;
		float dist = d0 <= len ? 0.0 : min(d0 - len, N0 - d0);
		best = min(best, dist);
	}
	return best;
}

// Caves: winding tunnels (a thin band of one noise field) and caverns (high values of another).
// How much cave there is fades smoothly, never stopping at a hard line: toward the surface
// (except at cave mouths) and toward building sites (so foundations don't hang over a hole),
// the tunnels narrow to rounded tips and the caverns shrink, instead of ending in flat walls.
bool carvedAt(vec2 p, float r, float rs, float coreR) {
	float d = rs - r;
	if (d < 2.0 || r <= coreR + 3.0) return false;
	float th = angleOf(p);
	float entr = fbm(normalize(p) * RS0 / 34.0, SEED + 11, 1);
	float wob = (fbm(p / 23.0, SEED + 13, 2) - 0.5) * 14.0;
	float ks = entr >= 0.72 ? 1.0 : smoothstep(6.0, 22.0, d + wob);
	float kt = d > 75.0 ? 1.0 : max(smoothstep(4.0, 34.0, siteDist(th) + wob), smoothstep(40.0, 75.0, d + wob));
	float k = ks * kt;
	if (k < 0.02) return false;
	float df = clamp(d / max(rs - coreR, 1.0), 0.0, 1.0);
	// tunnels and caverns sized for the 24-cell-tall mage: roomy enough to jump and fight in
	float n1 = fbm(p / 90.0, SEED + 10, 2);
	if (abs(n1 - 0.5) < (0.022 + 0.016 * df) * k) return true;
	if (d > 24.0) {
		float n2 = fbm(p / 160.0, SEED + 12, 2);
		if (n2 > 0.675 - 0.07 * df + (1.0 - k) * 0.3 + (1.0 - smoothstep(24.0, 40.0, d)) * 0.1) return true;
	}
	return false;
}

// is the base terrain (strata minus caves) solid at p?
bool solidAt(vec2 p) {
	float r = length(p);
	if (r < R_IN) return true;
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	if (r >= sa.x) return false;
	return !carvedAt(p, r, sa.x, sb.x);
}

// Loose powders (sand, gravel, snow, ash) are only generated where they can rest. Where one
// would sit over a cave, on a steep slope, or around a building site (whose yard is dug out of
// the hillside), it is generated as the solid it packs into instead, so nothing pours down the
// moment you arrive.
uint packedSolid(uint m) {
	if (m == M_SAND) return M_SANDSTONE;
	if (m == M_SNOW) return M_ICE;
	return M_STONE;   // gravel, ash
}
uint settleSafe(uint m, vec2 p, float r, float th, float rs) {
	if (KIND[m] != K_POWDER) return m;
	vec2 dn = -p / r;
	vec2 sd = vec2(-dn.y, dn.x);
	if (!solidAt(p + dn) || !solidAt(p + dn + sd) || !solidAt(p + dn - sd)) return packedSolid(m);   // over or beside a cave
	float d = rs - r;
	if (d < 14.0) {
		float stp = 1.0 / RS0;
		float sl = max(abs(surfA(th - 2.0 * stp).x - rs), abs(surfA(th + 2.0 * stp).x - rs)) * 0.5;
		if (sl > 0.85) return packedSolid(m);                          // a steep face
		// around a building's yard; how deep and how far out the packed ground reaches wanders, so
		// it has no flat bottom or straight ends
		float wob = fbm(p / 7.0, SEED + 93, 2);
		if (d < 8.0 + 9.0 * wob && onSite(th, 6.0 + 14.0 * wob)) return packedSolid(m);
	}
	return m;
}

// A liquid ground layer (the bog's or jungle's mud) is only liquid in a bog: a hollow the ground
// rises around on both sides, or the floor under standing water, away from building sites and with
// solid ground under and beside it. Returns how deep the bog is at this column (0 = no bog), with
// a wobbling edge so bogs are lenses, not boxes. Everywhere else the layer is packed earth you can
// walk on, so a slope of "ground" is never a hidden pool you sink into.
float bogDepth(vec2 p, float r, float th, float rs, vec4 sb) {
	if (onSite(th, 10.0)) return 0.0;
	float stp = 3.0 / RS0;
	float rimL = rs, rimR = rs;
	for (int k = 1; k <= 16; k++) {
		rimL = max(rimL, surfA(mod(th - stp * float(k), TAU)).x);
		rimR = max(rimR, surfA(mod(th + stp * float(k), TAU)).x);
	}
	float lvl = min(rimL, rimR) - 1.0;
	if (sb.y > 0.0) lvl = max(lvl, sb.y);   // under a pond or lake
	float wob = fbm(p / 9.0, SEED + 95, 2);
	float bog = clamp((lvl - rs) * 0.7 + (wob - 0.5) * 3.0, 0.0, 6.0);
	float d = rs - r;
	if (d >= bog) return bog;
	vec2 dn = -p / r;
	vec2 sd = vec2(-dn.y, dn.x);
	vec2 bot = p + dn * (bog - d + 1.0);
	if (!solidAt(bot) || !solidAt(p + sd * 2.0) || !solidAt(p - sd * 2.0)) return 0.0;   // it would drain into a cave
	return bog;
}

float oreN(vec2 p, int k) { return fbm(p / 9.0 + vec2(float(k) * 17.3, float(k) * 9.1), SEED + 20 + k, 2); }

uint strata(vec2 p, float r, float th, vec4 sa, vec4 sb, int b) {
	float rs = sa.x, deepR = sa.z, magmaR = sa.w, coreR = sb.x;
	vec4 A = biomeA(b), B = biomeB(b);
	int flags = int(A.w);
	int ug = int(B.w) & 15;
	float d = rs - r;
	float subD = B.z + floor(h2(ivec2(int(th * RS0), 3), SEED) * 6.0);
	bool snowy = (flags & 1) != 0 && rs > RS0 + 48.0;
	uint m;
	if (snowy && d < 3.0) m = M_SNOW;
	else if (d < B.y) m = uint(A.z);
	else if (d < B.y + subD) m = uint(B.x);
	else if (r > deepR) m = M_STONE;
	else if (r > magmaR) m = M_DEEPSTONE;
	else if (r > coreR) m = M_MAGMAROCK;
	else return M_CORE;
	// mud: liquid in bogs, packed earth (grass on top) elsewhere
	if (d < B.y + subD) {
		uint liq = KIND[uint(A.z)] == K_LIQUID ? uint(A.z) : (KIND[uint(B.x)] == K_LIQUID ? uint(B.x) : 0u);
		if (liq != 0u) {
			if (d < bogDepth(p, r, th, rs, sb)) return liq;
			if (KIND[m] == K_LIQUID) m = d < 1.0 ? M_GRASS : M_DIRT;
		}
	}

	// the planet kind's own ore (Defs.KIND_ORES): P.p[126] = (material, three of the ground kinds it forms
	// in), P.p[127] = (depth from, depth to, threshold, the fourth ground kind + 1000 if only in the seabed)
	vec4 ko = P.p[126], kd = P.p[127];
	if (ko.x > 0.5 && d >= kd.x && d < kd.y) {
		float h4 = mod(kd.w, 1000.0);
		bool host = m == uint(ko.y + 0.5) || m == uint(ko.z + 0.5) || m == uint(ko.w + 0.5) || m == uint(h4 + 0.5);
		bool bed = kd.w < 999.5 || (P.p[7].y > 0.0 && rs < RS0 - P.p[7].y - 30.0);
		if (host && bed && oreN(p * 0.8, 10) > kd.z - (P.p[7].w - 1.0) * 0.02) return uint(ko.x + 0.5);
	}

	// ores and pockets
	float rich = (P.p[7].w - 1.0) * 0.03;
	if (m == M_STONE) {
		if (oreN(p, 0) > 0.815 - rich) return M_COPPER;
		if (oreN(p, 1) > 0.815 - rich) return M_COAL;
		if (ug == 1 && oreN(p, 2) > 0.79 - rich) return M_CRYSTAL;      // (prism crystal: rarer, for draughts and the focus)
		if (ug == 2 && d < 200.0 && oreN(p, 3) > 0.76 - rich) return M_FROST;
		if (ug == 3 && d < 160.0 && oreN(p, 4) > 0.77 - rich) return M_EMBER;
		if (oreN(p, 6) > 0.82) return M_GRAVEL;
		if (d < 100.0 && oreN(p, 7) > 0.82) return M_DIRT;
	} else if (m == M_DEEPSTONE) {
		float dd = (deepR - r) / max(deepR - magmaR, 1.0);
		if (dd > 0.4 && oreN(p, 4) > 0.82 - rich) return M_EMBER;
		if (oreN(p, 5) > 0.82 - rich) return M_WISP;
		if (oreN(p, 2) > 0.865 - rich) return M_CRYSTAL;
		if (oreN(p, 3) > 0.85 - rich) return M_FROST;
	} else if (m == M_MAGMAROCK) {
		if (oreN(p, 4) > 0.80 - rich) return M_EMBER;
		if (oreN(p, 8) > 0.79) return M_OBSIDIAN;
		if (oreN(p, 9) > 0.78) return M_DEEPSTONE;
	}
	return m;
}

// ---- trees: one kind per biome, sized for the 17-cell mage -----------------------------
// Each tree is evaluated per cell. q = (da, dy) is the offset from the tree's base: da along
// the surface, dy up. hh, h3 and h4 are the tree's own random numbers.
float segDist(vec2 q, vec2 a, vec2 b) {
	vec2 pa = q - a, ba = b - a;
	float t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * t);
}

// broad oak: a flared trunk, two branches and a lumpy crown of overlapping blobs; some are giants
uint oakTree(vec2 q, float hh, float h3, float h4, float nz) {
	bool giant = h3 < 0.12;
	float h = giant ? 58.0 + floor(hh * 14.0) : 30.0 + floor(hh * 24.0);
	float tw = giant ? 5.0 : (h > 42.0 ? 4.0 : 3.0);
	float R = 9.0 + h * 0.16;
	float da = q.x, dy = q.y;
	float hw = tw * 0.5 + max(0.0, 3.0 - dy) * 0.7;
	if (dy >= 0.0 && dy < h - R * 0.3 && abs(da) < hw) return M_WOOD;
	float side = h4 < 0.5 ? 1.0 : -1.0;
	if (segDist(q, vec2(0.0, h * 0.5), vec2(side * R * 0.55, h - R * 0.35)) < (giant ? 1.4 : 1.0)) return M_WOOD;
	if (segDist(q, vec2(0.0, h * 0.62), vec2(-side * R * 0.5, h - R * 0.2)) < 0.9) return M_WOOD;
	float rag = 1.0 - nz * 0.28;
	vec2 c0 = vec2(0.0, h), c1 = vec2(-R * 0.55, h - R * 0.3), c2 = vec2(R * 0.55, h - R * 0.25), c3 = vec2(R * 0.2 * side, h + R * 0.35);
	float e = min(min(length((q - c0) / vec2(R, R * 0.8)), length((q - c1) / vec2(R * 0.62, R * 0.5))),
	              min(length((q - c2) / vec2(R * 0.62, R * 0.52)), length((q - c3) / vec2(R * 0.6, R * 0.45))));
	if (e < rag) return M_LEAF;
	return 0u;
}

// pine: a straight trunk under tiers of needles that sweep down towards their tips, each tier
// wide at the bottom with a ragged edge; snow lies along the top of every tier. Some are giants.
bool pineIn(float x, float y, float dy0, float P, float top, float k, int bb) {
	float ax = abs(x);
	float yy = y + ax * 0.32;
	if (yy < dy0 || y > top) return false;
	float f = fract((yy - dy0) / P);
	float env = (top - yy) * k + 1.0;
	float w = env * (0.3 + 0.7 * pow(1.0 - f, 1.6));
	w += (h2(ivec2(int(floor(yy)), bb * 3 + (x > 0.0 ? 1 : 0)), SEED + 9) - 0.5) * 1.4 * min(1.0, env * 0.15);
	return ax < w;
}
uint pineTree(vec2 q, float hh, float h3, bool snowy, int bb) {
	bool giant = h3 < 0.14;
	float h = giant ? 70.0 + floor(hh * 24.0) : 30.0 + floor(hh * 34.0);
	float tw = h > 70.0 ? 4.0 : (h > 45.0 ? 3.0 : 2.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float dy0 = 4.0 + h * 0.09, P = 6.0 + h * 0.07, top = h + 3.0, k = giant ? 0.31 : 0.28;
	if (pineIn(da, dy, dy0, P, top, k, bb)) {
		if (snowy && !pineIn(da, dy + 1.0, dy0, P, top, k, bb)) return M_SNOW;
		if (snowy && abs(da) > 1.0 && !pineIn(da, dy + 2.0, dy0, P, top, k, bb) && h2(ivec2(int(dy * 7.0 + da * 3.0), bb), SEED + 12) < 0.45) return M_SNOW;
		return M_LEAF;
	}
	float hw = tw * 0.5 + max(0.0, 2.0 - dy) * 0.8;
	if (dy < h - 6.0 && abs(da) < hw) return M_WOOD;
	return 0u;
}

// saguaro: a thick ribbed column with a rounded crown, and one to three arms that elbow out and
// turn up (each with its own height, reach and length), sized against the 24-cell mage
uint cactusTree(vec2 q, float hh, float h3, float h4) {
	float h = 22.0 + floor(hh * 24.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float tw = h > 34.0 ? 2.6 : 2.1;
	if (dy < h - tw && abs(da) < tw) return M_CACTUS;
	if (dy >= h - tw && length(vec2(da, dy - (h - tw))) < tw) return M_CACTUS;
	int arms = 1 + int(h3 * 2.99);
	for (int k = 0; k < 3; k++) {
		if (k >= arms) break;
		float hk = fract(h4 * 7.13 + float(k) * 0.37);
		float side = ((k % 2 == 0) == (h4 < 0.5)) ? 1.0 : -1.0;
		float ay = floor(h * (0.3 + 0.16 * hk + 0.12 * float(k)));
		float ax = tw + 2.0 + floor(hk * 3.0);
		float up = floor(h * (0.2 + 0.18 * hk));
		float aw = 1.5;
		float x = da * side;
		if (x > 0.0 && x < ax && abs(dy - ay - aw) < aw) return M_CACTUS;                 // out
		if (length(vec2(x, dy) - vec2(ax, ay + aw)) < aw + 0.4) return M_CACTUS;          // the elbow
		if (abs(x - ax) < aw && dy > ay + aw && dy < ay + aw + up) return M_CACTUS;        // up
		if (length(vec2(x - ax, dy - (ay + aw + up))) < aw) return M_CACTUS;              // its tip
	}
	return 0u;
}

// palm: a leaning, curving trunk with drooping fronds
uint palmTree(vec2 q, float hh, float h3) {
	float h = 28.0 + floor(hh * 18.0);
	float lean = (h3 < 0.5 ? 1.0 : -1.0) * (3.0 + h3 * 6.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h) {
		float t = dy / h;
		if (abs(da - lean * t * t) < 1.4 - t * 0.4) return M_WOOD;
	}
	vec2 top = vec2(lean, h);
	if (length(q - top - vec2(0.0, 1.0)) < 2.6) return M_LEAF;
	for (int k = 0; k < 4; k++) {
		float fk = float(k);
		float L = 10.0 + fk * 3.2;
		for (int sd = -1; sd <= 1; sd += 2) {
			float x = (da - lean) * float(sd);
			if (x < 0.0 || x > L) continue;
			float yf = h + 2.0 + fk * 0.9 - 0.055 * (1.0 + 0.45 * fk) * x * x;
			if (abs(dy - yf) < 0.9 + (1.0 - x / L) * 0.6) return M_LEAF;
		}
	}
	return 0u;
}

// willow: a thick trunk, a low dome of leaves and long strands hanging from it
uint willowTree(vec2 q, float hh, float h3, int bb, float nz) {
	float h = 30.0 + floor(hh * 20.0);
	float R = 13.0 + h3 * 7.0;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < 2.0 + max(0.0, 3.0 - dy) * 0.7) return M_WOOD;
	float e = length((q - vec2(0.0, h)) / vec2(R, R * 0.55));
	if (dy >= h - 2.0 && e < 1.0 - nz * 0.2) return M_LEAF;
	if (abs(da) < R * 0.95 && dy < h - 1.0) {
		int ci = int(floor(da + 200.0));
		float hs = h2(ivec2(bb * 7 + ci, 91), SEED);
		float Ls = R * 0.5 + h2(ivec2(bb * 7 + ci, 92), SEED) * R * 0.9;
		if (hs < 0.55 && dy > max(2.0, h - 1.0 - Ls)) return M_LEAF;
	}
	return 0u;
}

// charred tree: a burnt black trunk with bare, jagged branches
uint charredTree(vec2 q, float hh, int bb) {
	float h = 26.0 + floor(hh * 26.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < (h > 30.0 ? 1.5 : 1.0) + max(0.0, 2.0 - dy) * 0.5) return M_COAL;
	for (int k = 0; k < 4; k++) {
		float hk = h2(ivec2(bb, 90 + k), SEED);
		float y0 = h * (0.35 + 0.15 * float(k));
		float sd = (k % 2 == 0) ? 1.0 : -1.0;
		if (hk < 0.3) sd = -sd;
		float L = 5.0 + hk * 8.0;
		vec2 a = vec2(0.0, y0), b = vec2(sd * L * 0.8, y0 + L * 0.7);
		if (segDist(q, a, b) < 0.7) return M_COAL;
		if (segDist(q, b, b + vec2(sd * 2.5, 3.5 - hk * 3.0)) < 0.6) return M_COAL;
	}
	return 0u;
}

// jungle giant: a tall trunk flaring into buttress roots, a wide flat canopy of overlapping
// layers, a lower side branch with its own small canopy, and vines hanging from the canopy
uint jungleTree(vec2 q, float hh, float h3, float h4, int bb, float nz) {
	bool giant = h3 < 0.15;
	float h = 52.0 + floor(hh * 30.0) + (giant ? 12.0 : 0.0);
	float tw = h > 70.0 ? 6.0 : 5.0;
	float R = 14.0 + h * 0.12;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < 8.0 && abs(da) < tw * 0.5 + pow(8.0 - dy, 1.6) * 0.32) return M_WOOD;
	if (dy < h - 4.0 && abs(da) < tw * 0.5) return M_WOOD;
	float side = h4 < 0.5 ? 1.0 : -1.0;
	float by = h * 0.55, bx = side * R * 0.75;
	if (segDist(q, vec2(0.0, by), vec2(bx, by + R * 0.25)) < 1.3) return M_WOOD;
	if (segDist(q, vec2(0.0, h - 6.0), vec2(-side * R * 0.5, h - 1.0)) < 1.1) return M_WOOD;
	if (segDist(q, vec2(0.0, h - 5.0), vec2(side * R * 0.45, h)) < 1.0) return M_WOOD;
	float rag = 1.0 - nz * 0.25;
	float e = min(min(length((q - vec2(0.0, h + 2.0)) / vec2(R, R * 0.38)), length((q - vec2(-R * 0.62, h - 1.0)) / vec2(R * 0.58, R * 0.3))),
	              min(length((q - vec2(R * 0.62, h)) / vec2(R * 0.6, R * 0.32)), length((q - vec2(R * 0.15 * side, h + R * 0.3)) / vec2(R * 0.55, R * 0.28))));
	if (e < rag) return M_LEAF;
	if (length((q - vec2(bx, by + R * 0.3)) / vec2(R * 0.42, R * 0.2)) < rag) return M_LEAF;
	// vines: some columns under the canopy hang a strand down from its underside
	int vc = int(floor(da)) + bb * 97;
	if (abs(da) < R * 0.85 && h2(ivec2(vc, 31), SEED + 7) < 0.28) {
		float bot = h + 2.0 - R * 0.38 * sqrt(max(0.0, 1.0 - (da / R) * (da / R)));
		float ln = 5.0 + floor(h2(ivec2(vc, 32), SEED + 7) * 11.0);
		if (dy < bot && dy > bot - ln) return M_LEAF;
	}
	return 0u;
}

// acacia: a leaning trunk that forks into two limbs under a flat-bottomed umbrella crown (two pads)
uint acaciaTree(vec2 q, float hh, float h4, int bb, float nz) {
	float h = 26.0 + floor(hh * 16.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float lean = (h4 - 0.5) * 0.5;
	float fy = h * 0.5;
	float R = 13.0 + hh * 9.0;
	float x = da - lean * min(dy, fy);
	if (dy < fy && abs(x) < 1.6 + max(0.0, 2.0 - dy) * 0.7) return M_WOOD;
	float tx = lean * fy;
	if (segDist(q, vec2(tx, fy), vec2(tx - R * 0.42, h - 2.0)) < 1.1) return M_WOOD;
	if (segDist(q, vec2(tx, fy), vec2(tx + R * 0.42, h - 2.0)) < 1.1) return M_WOOD;
	float ry = 5.0 + hh * 3.0;
	float rag = 1.0 - nz * 0.3;
	if (dy > h - 4.5 && length((q - vec2(tx, h - 3.0)) / vec2(R, ry)) < rag) return M_LEAF;
	vec2 c2 = vec2(tx + (h4 - 0.5) * R * 0.8, h + ry * 0.6);
	if (dy > c2.y - 2.5 && length((q - vec2(c2.x, c2.y - 1.0)) / vec2(R * 0.6, ry * 0.8)) < rag) return M_LEAF;
	return 0u;
}

// giant mushroom: a pale stalk that bends a little, with a ring, under a broad domed cap whose rim
// droops; some are giants
uint mushroomTree(vec2 q, float hh, float h3, float h4) {
	bool giant = h3 < 0.15;
	float h = giant ? 50.0 + floor(hh * 12.0) : 18.0 + floor(hh * 26.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float sw = 1.3 + h * 0.035;
	float off = sin(dy * 0.07 + h4 * 6.0) * 1.6 * min(1.0, dy / h);
	float Rc = 8.0 + h * 0.32, Hc = 5.0 + h * 0.13;
	float co = sin(h * 0.07 + h4 * 6.0) * 1.6;
	if (dy >= h - 2.0 && length(vec2((da - co) / Rc, (dy - (h - 2.0)) / Hc)) < 1.0) return M_CAP;
	if (dy >= h - 4.0 && dy < h - 2.0 && abs(da - co) < Rc && abs(da - co) > Rc * 0.8) return M_CAP;
	if (abs(dy - h * 0.72) < 0.9 && abs(da - off) < sw + 1.3) return M_STALK;
	if (dy < h && abs(da - off) < sw + max(0.0, 2.5 - dy) * 0.7) return M_STALK;
	return 0u;
}

// Roots, for every kind of tree with a woody trunk: the trunk carries on down into the ground as a
// tapering taproot (so on a slope it reaches the earth instead of ending flat in the air), and three to
// five roots run out from its foot, near the surface first and then diving. Where the ground falls away
// they show; below the surface they lie in the background behind the earth, found when you dig. q is
// the cell from the trunk's foot (q.y < 0 below it), tw the trunk's width, mat its wood.
float rootWidth(int ft) {
	return ft == 1 ? 4.0 : (ft == 2 ? 3.0 : (ft == 4 ? 4.0 : (ft == 5 ? 2.0 : (ft == 6 ? 2.0 : (ft == 7 ? 5.5 : (ft == 8 ? 2.5 : 0.0))))));
}
uint treeRoots(vec2 q, float tw, float hh, float h3, int bb, uint mat) {
	if (q.y < -18.0) return 0u;
	float tap = 5.0 + floor(hh * 8.0);
	if (-q.y < tap && abs(q.x) < tw * 0.5 * (1.0 + q.y / tap * 0.6) + 0.35) return mat;
	int n = 3 + int(h3 * 3.0);
	for (int k = 0; k < 5; k++) {
		if (k >= n) break;
		float hk = h2(ivec2(bb, 140 + k), SEED);
		float side = (k % 2 == 0) ? 1.0 : -1.0;
		float L = tw * 1.2 + 4.0 + hk * 12.0;
		float D = 3.0 + h2(ivec2(bb, 150 + k), SEED) * 10.0;
		vec2 a = vec2(side * tw * 0.3, 0.0), m = vec2(side * L * 0.55, -D * 0.25), e = vec2(side * L, -D);
		float th = 1.25 - hk * 0.35;
		if (segDist(q, a, m) < th || segDist(q, m, e) < th * 0.7) return mat;
	}
	return 0u;
}

uint floraId = 0u;   // which tree the cell flora() returned belongs to (aux bits 16-31, see react.comp)
// trees and other surface plants, evaluated per cell from hashed "buckets" along the surface arc
uint flora(vec2 p, float r, float th, int floraType, bool inWater, bool rootsOnly) {
	float arc = th * RS0;
	// One spacing grid for every kind of tree, and each tree takes its kind from the biome at its
	// own trunk, so a crown reaching over a biome border is still drawn whole (it used to switch
	// kind column by column there and get cut off). Density per kind: oaks, pines, cacti, willows,
	// charred trees, palms.
	float BW = 14.0;
	float nB = floor(TAU * RS0 / BW);
	float L = nB * BW;
	int b = int(floor(arc / BW));
	float spawnA = P.p[121].x;
	float nz = h2(ivec2(int(arc), int(r)), SEED + 5);
	// where crowns overlap, a cell goes to the tree whose trunk is nearest (and wood always wins),
	// so each tree stays one connected piece of its own (react.comp keeps trees apart by id)
	uint best = 0u;
	float bestScore = 1e9;
	uint bestId = 0u;
	for (int k = -3; k <= 3; k++) {
		int bb = int(mod(float(b + k), nB));
		float hb = h2(ivec2(bb, 77), SEED);
		float st = (float(bb) + 0.2 + 0.6 * h2(ivec2(bb, 78), SEED)) * BW;
		float da = arc - st; da -= floor(da / L + 0.5) * L;
		if (abs(da) > 40.0) continue;
		float tth = st / RS0;
		vec4 ta = surfA(tth), tb = surfB(tth);
		int ft = int(biomeB(int(ta.y)).w) >> 4;
		float dens = ft == 1 ? 0.62 : (ft == 2 ? 0.7 : (ft == 4 ? 0.32 : (ft == 5 ? 0.33 : (ft == 3 ? 0.22 : (ft == 6 ? 0.24 :
			(ft == 7 ? 0.62 : (ft == 8 ? 0.16 : (ft == 9 ? 0.42 : 0.0))))))));
		if (hb >= dens) continue;
		float sp = abs(tth - spawnA); sp = min(sp, TAU - sp);
		if (sp * RS0 < 30.0) continue;
		if (onSite(tth, 26.0)) continue;
		if (tb.y > ta.x + 0.5) continue; // trunk would be underwater
		float base = floor(ta.x);
		vec2 q = vec2(da, r - base);
		if (q.y > 112.0 || q.y < -18.0) continue;
		if (rootsOnly && q.y >= 0.0) continue;
		float hh = h2(ivec2(bb, 79), SEED), h3 = h2(ivec2(bb, 83), SEED), h4 = h2(ivec2(bb, 84), SEED);
		uint m = 0u;
		if (q.y < 0.0) {
			float rw = rootWidth(ft);
			if (rw > 0.0) m = treeRoots(q, rw, hh, h3, bb, M_ROOT);
		}
		else if (ft == 1) m = oakTree(q, hh, h3, h4, nz);
		else if (ft == 2) {
			vec4 A = biomeA(int(ta.y));
			bool snowy = uint(A.z) == M_SNOW || ((int(A.w) & 1) != 0 && ta.x > RS0 + 20.0);
			m = pineTree(q, hh, h3, snowy, bb);
		}
		else if (ft == 3) m = hb < 0.05 ? palmTree(q, hh, h3) : cactusTree(q, hh, h3, h4);
		else if (ft == 4) m = willowTree(q, hh, h3, bb, nz);
		else if (ft == 5) m = charredTree(q, hh, bb);
		else if (ft == 6) m = palmTree(q, hh, h3);
		else if (ft == 7) m = jungleTree(q, hh, h3, h4, bb, nz);
		else if (ft == 8) m = acaciaTree(q, hh, h4, bb, nz);
		else if (ft == 9) m = mushroomTree(q, hh, h3, h4);
		if (m != 0u) {
			// wood wins over leaves (each tree stays one piece), and a root gives way to every other part
			// of any tree (a root reaching under a downhill neighbour never cuts its branches or crown)
			float sc = abs(da) - ((m == M_WOOD || m == M_COAL || m == M_CACTUS || m == M_STALK) ? 1000.0 : 0.0) + (m == M_ROOT ? 2000.0 : 0.0);
			// where two mushroom caps overlap, the shorter one is in front: its whole cap shows and the
			// taller one's shows round it (nearest-trunk split them down a straight line, each its own colour)
			if (m == M_CAP) sc = 500.0 + (h3 < 0.15 ? 50.0 + floor(hh * 12.0) : 18.0 + floor(hh * 26.0)) * 4.0 + abs(da) * 0.01;
			if (sc < bestScore) { bestScore = sc; best = m; bestId = 0x8000u | uint(bb + 1); }
		}
	}
	if (best != 0u) { floraId = bestId; return best; }
	if (rootsOnly) return 0u;
	// undergrowth and small plants
	if (onSite(th, 1.0)) return 0u;
	int col = int(floor(arc));
	vec4 sa = surfA(th);
	float dy = r - floor(sa.x);
	if (dy < 0.0) return 0u;
	if (floraType == 1 || floraType == 2 || floraType == 4 || floraType == 7) {
		// bushes (and young pines in pine country); the jungle's are bigger and everywhere
		bool jng = floraType == 7;
		float bw2 = jng ? 11.0 : 9.0;
		int b2 = int(floor(arc / bw2));
		for (int k = -1; k <= 1; k++) {
			int bb = b2 + k;
			float hb = h2(ivec2(bb, 85), SEED);
			if (hb > (floraType == 4 ? 0.3 : (jng ? 0.75 : 0.5))) continue;
			float cx = (float(bb) + 0.5) * bw2;
			float dx = arc - cx;
			vec4 ba = surfA(cx / RS0);
			float by = r - floor(ba.x);
			if (floraType == 2) {
				float hs = 4.0 + floor(hb * 8.0);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 1.0 && by < hs && abs(dx) < (hs - by) * 0.4 + 0.5) return M_LEAF;
				if (by >= 0.0 && by < 1.0 && abs(dx) < 0.6) return M_WOOD;
			} else {
				float rx = jng ? 3.5 + hb * 7.0 : 2.5 + hb * 4.0, ry = jng ? 3.0 + hb * 5.0 : 2.0 + hb * 3.0;
				float e = (dx * dx) / (rx * rx) + (by - ry * 0.6) * (by - ry * 0.6) / (ry * ry);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 0.0 && e < 1.0 - nz * 0.25) return M_LEAF;
			}
			floraId = 0u;
		}
		// grass tufts
		float hr = h2(ivec2(col, 86), SEED);
		if (floraType != 2 && hr < 0.35 && dy < 1.0 + floor(hr * 9.0)) return M_LEAF;
	}
	if (floraType == 3) {
		// barrel cacti: squat ribbed domes
		float bw3 = 11.0;
		int b3 = int(floor(arc / bw3));
		for (int k = -1; k <= 1; k++) {
			int bb = b3 + k;
			float hb = h2(ivec2(bb, 88), SEED);
			if (hb > 0.2) continue;
			float cx = (float(bb) + 0.5) * bw3;
			float dx = arc - cx;
			float by = r - floor(surfA(cx / RS0).x);
			float rx = 2.2 + hb * 9.0, ry = rx * 1.15;
			if (by >= 0.0 && (dx * dx) / (rx * rx) + (by - ry * 0.75) * (by - ry * 0.75) / (ry * ry) < 1.0) {
				floraId = 0xC000u | uint(bb + 200000) % 16000u;
				return M_CACTUS;
			}
		}
	}
	if (floraType == 8) {
		// savanna: tall golden grass in clumps, with gaps between them
		float clump = vnoise(vec2(arc / 7.0, 0.0), SEED + 90);
		float hr = h2(ivec2(col, 89), SEED);
		float gh = clump > 0.35 ? 2.0 + floor(hr * 4.0 + clump * 7.0) : (hr < 0.3 ? 1.0 + floor(hr * 6.0) : 0.0);
		if (dy < gh) { floraId = 0u; return M_DRYGRASS; }
	}
	if (floraType == 9) {
		// the grove: small mushrooms between the giants, and glowing toadstools
		float bw4 = 7.0;
		int b4 = int(floor(arc / bw4));
		for (int k = -1; k <= 1; k++) {
			int bb = b4 + k;
			float hb = h2(ivec2(bb, 91), SEED);
			if (hb > 0.4) continue;
			float cx = (float(bb) + 0.5) * bw4;
			float dx = arc - cx;
			float by = r - floor(surfA(cx / RS0).x);
			float hs = 2.0 + floor(hb * 10.0);
			float rc = 2.0 + hb * 6.0;
			floraId = 0xC000u | uint(bb + 300000) % 16000u;
			if (by >= hs && by < hs + 3.0 && abs(dx) < rc * (1.0 - (by - hs) / 3.4)) return M_CAP;
			if (by >= 0.0 && by < hs && abs(dx) < 0.7 + hb) return M_STALK;
			floraId = 0u;
		}
	}
	if (floraType == 4) {
		float hr = h2(ivec2(col, 80), SEED);
		if (hr < 0.3 && dy < 3.0 + floor(hr * 20.0)) return M_LEAF;
	}
	if (floraType == 6 && inWater) {
		float hr = h2(ivec2(col, 81), SEED);
		if (hr < 0.2 && dy < 4.0 + floor(hr * 50.0)) return M_LEAF;
	}
	return 0u;
}

void main() {
	int s = pc.a.x;
	int x = int(gl_GlobalInvocationID.x);
	int y = pc.a.y + int(gl_GlobalInvocationID.y);
	if (x >= SH_N(s) || y >= pc.a.z || y >= SH_Y1(s)) return;
	if (y < 0) {                                     // the orbit band starts empty
		int oi = cellIdx(s, y, x);
		world.cells[oi] = 0u;
		aux.a[oi] = 0u;
		return;
	}
	SEED = int(P.p[0].w);
	vec2 p = cellCenter(s, y, x);
	float r = length(p);
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	int b = int(sa.y);
	// near a biome border, each cell picks one of the two biomes with ragged noise, so the layers
	// (topsoil, dirt, stone, underground biome) interfinger instead of meeting at a straight seam
	{
		float k = floor(sb.w);
		float bt = clamp((sb.w - k) / 0.9, 0.0, 1.0);
		int b0 = int(k) / 16, b1 = int(k) % 16;
		if (b0 != b1) {
			// three scales: broad lobes, fingers a few cells wide, and single-cell grains at the very
			// edge, so each side reaches into the other in pockets instead of one wavy line
			float rag = (fbm(p / 47.0, SEED + 62, 2) - 0.5) * 0.9 + (fbm(p / 10.0, SEED + 61, 2) - 0.5) * 2.2
				+ (fbm(p / 3.5, SEED + 63, 2) - 0.5) * 1.1 + (h2(ivec2(x, y), SEED + 64) - 0.5) * 0.18;
			b = (bt + rag) < 0.5 ? b0 : b1;
		}
	}
	float rs = sa.x;
	vec4 B = biomeB(b);
	int ug = int(B.w) & 15;
	// small plants follow the column's biome (trees take theirs from their own trunk, in flora()); near a
	// border each column picks one of the two by ragged noise, so grass, bushes and tufts mingle in clumps
	// instead of changing at one column
	int floraType = int(biomeB(int(sa.y)).w) >> 4;
	{
		float fk = floor(sb.w);
		int f0 = int(fk) / 16, f1 = int(fk) % 16;
		if (f0 != f1) {
			float fbt = clamp((sb.w - fk) / 0.9, 0.0, 1.0);
			float colA = th * RS0;
			float frag = (vnoise(vec2(colA / 13.0, 0.5), SEED + 65) - 0.5) * 1.5 + (vnoise(vec2(colA / 4.0, 0.5), SEED + 66) - 0.5) * 0.6
				+ (h2(ivec2(int(floor(colA)), 67), SEED) - 0.5) * 0.25;
			floraType = int(biomeB((fbt + frag) < 0.5 ? f0 : f1).w) >> 4;
		}
	}
	uint m = 0u;
	uint bgm = 0u;   // background decoration (no collisions)

	if (r < rs) {
		// tree roots in the background just under the surface (behind the earth until you dig)
		if (r > rs - 18.0) {
			floraId = 0u;
			uint rt = flora(p, r, th, floraType, false, true);
			if (rt != 0u) bgm = rt;
		}
		m = settleSafe(strata(p, r, th, sa, sb, b), p, r, th, rs);
		if (m != M_CORE && carvedAt(p, r, rs, sb.x)) {
			m = 0u;
			// liquid pools resting on cave floors
			float pn = fbm(p / 58.0, SEED + 30, 1);
			if (pn > 0.62) {
				float depth = 3.0 + floor(h2(ivec2(int(p.x / 13.0), int(p.y / 13.0)), SEED + 31) * 7.0);
				vec2 dn = -normalize(p);
				bool floor_ = false;
				for (int k = 1; k <= 9; k++) { if (float(k) > depth) break; if (solidAt(p + dn * float(k))) { floor_ = true; break; } }
				if (floor_) {
					float lavaMul = P.p[7].z;
					if (r > sa.z) m = ug == 2 ? M_ICE : M_WATER;
					else if (r > sa.w) m = (r < (sa.z + sa.w) * 0.5 && pn > 0.75 - 0.05 * lavaMul) ? M_LAVA : M_WATER;
					else m = pn > 0.66 - 0.03 * lavaMul ? M_LAVA : 0u;
				}
			}
			// cave plants and crystals growing from the floor (background layer)
			if (m == 0u && r < rs - 10.0) {
				vec2 dn = -normalize(p);
				for (int k = 1; k <= 7; k++) {
					if (solidAt(p + dn * float(k))) {
						float fr = floor(r - float(k));
						float hv = h2(ivec2(int(th * RS0), int(fr)), SEED + 40);
						float hgt = 0.0; uint mat = 0u;
						bool shallow = r > sa.z;
						if (ug == 0 && shallow && hv < 0.11) { mat = M_SHROOM; hgt = 2.0 + mod(floor(hv * 40.0), 4.0); }
						else if (ug == 1 && hv < 0.035) { mat = M_CRYSTAL; hgt = 2.0 + mod(floor(hv * 150.0), 6.0); }
						else if (ug == 2 && shallow && hv < 0.05) { mat = M_ICE; hgt = 2.0 + mod(floor(hv * 90.0), 4.0); }
						else if (ug == 3 && hv < 0.04) { mat = M_EMBER; hgt = 1.0 + mod(floor(hv * 90.0), 3.0); }
						else if (!shallow && r > sa.w && hv < 0.018) { mat = M_SHROOM; hgt = 2.0 + mod(floor(hv * 300.0), 3.0); }
						if (mat != 0u && float(k) <= hgt) { bgm = mat; floraId = 0u; }
						break;
					}
				}
			}
		}
	} else {
		// above ground: seas / ponds / lava lakes, then plants
		bool wet = sb.y > 0.0 && r < sb.y;
		if (wet) m = uint(sb.z);
		if (r < rs + 115.0) bgm = flora(p, r, th, floraType, wet, false);
	}

	// the mantle guardian's arena
	vec4 boss = P.p[120];
	if (boss.y > 0.0) {
		vec2 bd = vec2(cos(boss.x), sin(boss.x));
		vec2 q = p - bd * boss.y;
		float u = dot(q, vec2(-bd.y, bd.x)), v = dot(q, bd);
		float e = u * u / (boss.z * boss.z) + v * v / (boss.w * boss.w);
		if (e < 1.0) { m = 0u; bgm = 0u; }
		else if (e < 1.22 && v < 0.0) m = M_OBSIDIAN;
		else if (e < 1.22 && h2(ivec2(x, y), SEED + 50) < 0.12) m = M_EMBER;
	}

	uint v = hashu(uint(x) * 2654435761u ^ uint(y) * 40503u ^ uint(s) * 977u) & 255u;
	int ci = cellIdx(s, y, x);
	// untouched natural solids are anchored: part of the planet until something disturbs them
	world.cells[ci] = m | (v << 8) | (KIND[m] == K_SOLID ? ST_ANCHOR : 0u);
	aux.a[ci] = bgm | (bgm != 0u && floraId != 0u ? floraId << 16 : 0u);
}
