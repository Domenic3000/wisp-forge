// Planet generation. One thread per cell; runs once per planet in row bands.
// pc.a = (shell, rowStart, rowEnd, 0)
#include "common"
#include "world"
#include "params"
#include "surf_ro"
#include "bglayer"
// building sites (surface-shell column ranges) where no trees grow: s[0].x = count, s[1 + k] = (x0, x1, 0, 0)
layout(std430, set = 0, binding = 9) restrict readonly buffer Sites { vec4 s[]; } sites;
layout(local_size_x = 16, local_size_y = 16) in;

int SEED;
bool TV2;        // terrain 2 (P.p[26].x: Defs.terrain, the journey's): new journeys from 26 Nov
bool TV3;        // terrain 3 (27 Nov, new journeys: abyssal seas, ground far deeper, a cave layer per biome)

bool onSite(float th, float margin) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(NS);
	float N0 = float(NS);
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start, 0..N0
		if (d0 < q.y - q.x + margin || d0 > N0 - margin) return true;
	}
	return false;
}

vec4 biomeA(int b) { return P.p[8 + 2 * b]; }   // off, amp, topMat, flags
vec4 biomeB(int b) { return P.p[9 + 2 * b]; }   // subMat, topD, subD, ug + flora*16

// how many surface columns from the nearest building site (0 inside one)
float siteDist(float th) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(NS);
	float N0 = float(NS);
	float best = 1e6;
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start
		float len = q.y - q.x;
		float dist = d0 <= len ? 0.0 : min(d0 - len, N0 - d0);
		best = min(best, dist);
	}
	return best;
}

// Caves: winding tunnels (a thin band of one noise field) and caverns (high values of another).
// How much cave there is fades smoothly, never stopping at a hard line: toward the surface
// (except at cave mouths) and toward building sites (so foundations don't hang over a hole),
// the tunnels narrow to rounded tips and the caverns shrink, instead of ending in flat walls.
// Terrain 2's caves (user, 26 Nov: "i think we should make the cave shapes more realistic"): tunnels whose course
// is bent by a second noise (no straight runs), widening into halls and pinching into squeezes; a sparser second set
// crossing them (junctions and loops); and caverns wider than they are tall (the radial axis stretched), their size
// growing with depth. `k` fades them toward the surface and building sites as before.
bool caves2(vec2 p, float r, float d, float k, float df) {
	vec2 w = vec2(fbm(p / 70.0, SEED + 40, 2), fbm(p / 70.0 + vec2(31.7, 11.3), SEED + 41, 2)) - 0.5;
	vec2 pw = p + w * 46.0;
	float width = 0.65 + 0.95 * fbm(p / 130.0, SEED + 42, 2);
	float n1 = fbm(pw / 95.0, SEED + 10, 2);
	if (abs(n1 - 0.5) < (0.02 + 0.016 * df) * k * width) return true;
	if (d > 40.0) {
		float n1c = fbm(pw / 150.0 + vec2(17.0, 5.0), SEED + 14, 2);
		if (abs(n1c - 0.5) < 0.008 * k * width) return true;
	}
	// (caverns are measured from the mean surface, not the peak over them: a mountain stays solid rock)
	float dc = min(d, RS0 + 30.0 + (fbm(p / 60.0, SEED + 43, 2) - 0.5) * 60.0 - r);
	if (dc > 24.0) {
		vec2 up = p / max(r, 1.0);
		vec2 q = up * (RS0 + (r - RS0) * 1.8) + w * 30.0;        // (squashed up and down: wide, low caverns)
		float n2 = fbm(q / 165.0, SEED + 12, 3);
		if (n2 > 0.685 - 0.06 * df + (1.0 - k) * 0.3 + (1.0 - smoothstep(24.0, 44.0, dc)) * 0.1) return true;
	}
	return false;
}

bool carvedAt(vec2 p, float r, float rs, float coreR) {
	float d = rs - r;
	if (d < 2.0 || r <= coreR + 3.0) return false;
	float th = angleOf(p);
	float entr = fbm(normalize(p) * RS0 / 34.0, SEED + 11, 1);
	float wob = (fbm(p / 23.0, SEED + 13, 2) - 0.5) * 14.0;
	float ks = entr >= 0.72 ? 1.0 : smoothstep(6.0, 22.0, d + wob);
	float kt = d > 75.0 ? 1.0 : max(smoothstep(4.0, 34.0, siteDist(th) + wob), smoothstep(40.0, 75.0, d + wob));
	float k = ks * kt;
	if (k < 0.02) return false;
	float df = clamp(d / max(rs - coreR, 1.0), 0.0, 1.0);
	if (TV2) return caves2(p, r, d, k, df);
	// tunnels and caverns sized for the 24-cell-tall mage: roomy enough to jump and fight in
	float n1 = fbm(p / 90.0, SEED + 10, 2);
	if (abs(n1 - 0.5) < (0.022 + 0.016 * df) * k) return true;
	if (d > 24.0) {
		float n2 = fbm(p / 160.0, SEED + 12, 2);
		if (n2 > 0.675 - 0.07 * df + (1.0 - k) * 0.3 + (1.0 - smoothstep(24.0, 40.0, d)) * 0.1) return true;
	}
	return false;
}

// is the base terrain (strata minus caves) solid at p?
bool solidAt(vec2 p) {
	float r = length(p);
	if (r < R_IN) return true;
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	if (r >= sa.x) return false;
	return !carvedAt(p, r, sa.x, sb.x);
}

// Terrain 2: stalactites hanging from cave ceilings and stalagmites rising from the floors, cones tapering to points
// (a few columns in every eleven, each its own length, keyed by the ceiling or floor it grows from so it stays
// whole; never one that would reach the floor or ceiling across from it: no pillars)
bool caveSpike(vec2 p, float r, float th, float rs) {
	if (rs - r < 30.0) return false;
	float arcC = th * RS0;
	float ci = floor(arcC / 11.0);
	float cx = (ci + 0.3 + 0.4 * h2(ivec2(int(ci), 71), SEED)) * 11.0;
	float da = abs(arcC - cx);
	if (da > 4.5) return false;
	vec2 up = p / max(r, 1.0);
	for (int k = 1; k <= 12; k++) {
		if (solidAt(p + up * float(k))) {
			float hv = h2(ivec2(int(ci), int((r + float(k)) / 12.0)), SEED + 70);
			if (hv > 0.3) return false;
			float L = 4.0 + hv * 30.0;
			if (float(k) > L || solidAt(p - up * 10.0)) return false;
			return da < (1.5 + L * 0.2) * (1.0 - float(k) / L);          // hanging from the ceiling
		}
	}
	for (int k2 = 1; k2 <= 7; k2++) {
		if (solidAt(p - up * float(k2))) {
			float hv2 = h2(ivec2(int(ci), int((r - float(k2)) / 12.0)), SEED + 72);
			if (hv2 > 0.25) return false;
			float Lf = 3.0 + hv2 * 16.0;
			if (float(k2) > Lf || solidAt(p + up * 14.0)) return false;
			return da < (1.5 + Lf * 0.25) * (1.0 - float(k2) / Lf);       // rising from the floor
		}
	}
	return false;
}

// Loose powders (sand, gravel, snow, ash) are only generated where they can rest. Where one
// would sit over a cave, on a steep slope, or around a building site (whose yard is dug out of
// the hillside), it is generated as the solid it packs into instead, so nothing pours down the
// moment you arrive.
uint packedSolid(uint m) {
	if (m == M_SAND) return M_SANDSTONE;
	if (m == M_SNOW) return M_ICE;
	return M_STONE;   // gravel, ash
}
uint settleSafe(uint m, vec2 p, float r, float th, float rs) {
	if (KIND[m] != K_POWDER) return m;
	vec2 dn = -p / r;
	vec2 sd = vec2(-dn.y, dn.x);
	if (!solidAt(p + dn) || !solidAt(p + dn + sd) || !solidAt(p + dn - sd)) return packedSolid(m);   // over or beside a cave
	float d = rs - r;
	if (d < 14.0) {
		float stp = 1.0 / RS0;
		float sl = max(abs(surfA(th - 2.0 * stp).x - rs), abs(surfA(th + 2.0 * stp).x - rs)) * 0.5;
		if (sl > 0.85) return packedSolid(m);                          // a steep face
		// around a building's yard; how deep and how far out the packed ground reaches wanders, so
		// it has no flat bottom or straight ends
		float wob = fbm(p / 7.0, SEED + 93, 2);
		if (d < 8.0 + 9.0 * wob && onSite(th, 6.0 + 14.0 * wob)) return packedSolid(m);
	}
	return m;
}

// A liquid ground layer (the bog's or jungle's mud) is only liquid in a bog: a hollow the ground
// rises around on both sides, or the floor under standing water, away from building sites and with
// solid ground under and beside it. Returns how deep the bog is at this column (0 = no bog), with
// a wobbling edge so bogs are lenses, not boxes. Everywhere else the layer is packed earth you can
// walk on, so a slope of "ground" is never a hidden pool you sink into.
float bogDepth(vec2 p, float r, float th, float rs, vec4 sb, float amp) {
	if (onSite(th, 10.0)) return 0.0;
	float stp = 3.0 / RS0;
	float rimL = rs, rimR = rs;
	for (int k = 1; k <= 16; k++) {
		rimL = max(rimL, surfA(mod(th - stp * float(k), TAU)).x);
		rimR = max(rimR, surfA(mod(th + stp * float(k), TAU)).x);
	}
	float lvl = min(rimL, rimR) - 1.0;
	// (terrain 2's rougher ground has many small dips: only a deeper hollow is a bog, more so on hilly ground,
	// so the jungle stays about as firm as before while the flat marsh keeps its bogs)
	if (TV2) lvl -= 1.0 * clamp((amp - 3.0) / 13.0, 0.0, 1.0);
	if (sb.y > 0.0) lvl = max(lvl, sb.y);   // under a pond or lake
	float wob = fbm(p / 9.0, SEED + 95, 2);
	float bog = clamp((lvl - rs) * 0.7 + (wob - 0.5) * 3.0, 0.0, 6.0);
	float d = rs - r;
	if (d >= bog) return bog;
	vec2 dn = -p / r;
	vec2 sd = vec2(-dn.y, dn.x);
	vec2 bot = p + dn * (bog - d + 1.0);
	if (!solidAt(bot) || !solidAt(p + sd * 2.0) || !solidAt(p - sd * 2.0)) return 0.0;   // it would drain into a cave
	return bog;
}

const float ORE_T = 0.025;          // how much rarer the common ores are than at first (25 Nov)
float oreN(vec2 p, int k) { return fbm(p / 9.0 + vec2(float(k) * 17.3, float(k) * 9.1), SEED + 20 + k, 2); }

// Terrain 3 (27 Nov; user: "we need developed cave systems with underground foliage and creatures living there",
// chose "a cave layer per biome"): under each biome's ground its own underground, in its stone (`ug`, the biome's
// "under": Glowroot Caverns, Prism Hollows, Frostvein Grottos, Smoldering Vaults). The rock itself takes the
// layer's look, so every cave wall in it does: moss-grown stone and root-soil, banded sandstone, lenses of ice,
// magma rock and obsidian streaks. Its plants (floors and ceilings) are in main.
uint caveLayerRock(vec2 p, float r, float d, int ug) {
	float n1 = fbm(p / 17.0, SEED + 34, 2);
	float n2 = fbm(p / 6.0, SEED + 35, 2);
	if (ug == 0) {
		if (n1 > 0.6) return M_MOSSBLOCK;
		if (n2 > 0.74 && d < 260.0) return M_DIRT;
	} else if (ug == 1) {
		float band = fract(r / 11.0 + n1 * 1.6);
		if (band < 0.38) return M_SANDSTONE;
	} else if (ug == 2) {
		if (n1 > 0.64) return M_ICE;
		if (n2 > 0.8) return M_SNOW;
	} else if (ug == 3) {
		if (n1 > 0.62) return M_MAGMAROCK;
		if (n2 > 0.82) return M_OBSIDIAN;
	}
	return M_STONE;
}

uint strata(vec2 p, float r, float th, vec4 sa, vec4 sb, int b) {
	float rs = sa.x, deepR = sa.z, magmaR = sa.w, coreR = sb.x;
	vec4 A = biomeA(b), B = biomeB(b);
	int flags = int(A.w);
	int ug = int(B.w) & 15;
	float d = rs - r;
	float subD = B.z + floor(h2(ivec2(int(th * RS0), 3), SEED) * 6.0);
	float topD = B.y;
	bool snowy = (flags & 1) != 0 && rs > RS0 + 48.0;
	bool intoStone = false;
	if (TV2) {
		// terrain 2 (user, 26 Nov: "the top layer of a planet is a bit too thin. i want to really feel the ambiance of
		// each biome"): the biome's own ground runs three times as deep, its loose tops (sand, snow, ash, mud) thicker,
		// its lower part giving way to stone in lobes instead of a line; on a steep slope the soil thins to bare rock
		if (topD >= 2.0) topD = TV3 ? topD * 3.0 + 2.0 : topD * 1.6 + 1.0;
		// (terrain 3, 27 Nov; user: "they feel a bit shallow still i can dig away the entire surface very easily":
		// the biome's own ground runs about six times its first depth, 70-110 cells under most biomes)
		if (B.z > 0.5) subD = (TV3 ? B.z * 6.0 + 20.0 : B.z * 2.6 + 6.0) + (fbm(vec2(th * RS0 / 40.0, 0.5), SEED + 31, 2) - 0.5) * (TV3 ? 26.0 : 14.0);
		float dl = 3.0 / RS0;
		float slope = abs(surfA(mod(th + dl, TAU)).x - surfA(mod(th - dl + TAU, TAU)).x) / 6.0;
		float steep = smoothstep(0.9, 1.9, slope);
		topD *= 1.0 - steep;
		subD *= 1.0 - 0.85 * steep;
		float lob = fbm(p / 13.0, SEED + 32, 2);
		intoStone = d > topD + subD * 0.6 && lob > 0.5 + 0.5 * (1.0 - (d - topD - subD * 0.6) / max(subD * 0.4, 1.0));
	}
	uint m;
	if (snowy && d < 3.0) m = M_SNOW;
	else if (d < topD) m = uint(A.z);
	else if (d < topD + subD && !intoStone) m = uint(B.x);
	else if (r > deepR) m = M_STONE;
	else if (r > magmaR) m = M_DEEPSTONE;
	else if (r > coreR) m = M_MAGMAROCK;
	else return M_CORE;
	// (terrain 3: deep under a sandy biome the sand has packed into sandstone, so a tunnel through it doesn't
	// bring down a hundred cells of it; and the deep soil has its own stones, gravel and a little copper and coal,
	// so the first ore isn't a hundred cells down)
	if (TV3 && d < topD + subD && d > topD + 6.0 && m == uint(B.x)) {
		if (m == M_SAND && d > topD + B.z * 2.6 + 6.0) m = M_SANDSTONE;
		if (KIND[m] == K_SOLID || m == M_SANDSTONE) {
			float rich3 = (P.p[7].w - 1.0) * 0.03;
			if (oreN(p, 0) > 0.85 + ORE_T - rich3) return M_COPPER;
			if (oreN(p, 1) > 0.85 + ORE_T - rich3) return M_COAL;
			float bo = fbm(p / 8.0, SEED + 33, 2);
			if (bo > 0.74) return M_STONE;                                // boulders in the soil
			if (bo < 0.2 && d > topD + 14.0) return M_GRAVEL;
		}
	}
	// mud: liquid in bogs, packed earth (grass on top) elsewhere
	if (d < topD + subD) {
		uint liq = KIND[uint(A.z)] == K_LIQUID ? uint(A.z) : (KIND[uint(B.x)] == K_LIQUID ? uint(B.x) : 0u);
		if (liq != 0u) {
			if (d < bogDepth(p, r, th, rs, sb, A.y)) return liq;
			if (KIND[m] == K_LIQUID) m = d < 1.0 ? M_GRASS : M_DIRT;
		}
	}

	// the planet kind's own ore (Defs.KIND_ORES): P.p[126] = (material, three of the ground kinds it forms
	// in), P.p[127] = (depth from, depth to, threshold, the fourth ground kind + 1000 if only in the seabed)
	vec4 ko = P.p[126], kd = P.p[127];
	if (ko.x > 0.5 && d >= kd.x && d < kd.y) {
		float h4 = mod(kd.w, 1000.0);
		bool host = m == uint(ko.y + 0.5) || m == uint(ko.z + 0.5) || m == uint(ko.w + 0.5) || m == uint(h4 + 0.5);
		bool bed = kd.w < 999.5 || (P.p[7].y > 0.0 && rs < RS0 - P.p[7].y - 30.0);
		if (host && bed && oreN(p * 0.8, 10) > kd.z - (P.p[7].w - 1.0) * 0.02) return uint(ko.x + 0.5);
	}

	// ores and pockets
	float rich = (P.p[7].w - 1.0) * 0.03;
	// (ores a little rarer: user, 21 Nov; then about half as many veins again, 25 Nov: "ore is much too abundant
	// ... i dont want it to be super hard to find but currently it is everywhere": ORE_T raises every threshold)
	if (m == M_STONE) {
		if (oreN(p, 0) > 0.832 + ORE_T - rich) return M_COPPER;
		if (oreN(p, 1) > 0.83 + ORE_T - rich) return M_COAL;
		if (ug == 1 && oreN(p, 2) > 0.805 + ORE_T - rich) return M_CRYSTAL;      // (prism crystal: rarer, for draughts and the focus)
		if (ug == 2 && d < 200.0 && oreN(p, 3) > 0.775 + ORE_T - rich) return M_FROST;
		if (ug == 3 && d < 160.0 && oreN(p, 4) > 0.785 + ORE_T - rich) return M_EMBER;
		if (oreN(p, 6) > 0.82) return M_GRAVEL;
		if (d < 100.0 && oreN(p, 7) > 0.82) return M_DIRT;
		if (TV3) return caveLayerRock(p, r, d, ug);
	} else if (m == M_DEEPSTONE) {
		float dd = (deepR - r) / max(deepR - magmaR, 1.0);
		if (dd > 0.4 && oreN(p, 4) > 0.835 + ORE_T - rich) return M_EMBER;
		if (oreN(p, 5) > 0.835 + ORE_T - rich) return M_WISP;
		if (oreN(p, 2) > 0.875 + ORE_T - rich) return M_CRYSTAL;
		if (oreN(p, 3) > 0.86 + ORE_T - rich) return M_FROST;
	} else if (m == M_MAGMAROCK) {
		if (oreN(p, 4) > 0.815 + ORE_T - rich) return M_EMBER;
		if (oreN(p, 8) > 0.79) return M_OBSIDIAN;
		if (oreN(p, 9) > 0.78) return M_DEEPSTONE;
	}
	return m;
}

// ---- trees: one kind per biome, sized for the 17-cell mage -----------------------------
// Each tree is evaluated per cell. q = (da, dy) is the offset from the tree's base: da along
// the surface, dy up. hh, h3 and h4 are the tree's own random numbers.
float segDist(vec2 q, vec2 a, vec2 b) {
	vec2 pa = q - a, ba = b - a;
	float t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * t);
}

// (user, 26 Nov: on a big tree "the trunk and branches end too abruptly for how thick they are"): a trunk from the
// ground up to `top`, half as wide as hw at its foot narrowing to hw * k, its top rounded off; a limb from a to b
// thick r0 at a narrowing to r1 at b (its end round); a bough's tip splitting into two twigs
bool trunkIn(vec2 q, float top, float hw, float k) {
	if (q.y < 0.0 || q.y > top) return false;
	float w = hw * mix(1.0, k, smoothstep(0.35, 1.0, q.y / top));
	if (q.y > top - w) return length(vec2(q.x, q.y - (top - w))) < w;
	return abs(q.x) < w;
}
bool limbIn(vec2 q, vec2 a, vec2 b, float r0, float r1) {
	vec2 pa = q - a, ba = b - a;
	float t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * t) < mix(r0, r1, t);
}
vec2 turned(vec2 v, float a) { float c = cos(a), s = sin(a); return vec2(v.x * c - v.y * s, v.x * s + v.y * c); }
bool twigsIn(vec2 q, vec2 a, vec2 b, float L, float r0) {
	vec2 d = normalize(b - a) * L;
	return limbIn(q, b, b + turned(d, 0.55), r0, 0.45) || limbIn(q, b, b + turned(d, -0.45) * 0.8, r0 * 0.9, 0.45);
}

// broad oak: a flared trunk, two branches and a lumpy crown of overlapping blobs; some are giants
uint oakTree(vec2 q, float hh, float h3, float h4, float nz) {
	bool giant = h3 < 0.12;
	float h = giant ? 58.0 + floor(hh * 14.0) : 30.0 + floor(hh * 24.0);
	float tw = giant ? 5.0 : (h > 42.0 ? 4.0 : 3.0);
	float R = 9.0 + h * 0.16;
	float da = q.x, dy = q.y;
	if (dy >= 0.0 && dy < 3.0 && abs(da) < tw * 0.5 + (3.0 - dy) * 0.7) return M_WOOD;      // (its foot, flared)
	if (trunkIn(q, h - R * 0.3, tw * 0.5, 0.6)) return M_WOOD;
	float side = h4 < 0.5 ? 1.0 : -1.0;
	vec2 b1a = vec2(0.0, h * 0.5), b1b = vec2(side * R * 0.55, h - R * 0.35);
	if (limbIn(q, b1a, b1b, giant ? 1.7 : 1.1, 0.6)) return M_WOOD;
	if (giant && twigsIn(q, b1a, b1b, 4.0, 0.7)) return M_WOOD;
	if (limbIn(q, vec2(0.0, h * 0.62), vec2(-side * R * 0.5, h - R * 0.2), giant ? 1.3 : 0.95, 0.55)) return M_WOOD;
	float rag = 1.0 - nz * 0.28;
	vec2 c0 = vec2(0.0, h), c1 = vec2(-R * 0.55, h - R * 0.3), c2 = vec2(R * 0.55, h - R * 0.25), c3 = vec2(R * 0.2 * side, h + R * 0.35);
	float e = min(min(length((q - c0) / vec2(R, R * 0.8)), length((q - c1) / vec2(R * 0.62, R * 0.5))),
	              min(length((q - c2) / vec2(R * 0.62, R * 0.52)), length((q - c3) / vec2(R * 0.6, R * 0.45))));
	if (e < rag) return M_LEAF;
	return 0u;
}

// pine: a straight trunk under tiers of needles that sweep down towards their tips, each tier
// wide at the bottom with a ragged edge; snow lies along the top of every tier. Some are giants.
bool pineIn(float x, float y, float dy0, float P, float top, float k, int bb) {
	float ax = abs(x);
	float yy = y + ax * 0.32;
	if (yy < dy0 || y > top) return false;
	float f = fract((yy - dy0) / P);
	float env = (top - yy) * k + 1.0;
	float w = env * (0.3 + 0.7 * pow(1.0 - f, 1.6));
	w += (h2(ivec2(int(floor(yy)), bb * 3 + (x > 0.0 ? 1 : 0)), SEED + 9) - 0.5) * 1.4 * min(1.0, env * 0.15);
	return ax < w;
}
uint pineTree(vec2 q, float hh, float h3, bool snowy, int bb) {
	bool giant = h3 < 0.14;
	float h = giant ? 70.0 + floor(hh * 24.0) : 30.0 + floor(hh * 34.0);
	float tw = h > 70.0 ? 4.0 : (h > 45.0 ? 3.0 : 2.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float dy0 = 4.0 + h * 0.09, P = 6.0 + h * 0.07, top = h + 3.0, k = giant ? 0.31 : 0.28;
	if (pineIn(da, dy, dy0, P, top, k, bb)) {
		if (snowy && !pineIn(da, dy + 1.0, dy0, P, top, k, bb)) return M_SNOW;
		if (snowy && abs(da) > 1.0 && !pineIn(da, dy + 2.0, dy0, P, top, k, bb) && h2(ivec2(int(dy * 7.0 + da * 3.0), bb), SEED + 12) < 0.45) return M_SNOW;
		return M_LEAF;
	}
	float hw = tw * 0.5 + max(0.0, 2.0 - dy) * 0.8;
	if (dy < h - 6.0 && abs(da) < hw) return M_WOOD;
	return 0u;
}

// saguaro: a thick ribbed column with a rounded crown, and one to three arms that elbow out and
// turn up (each with its own height, reach and length), sized against the 24-cell mage
uint cactusTree(vec2 q, float hh, float h3, float h4) {
	float h = 22.0 + floor(hh * 24.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float tw = h > 34.0 ? 2.6 : 2.1;
	if (dy < h - tw && abs(da) < tw) return M_CACTUS;
	if (dy >= h - tw && length(vec2(da, dy - (h - tw))) < tw) return M_CACTUS;
	int arms = 1 + int(h3 * 2.99);
	for (int k = 0; k < 3; k++) {
		if (k >= arms) break;
		float hk = fract(h4 * 7.13 + float(k) * 0.37);
		float side = ((k % 2 == 0) == (h4 < 0.5)) ? 1.0 : -1.0;
		float ay = floor(h * (0.3 + 0.16 * hk + 0.12 * float(k)));
		float ax = tw + 2.0 + floor(hk * 3.0);
		float up = floor(h * (0.2 + 0.18 * hk));
		float aw = 1.5;
		float x = da * side;
		if (x > 0.0 && x < ax && abs(dy - ay - aw) < aw) return M_CACTUS;                 // out
		if (length(vec2(x, dy) - vec2(ax, ay + aw)) < aw + 0.4) return M_CACTUS;          // the elbow
		if (abs(x - ax) < aw && dy > ay + aw && dy < ay + aw + up) return M_CACTUS;        // up
		if (length(vec2(x - ax, dy - (ay + aw + up))) < aw) return M_CACTUS;              // its tip
	}
	return 0u;
}

// palm: a leaning, curving trunk with drooping fronds
uint palmTree(vec2 q, float hh, float h3) {
	float h = 28.0 + floor(hh * 18.0);
	float lean = (h3 < 0.5 ? 1.0 : -1.0) * (3.0 + h3 * 6.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h) {
		float t = dy / h;
		if (abs(da - lean * t * t) < 1.4 - t * 0.4) return M_WOOD;
	}
	vec2 top = vec2(lean, h);
	if (length(q - top - vec2(0.0, 1.0)) < 2.6) return M_LEAF;
	for (int k = 0; k < 4; k++) {
		float fk = float(k);
		float L = 10.0 + fk * 3.2;
		for (int sd = -1; sd <= 1; sd += 2) {
			float x = (da - lean) * float(sd);
			if (x < 0.0 || x > L) continue;
			float yf = h + 2.0 + fk * 0.9 - 0.055 * (1.0 + 0.45 * fk) * x * x;
			if (abs(dy - yf) < 0.9 + (1.0 - x / L) * 0.6) return M_LEAF;
		}
	}
	return 0u;
}

// willow: a thick trunk, a low dome of leaves and long strands hanging from it
uint willowTree(vec2 q, float hh, float h3, int bb, float nz) {
	float h = 30.0 + floor(hh * 20.0);
	float R = 13.0 + h3 * 7.0;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < 2.0 + max(0.0, 3.0 - dy) * 0.7) return M_WOOD;
	float e = length((q - vec2(0.0, h)) / vec2(R, R * 0.55));
	if (dy >= h - 2.0 && e < 1.0 - nz * 0.2) return M_LEAF;
	if (abs(da) < R * 0.95 && dy < h - 1.0) {
		int ci = int(floor(da + 200.0));
		float hs = h2(ivec2(bb * 7 + ci, 91), SEED);
		float Ls = R * 0.5 + h2(ivec2(bb * 7 + ci, 92), SEED) * R * 0.9;
		if (hs < 0.55 && dy > max(2.0, h - 1.0 - Ls)) return M_LEAF;
	}
	return 0u;
}

// a mangrove (flora 14): a slim trunk standing on arched stilt roots over the mud and black water, a broad flat
// crown, and moss hanging from it in strands
uint mangroveTree(vec2 q, float hh, float h3, int bb, float nz) {
	float h = 18.0 + floor(hh * 14.0);
	float R = 9.0 + h3 * 6.0;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy > 6.0 && dy < h && abs(da) < 1.3) return M_WOOD;
	// stilt roots: arching from the trunk (8 up) down to the ground, three or four each side
	int nr = 3 + int(hh * 2.0);
	for (int k = 0; k < 4; k++) {
		if (k >= nr) break;
		for (int sd = -1; sd <= 1; sd += 2) {
			float xk = float(sd) * (2.5 + float(k) * (1.6 + h3));
			float t = da / xk;
			if (t < 0.0 || t > 1.0) continue;
			float yr = (8.0 - float(k) * 0.6) * (1.0 - t * t);
			if (abs(dy - yr) < 0.75) return M_WOOD;
		}
	}
	float e = length((q - vec2(0.0, h + 2.0)) / vec2(R, R * 0.42));
	if (e < 1.0 - nz * 0.18) return M_LEAF;
	// hanging moss
	if (abs(da) < R * 0.9) {
		int ci = int(floor(da + 200.0));
		float hs = h2(ivec2(bb * 7 + ci, 95), SEED);
		float Ls = 2.0 + h2(ivec2(bb * 7 + ci, 96), SEED) * 7.0;
		float bot = h + 2.0 - R * 0.42 * sqrt(max(0.0, 1.0 - da * da / (R * R)));
		if (hs < 0.3 && dy < bot && dy > bot - Ls) return M_LEAF;
	}
	return 0u;
}

// an elder tree (flora 16): a great trunk flaring at its foot, a few heavy boughs, and a crown of overlapping
// masses as wide as it is tall (kept within the tree grid's reach: 34 either side)
uint elderTree(vec2 q, float hh, float h3, float h4, int bb, float nz) {
	float h = 54.0 + floor(hh * 30.0);
	float tw = 3.2 + h3 * 1.6;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	// the trunk, flaring into buttress roots at its foot, narrowing and rounding off up in the crown
	if (dy < 9.0 && abs(da) < tw + (9.0 - dy) * 0.7) return M_WOOD;
	if (trunkIn(q, h - 10.0, tw, 0.5)) return M_WOOD;
	// the crown: one great mass over the top and five more round it, low and wide, overlapping
	vec2 top = vec2((h4 - 0.5) * 6.0, h - 2.0);
	float e0 = length((q - top) / vec2(18.0 + h3 * 6.0, 11.0 + hh * 3.0));
	if (e0 < 1.0 - nz * 0.2) return M_LEAF;
	for (int k = 0; k < 5; k++) {
		float hk = h2(ivec2(bb, 150 + k), SEED);
		float sd = (k % 2 == 0) ? 1.0 : -1.0;
		if (hk < 0.25) sd = -sd;
		float rr = 10.0 + h2(ivec2(bb, 160 + k), SEED) * 5.0;
		vec2 c = vec2(sd * (8.0 + hk * 14.0), h * (0.58 + 0.07 * float(k)) + hk * 5.0);
		if (abs(c.x) + rr > 34.0) c.x = sign(c.x) * (34.0 - rr);
		// the bough out to it, heavy at the trunk and tapering, its end splitting into twigs
		vec2 ba0 = vec2(0.0, c.y - 10.0), bb0 = c - vec2(sd * 3.0, 2.0);
		if (limbIn(q, ba0, bb0, 1.8 + hk * 0.7, 0.8)) return M_WOOD;
		if (twigsIn(q, ba0, bb0, 4.0 + hk * 3.0, 0.8)) return M_WOOD;
		float e = length((q - c) / vec2(rr, rr * 0.7));
		if (e < 1.0 - nz * 0.22) return M_LEAF;
	}
	return 0u;
}

// charred tree: a burnt black trunk with bare, jagged branches
uint charredTree(vec2 q, float hh, int bb) {
	float h = 26.0 + floor(hh * 26.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < (h > 30.0 ? 1.5 : 1.0) + max(0.0, 2.0 - dy) * 0.5) return M_COAL;
	for (int k = 0; k < 4; k++) {
		float hk = h2(ivec2(bb, 90 + k), SEED);
		float y0 = h * (0.35 + 0.15 * float(k));
		float sd = (k % 2 == 0) ? 1.0 : -1.0;
		if (hk < 0.3) sd = -sd;
		float L = 5.0 + hk * 8.0;
		vec2 a = vec2(0.0, y0), b = vec2(sd * L * 0.8, y0 + L * 0.7);
		if (segDist(q, a, b) < 0.7) return M_COAL;
		if (segDist(q, b, b + vec2(sd * 2.5, 3.5 - hk * 3.0)) < 0.6) return M_COAL;
	}
	return 0u;
}

// jungle giant: a tall trunk flaring into buttress roots, a wide flat canopy of overlapping
// layers, a lower side branch with its own small canopy, and vines hanging from the canopy
uint jungleTree(vec2 q, float hh, float h3, float h4, int bb, float nz) {
	bool giant = h3 < 0.15;
	float h = 52.0 + floor(hh * 30.0) + (giant ? 12.0 : 0.0);
	float tw = h > 70.0 ? 6.0 : 5.0;
	float R = 14.0 + h * 0.12;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < 8.0 && abs(da) < tw * 0.5 + pow(8.0 - dy, 1.6) * 0.32) return M_WOOD;
	if (trunkIn(q, h - 4.0, tw * 0.5, 0.55)) return M_WOOD;
	float side = h4 < 0.5 ? 1.0 : -1.0;
	float by = h * 0.55, bx = side * R * 0.75;
	vec2 jb = vec2(bx, by + R * 0.25);
	if (limbIn(q, vec2(0.0, by), jb, 1.7, 0.7) || twigsIn(q, vec2(0.0, by), jb, 4.0, 0.7)) return M_WOOD;
	if (limbIn(q, vec2(0.0, h - 6.0), vec2(-side * R * 0.5, h - 1.0), 1.4, 0.6)) return M_WOOD;
	if (limbIn(q, vec2(0.0, h - 5.0), vec2(side * R * 0.45, h), 1.3, 0.55)) return M_WOOD;
	float rag = 1.0 - nz * 0.25;
	float e = min(min(length((q - vec2(0.0, h + 2.0)) / vec2(R, R * 0.38)), length((q - vec2(-R * 0.62, h - 1.0)) / vec2(R * 0.58, R * 0.3))),
	              min(length((q - vec2(R * 0.62, h)) / vec2(R * 0.6, R * 0.32)), length((q - vec2(R * 0.15 * side, h + R * 0.3)) / vec2(R * 0.55, R * 0.28))));
	if (e < rag) return M_LEAF;
	if (length((q - vec2(bx, by + R * 0.3)) / vec2(R * 0.42, R * 0.2)) < rag) return M_LEAF;
	// vines: some columns under the canopy hang a strand down from its underside
	int vc = int(floor(da)) + bb * 97;
	if (abs(da) < R * 0.85 && h2(ivec2(vc, 31), SEED + 7) < 0.28) {
		float bot = h + 2.0 - R * 0.38 * sqrt(max(0.0, 1.0 - (da / R) * (da / R)));
		float ln = 5.0 + floor(h2(ivec2(vc, 32), SEED + 7) * 11.0);
		if (dy < bot && dy > bot - ln) return M_LEAF;
	}
	return 0u;
}

// acacia: a leaning trunk that forks into two limbs under a flat-bottomed umbrella crown (two pads)
uint acaciaTree(vec2 q, float hh, float h4, int bb, float nz) {
	float h = 26.0 + floor(hh * 16.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float lean = (h4 - 0.5) * 0.5;
	float fy = h * 0.5;
	float R = 13.0 + hh * 9.0;
	float x = da - lean * min(dy, fy);
	if (dy < fy && abs(x) < 1.6 + max(0.0, 2.0 - dy) * 0.7) return M_WOOD;
	float tx = lean * fy;
	if (segDist(q, vec2(tx, fy), vec2(tx - R * 0.42, h - 2.0)) < 1.1) return M_WOOD;
	if (segDist(q, vec2(tx, fy), vec2(tx + R * 0.42, h - 2.0)) < 1.1) return M_WOOD;
	float ry = 5.0 + hh * 3.0;
	float rag = 1.0 - nz * 0.3;
	if (dy > h - 4.5 && length((q - vec2(tx, h - 3.0)) / vec2(R, ry)) < rag) return M_LEAF;
	vec2 c2 = vec2(tx + (h4 - 0.5) * R * 0.8, h + ry * 0.6);
	if (dy > c2.y - 2.5 && length((q - vec2(c2.x, c2.y - 1.0)) / vec2(R * 0.6, ry * 0.8)) < rag) return M_LEAF;
	return 0u;
}

// giant mushroom: a pale stalk that bends a little, with a ring, under a broad domed cap whose rim
// droops; some are giants
uint mushroomTree(vec2 q, float hh, float h3, float h4) {
	bool giant = h3 < 0.15;
	float h = giant ? 50.0 + floor(hh * 12.0) : 18.0 + floor(hh * 26.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float sw = 1.3 + h * 0.035;
	float off = sin(dy * 0.07 + h4 * 6.0) * 1.6 * min(1.0, dy / h);
	float Rc = 8.0 + h * 0.32, Hc = 5.0 + h * 0.13;
	float co = sin(h * 0.07 + h4 * 6.0) * 1.6;
	if (dy >= h - 2.0 && length(vec2((da - co) / Rc, (dy - (h - 2.0)) / Hc)) < 1.0) return M_CAP;
	if (dy >= h - 4.0 && dy < h - 2.0 && abs(da - co) < Rc && abs(da - co) > Rc * 0.8) return M_CAP;
	if (abs(dy - h * 0.72) < 0.9 && abs(da - off) < sw + 1.3) return M_STALK;
	if (dy < h && abs(da - off) < sw + max(0.0, 2.5 - dy) * 0.7) return M_STALK;
	return 0u;
}

// Roots, for every kind of tree with a woody trunk: the trunk carries on down into the ground as a
// tapering taproot (so on a slope it reaches the earth instead of ending flat in the air), and three to
// five roots run out from its foot, near the surface first and then diving. Where the ground falls away
// they show; below the surface they lie in the background behind the earth, found when you dig. q is
// the cell from the trunk's foot (q.y < 0 below it), tw the trunk's width, mat its wood.
float rootWidth(int ft) {
	if (ft == 12) return 2.0;
	if (ft == 14) return 3.0;
	if (ft == 16) return 7.0;
	if (ft == 17) return 4.0;
	return ft == 1 ? 4.0 : (ft == 2 ? 3.0 : (ft == 4 ? 4.0 : (ft == 5 ? 2.0 : (ft == 6 ? 2.0 : (ft == 7 ? 5.5 : (ft == 8 ? 2.5 : 0.0))))));
}
uint treeRoots(vec2 q, float tw, float hh, float h3, int bb, uint mat) {
	if (q.y < -18.0) return 0u;
	float tap = 5.0 + floor(hh * 8.0);
	if (-q.y < tap && abs(q.x) < tw * 0.5 * (1.0 + q.y / tap * 0.6) + 0.35) return mat;
	int n = 3 + int(h3 * 3.0);
	for (int k = 0; k < 5; k++) {
		if (k >= n) break;
		float hk = h2(ivec2(bb, 140 + k), SEED);
		float side = (k % 2 == 0) ? 1.0 : -1.0;
		float L = tw * 1.2 + 4.0 + hk * 12.0;
		float D = 3.0 + h2(ivec2(bb, 150 + k), SEED) * 10.0;
		vec2 a = vec2(side * tw * 0.3, 0.0), m = vec2(side * L * 0.55, -D * 0.25), e = vec2(side * L, -D);
		float th = 1.25 - hk * 0.35;
		if (segDist(q, a, m) < th || segDist(q, m, e) < th * 0.7) return mat;
	}
	return 0u;
}

uint floraId = 0u;   // which tree the cell flora() returned belongs to (aux bits 16-31, see react.comp)
// trees and other surface plants, evaluated per cell from hashed "buckets" along the surface arc
// Terrain 3: what grows in a cave of each layer, in the background (no collisions), keyed by the floor or ceiling
// it grows from so each plant stays whole. Glowroot: glowcap clusters and tall glowing stalks on the floor, roots
// and vines hanging from the roof; Prism: crystal clusters up from the floor and down from the roof; Frostvein:
// icicles and frost blooms; Smoldering: ember vents and ash tufts, glowing drips. Deeper (past the stone, `shallow`
// false) the glowcaps carry on, fewer.
uint caveFlora(vec2 p, float r, float th, int ug, bool shallow) {
	vec2 up = p / max(r, 1.0);
	float arc = th * RS0;
	for (int k = 1; k <= 9; k++) {
		if (solidAt(p - up * float(k))) {
			// a floor k below
			float fr = floor(r - float(k));
			int col = int(floor(arc / 2.0));
			float hv = h2(ivec2(col, int(fr)), SEED + 41);
			float hw = h2(ivec2(col / 3, int(fr) + 7), SEED + 42);
			if (ug == 0) {
				if (hv < 0.07 && float(k) <= 2.0 + floor(hv * 60.0)) return M_SHROOM;
				if (hw < 0.06 && float(k) <= 4.0 + floor(hw * 120.0) && (col % 3) == 1) return float(k) > 2.0 + floor(hw * 100.0) ? M_SHROOM : M_STALK;
				if (hv > 0.55 && float(k) <= 1.0 + floor((hv - 0.55) * 9.0)) return M_LEAF;          // moss and ferns
			} else if (ug == 1) {
				if (hv < 0.035 && float(k) <= 2.0 + floor(hv * 220.0)) return M_CRYSTAL;
				if (hv > 0.85 && float(k) <= 1.0) return M_SAND;
			} else if (ug == 2) {
				if (hv < 0.035 && float(k) <= 2.0 + floor(hv * 120.0)) return M_FROST;
				if (hv > 0.85 && float(k) <= 1.0) return M_SNOW;
			} else {
				if (hv < 0.03 && float(k) <= 1.0 + floor(hv * 80.0)) return M_EMBER;
				if (hv > 0.8 && float(k) <= 1.0) return M_ASH;
			}
			if (!shallow && hv > 0.985 && float(k) <= 2.0) return M_SHROOM;
			return 0u;
		}
	}
	for (int k2 = 1; k2 <= 14; k2++) {
		if (solidAt(p + up * float(k2))) {
			// a roof k2 above
			float cr = floor(r + float(k2));
			int col2 = int(floor(arc));
			float hv2 = h2(ivec2(col2, int(cr)), SEED + 43);
			float hl = h2(ivec2(col2 / 4, int(cr) + 3), SEED + 44);
			if (ug == 0) {
				// roots and vines hanging down, a glowing bud at the end of some
				float L = 3.0 + floor(hl * 14.0);
				if (hl < 0.45 && hv2 < 0.5 && float(k2) <= L) return float(k2) > L - 1.0 && hl < 0.04 ? M_SHROOM : (hl < 0.25 ? M_ROOT : M_LEAF);
			} else if (ug == 1) {
				if (hv2 < 0.03 && float(k2) <= 2.0 + floor(hv2 * 160.0)) return M_CRYSTAL;
			} else if (ug == 2) {
				// icicles
				float L2 = 2.0 + floor(hl * 9.0);
				if (hl < 0.35 && (col2 % 3) == 0 && float(k2) <= L2) return M_ICE;
			} else {
				if (hv2 < 0.02 && float(k2) <= 1.0 + floor(hv2 * 120.0)) return M_EMBER;
			}
			return 0u;
		}
	}
	return 0u;
}

// Rootlets (27 Nov; user: "foliage that goes a bit underground and doesnt just cut off so they are more belivable and
// part of the world"): under the small plants, threads of root (front cells, so they show) reach down into the soil
// below its top row: a tap root and a fan of fibres under a bush, a single thread under a tuft, wide and shallow under
// a cactus, under a fern's stem, a mushroom's foot. Only in soft ground (`rootSoil`); only on worlds made from now on.
bool rootSoil(uint m) {
	// (not sand, snow or mud: burrowers live in those, and a root there would wall them in)
	return m == M_DIRT || m == M_MYCELIUM || m == M_GRASS || m == M_DRYGRASS || m == M_MOSSBLOCK;
}
uint rootlets(float r, float th, int floraType) {
	float arc = th * RS0;
	int col = int(floor(arc));
	float d = floor(surfA(th).x) - r;          // how deep under the soil's top (0..1: its top row)
	if (d < 1.0 || d > 9.0) return 0u;
	if (onSite(th, 1.0)) return 0u;
	float hc = h2(ivec2(col, int(floor(d)) + 400), SEED);
	if (floraType == 1 || floraType == 2 || floraType == 4 || floraType == 7 || floraType == 17) {
		bool jng = floraType == 7;
		float bw2 = floraType == 17 ? 41.0 : (jng ? 11.0 : 9.0);
		int b2 = int(floor(arc / bw2));
		for (int k = -1; k <= 1; k++) {
			int bb = b2 + k;
			float hb = h2(ivec2(bb, floraType == 17 ? 178 : 85), SEED);
			if (hb > (floraType == 17 ? 0.25 : (floraType == 4 ? 0.3 : (jng ? 0.75 : 0.5)))) continue;
			float cx = (float(bb) + 0.5) * bw2;
			float dx = arc - cx;
			float bd = floor(surfA(cx / RS0).x) - r;
			if (bd < 1.0) continue;
			float rx = floraType == 17 ? 7.0 + hb * 14.0 : (jng ? 3.5 + hb * 7.0 : 2.5 + hb * 4.0);
			float tap = floraType == 2 ? 3.0 + hb * 5.0 : 2.0 + hb * 4.0;
			// the tap root, wandering a little as it goes down
			if (bd <= tap && abs(dx - sin(bd * 0.8 + float(bb)) * 0.8) < 0.55) return M_ROOT;
			// a fan of fibres spreading out from under the crown
			if (floraType != 2 && bd <= 1.0 + rx * 0.45 && abs(abs(dx) - (bd - 1.0) * 1.4 - 0.4) < 0.55 && abs(dx) < rx * 0.9 && hc < 0.8) return M_ROOT;
		}
	}
	if (floraType == 3) {
		float bw3 = 11.0;
		int b3 = int(floor(arc / bw3));
		for (int k = -1; k <= 1; k++) {
			int bb = b3 + k;
			float hb = h2(ivec2(bb, 88), SEED);
			if (hb > 0.2) continue;
			float cx = (float(bb) + 0.5) * bw3;
			float bd = floor(surfA(cx / RS0).x) - r;
			float rx = 2.2 + hb * 9.0;
			if (bd >= 1.0 && bd < 2.5 && abs(arc - cx) < rx * 1.4 && hc < 0.55) return M_ROOT;
		}
	}
	if (floraType == 9 || floraType == 16) {
		float bw4 = floraType == 9 ? 7.0 : 6.0;
		int b4 = int(floor(arc / bw4));
		for (int k = -1; k <= 1; k++) {
			int bb = b4 + k;
			float hb = h2(ivec2(bb, floraType == 9 ? 91 : 176), SEED);
			if (hb > (floraType == 9 ? 0.4 : 0.55)) continue;
			float cx = (float(bb) + 0.5) * bw4;
			float bd = floor(surfA(cx / RS0).x) - r;
			if (bd >= 1.0 && bd < 2.0 + hb * 5.0 && abs(arc - cx - sin(bd + float(bb)) * 0.6) < 0.6) return M_ROOT;
		}
	}
	// a thread under each tuft of grass (as the tufts above: flora())
	float hr = 1.0;
	float lim = 0.0;
	if (floraType == 1 || floraType == 4 || floraType == 7) { hr = h2(ivec2(col, 86), SEED); lim = 0.35; }
	else if (floraType == 16) { hr = h2(ivec2(col, 177), SEED); lim = 0.4; }
	else if (floraType == 17) { hr = h2(ivec2(col, 180), SEED); lim = 0.55; }
	else if (floraType == 8) { hr = h2(ivec2(col, 89), SEED); lim = vnoise(vec2(arc / 7.0, 0.0), SEED + 90) > 0.35 ? 0.7 : 0.3; }
	if (hr < lim && d <= 1.0 + floor(hr * 7.0) && h2(ivec2(col, 401), SEED) < 0.6) return M_ROOT;
	return 0u;
}

uint flora(vec2 p, float r, float th, int floraType, bool inWater, bool rootsOnly) {
	float arc = th * RS0;
	// One spacing grid for every kind of tree, and each tree takes its kind from the biome at its
	// own trunk, so a crown reaching over a biome border is still drawn whole (it used to switch
	// kind column by column there and get cut off). Density per kind: oaks, pines, cacti, willows,
	// charred trees, palms.
	float BW = 14.0;
	float nB = floor(TAU * RS0 / BW);
	float L = nB * BW;
	int b = int(floor(arc / BW));
	float spawnA = P.p[121].x;
	float nz = h2(ivec2(int(arc), int(r)), SEED + 5);
	// where crowns overlap, a cell goes to the tree whose trunk is nearest (and wood always wins),
	// so each tree stays one connected piece of its own (react.comp keeps trees apart by id)
	uint best = 0u;
	float bestScore = 1e9;
	uint bestId = 0u;
	for (int k = -3; k <= 3; k++) {
		int bb = int(mod(float(b + k), nB));
		float hb = h2(ivec2(bb, 77), SEED);
		float st = (float(bb) + 0.2 + 0.6 * h2(ivec2(bb, 78), SEED)) * BW;
		float da = arc - st; da -= floor(da / L + 0.5) * L;
		if (abs(da) > 40.0) continue;
		float tth = st / RS0;
		vec4 ta = surfA(tth), tb = surfB(tth);
		int ft = int(biomeB(int(ta.y)).w) >> 4;
		float dens = ft == 1 ? 0.62 : (ft == 2 ? 0.7 : (ft == 4 ? 0.32 : (ft == 5 ? 0.33 : (ft == 3 ? 0.22 : (ft == 6 ? 0.24 :
			(ft == 7 ? 0.62 : (ft == 8 ? 0.16 : (ft == 9 ? 0.42 : 0.0))))))));
		// (each kind of world's own biome's: palms on the kelp isles' bars, mangroves, elder trees, a lone oak on a meadow)
		if (ft == 12) dens = 0.2;
		else if (ft == 14) dens = 0.42;
		else if (ft == 16) dens = 0.3;
		else if (ft == 17) dens = 0.06;
		if (hb >= dens) continue;
		float sp = abs(tth - spawnA); sp = min(sp, TAU - sp);
		if (sp * RS0 < 30.0) continue;
		if (onSite(tth, 26.0)) continue;
		if (tb.y > ta.x + 0.5 && !(ft == 14 && tb.y < ta.x + 12.0)) continue; // trunk would be underwater (a mangrove stands in it)
		float base = floor(ta.x);
		vec2 q = vec2(da, r - base);
		if (q.y > 112.0 || q.y < -18.0) continue;
		if (rootsOnly && q.y >= 0.0) continue;
		float hh = h2(ivec2(bb, 79), SEED), h3 = h2(ivec2(bb, 83), SEED), h4 = h2(ivec2(bb, 84), SEED);
		uint m = 0u;
		if (q.y < 0.0) {
			float rw = rootWidth(ft);
			if (rw > 0.0) m = treeRoots(q, rw, hh, h3, bb, M_ROOT);
		}
		else if (ft == 1) m = oakTree(q, hh, h3, h4, nz);
		else if (ft == 2) {
			vec4 A = biomeA(int(ta.y));
			bool snowy = uint(A.z) == M_SNOW || ((int(A.w) & 1) != 0 && ta.x > RS0 + 20.0);
			m = pineTree(q, hh, h3, snowy, bb);
		}
		else if (ft == 3) m = hb < 0.05 ? palmTree(q, hh, h3) : cactusTree(q, hh, h3, h4);
		else if (ft == 4) m = willowTree(q, hh, h3, bb, nz);
		else if (ft == 5) m = charredTree(q, hh, bb);
		else if (ft == 6) m = palmTree(q, hh, h3);
		else if (ft == 7) m = jungleTree(q, hh, h3, h4, bb, nz);
		else if (ft == 8) m = acaciaTree(q, hh, h4, bb, nz);
		else if (ft == 9) m = mushroomTree(q, hh, h3, h4);
		else if (ft == 12) m = palmTree(q, hh, h3);
		else if (ft == 14) m = mangroveTree(q, hh, h3, bb, nz);
		else if (ft == 16) m = elderTree(q, hh, h3, h4, bb, nz);
		else if (ft == 17) m = oakTree(q, hh, h3, h4, nz);
		if (m != 0u) {
			// wood wins over leaves (each tree stays one piece), and a root gives way to every other part
			// of any tree (a root reaching under a downhill neighbour never cuts its branches or crown)
			float sc = abs(da) - ((m == M_WOOD || m == M_COAL || m == M_CACTUS || m == M_STALK) ? 1000.0 : 0.0) + (m == M_ROOT ? 2000.0 : 0.0);
			// where two mushroom caps overlap, the shorter one is in front: its whole cap shows and the
			// taller one's shows round it (nearest-trunk split them down a straight line, each its own colour)
			if (m == M_CAP) sc = 500.0 + (h3 < 0.15 ? 50.0 + floor(hh * 12.0) : 18.0 + floor(hh * 26.0)) * 4.0 + abs(da) * 0.01;
			if (sc < bestScore) { bestScore = sc; best = m; bestId = 0x8000u | uint(bb + 1); }
		}
	}
	if (best != 0u) { floraId = bestId; return best; }
	if (rootsOnly) return 0u;
	// undergrowth and small plants
	if (onSite(th, 1.0)) return 0u;
	int col = int(floor(arc));
	vec4 sa = surfA(th);
	float dy = r - floor(sa.x);
	if (dy < 0.0) return 0u;
	if (floraType == 1 || floraType == 2 || floraType == 4 || floraType == 7) {
		// bushes (and young pines in pine country); the jungle's are bigger and everywhere
		bool jng = floraType == 7;
		float bw2 = jng ? 11.0 : 9.0;
		int b2 = int(floor(arc / bw2));
		for (int k = -1; k <= 1; k++) {
			int bb = b2 + k;
			float hb = h2(ivec2(bb, 85), SEED);
			if (hb > (floraType == 4 ? 0.3 : (jng ? 0.75 : 0.5))) continue;
			float cx = (float(bb) + 0.5) * bw2;
			float dx = arc - cx;
			vec4 ba = surfA(cx / RS0);
			float by = r - floor(ba.x);
			if (floraType == 2) {
				float hs = 4.0 + floor(hb * 8.0);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 1.0 && by < hs && abs(dx) < (hs - by) * 0.4 + 0.5) return M_LEAF;
				if (by >= 0.0 && by < 1.0 && abs(dx) < 0.6) return M_WOOD;
			} else {
				float rx = jng ? 3.5 + hb * 7.0 : 2.5 + hb * 4.0, ry = jng ? 3.0 + hb * 5.0 : 2.0 + hb * 3.0;
				float e = (dx * dx) / (rx * rx) + (by - ry * 0.6) * (by - ry * 0.6) / (ry * ry);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 0.0 && e < 1.0 - nz * 0.25) return M_LEAF;
			}
			floraId = 0u;
		}
		// grass tufts
		float hr = h2(ivec2(col, 86), SEED);
		if (floraType != 2 && hr < 0.35 && dy < 1.0 + floor(hr * 9.0)) return M_LEAF;
	}
	if (floraType == 3) {
		// barrel cacti: squat ribbed domes
		float bw3 = 11.0;
		int b3 = int(floor(arc / bw3));
		for (int k = -1; k <= 1; k++) {
			int bb = b3 + k;
			float hb = h2(ivec2(bb, 88), SEED);
			if (hb > 0.2) continue;
			float cx = (float(bb) + 0.5) * bw3;
			float dx = arc - cx;
			float by = r - floor(surfA(cx / RS0).x);
			float rx = 2.2 + hb * 9.0, ry = rx * 1.15;
			if (by >= 0.0 && (dx * dx) / (rx * rx) + (by - ry * 0.75) * (by - ry * 0.75) / (ry * ry) < 1.0) {
				floraId = 0xC000u | uint(bb + 200000) % 16000u;
				return M_CACTUS;
			}
		}
	}
	if (floraType == 8) {
		// savanna: tall golden grass in clumps, with gaps between them
		float clump = vnoise(vec2(arc / 7.0, 0.0), SEED + 90);
		float hr = h2(ivec2(col, 89), SEED);
		float gh = clump > 0.35 ? 2.0 + floor(hr * 4.0 + clump * 7.0) : (hr < 0.3 ? 1.0 + floor(hr * 6.0) : 0.0);
		if (dy < gh) { floraId = 0u; return M_DRYGRASS; }
	}
	if (floraType == 9) {
		// the grove: small mushrooms between the giants, and glowing toadstools
		float bw4 = 7.0;
		int b4 = int(floor(arc / bw4));
		for (int k = -1; k <= 1; k++) {
			int bb = b4 + k;
			float hb = h2(ivec2(bb, 91), SEED);
			if (hb > 0.4) continue;
			float cx = (float(bb) + 0.5) * bw4;
			float dx = arc - cx;
			float by = r - floor(surfA(cx / RS0).x);
			float hs = 2.0 + floor(hb * 10.0);
			float rc = 2.0 + hb * 6.0;
			floraId = 0xC000u | uint(bb + 300000) % 16000u;
			if (by >= hs && by < hs + 3.0 && abs(dx) < rc * (1.0 - (by - hs) / 3.4)) return M_CAP;
			if (by >= 0.0 && by < hs && abs(dx) < 0.7 + hb) return M_STALK;
			floraId = 0u;
		}
	}
	// ---- each kind of world's own biome (26 Nov): stone scenery stands in the background with no plant id
	// (floraId 0: nothing to fell or knit), the living undergrowth as the others' ----
	if (floraType == 11) {
		// basalt columns: clusters of hexagonal pillars, tallest in the middle, a dark seam between each
		float bw6 = 17.0;
		int b6 = int(floor(arc / bw6));
		for (int k = -1; k <= 1; k++) {
			int bb = b6 + k;
			float hb = h2(ivec2(bb, 170), SEED);
			if (hb > 0.8) continue;
			int nc = 3 + int(hb * 6.0);
			float x0 = (float(bb) + 0.5) * bw6 - float(nc) * 1.5;
			float lx = arc - x0;
			if (lx < 0.0 || lx >= float(nc) * 3.0) continue;
			int ci = int(floor(lx / 3.0));
			float mid = abs(float(ci) - float(nc - 1) * 0.5) / max(float(nc) * 0.5, 1.0);
			float hc = 5.0 + floor(h2(ivec2(bb * 11 + ci, 171), SEED) * 34.0 * (1.0 - mid * 0.55) + hb * 18.0);
			float by = r - floor(surfA((x0 + float(ci) * 3.0 + 1.5) / RS0).x);
			if (by < 0.0 || by >= hc) continue;
			floraId = 0u;
			return mod(lx, 3.0) < 0.9 || by >= hc - 1.0 ? M_OBSIDIAN : M_DEEPSTONE;
		}
	}
	if (floraType == 12 && inWater) {
		// kelp forests in the shallows: tall swaying strands up toward the surface, a float now and then
		float wtop = surfB(th).y;
		float bw7 = 3.0;
		int b7 = int(floor(arc / bw7));
		float hb = h2(ivec2(b7, 172), SEED);
		if (hb < 0.6) {
			float hs = (wtop - floor(sa.x)) * (0.55 + hb * 0.45);
			float cx = (float(b7) + 0.5) * bw7 + sin(dy * 0.17 + float(b7)) * 1.2;
			if (dy < hs && abs(arc - cx) < 0.75) return M_LEAF;
			if (dy < hs && mod(dy + float(b7) * 3.0, 7.0) < 1.0 && abs(arc - cx - 1.0) < 0.8) return M_LEAF;
		}
	}
	if (floraType == 13) {
		// salt pillars: pale spires standing out of the flats, a ledge or two on the taller
		float bw8 = 23.0;
		int b8 = int(floor(arc / bw8));
		for (int k = -1; k <= 1; k++) {
			int bb = b8 + k;
			float hb = h2(ivec2(bb, 173), SEED);
			if (hb > 0.55) continue;
			float cx = (float(bb) + 0.5) * bw8;
			float by = r - floor(surfA(cx / RS0).x);
			float hs = 5.0 + floor(hb * 80.0);
			float wd = (1.6 + hb * 7.0) * (1.0 - by / (hs * 1.35)) + (mod(by + float(bb), 8.0) < 1.0 ? 0.9 : 0.0);
			if (by >= 0.0 && by < hs && abs(arc - cx) < wd) { floraId = 0u; return M_SANDSTONE; }
		}
		// crusted heaps of salt crystals, knee-high, all over the flats
		float bw8b = 5.0;
		int b8b = int(floor(arc / bw8b));
		float hb8 = h2(ivec2(b8b, 181), SEED);
		if (hb8 < 0.35) {
			float cx8 = (float(b8b) + 0.5) * bw8b;
			float hs8 = 1.0 + floor(hb8 * 9.0);
			if (dy < hs8 && abs(arc - cx8) < (hs8 - dy) * 0.8 + 0.4) { floraId = 0u; return M_SANDSTONE; }
		}
	}
	if (floraType == 15) {
		// ice crystal spires, leaning, a glowing frost tip on each; small shards between
		float bw9 = 19.0;
		int b9 = int(floor(arc / bw9));
		for (int k = -1; k <= 1; k++) {
			int bb = b9 + k;
			float hb = h2(ivec2(bb, 174), SEED);
			if (hb > 0.6) continue;
			float cx = (float(bb) + 0.5) * bw9;
			float by = r - floor(surfA(cx / RS0).x);
			float big = hb < 0.35 ? 1.0 : 0.25;
			float hs = 4.0 + floor((hb * 60.0 + 6.0) * big);
			float lean = (h2(ivec2(bb, 175), SEED) - 0.5) * 0.7;
			float wd = (1.2 + hb * 5.0 * big) * (1.0 - by / hs) + 0.3;
			if (by >= 0.0 && by < hs && abs(arc - cx - by * lean) < wd) { floraId = 0u; return by > hs - 3.0 ? M_FROST : M_ICE; }
		}
	}
	if (floraType == 16) {
		// ferns under the elder trees: arching fronds round a short stem, and grass
		float bw10 = 6.0;
		int b10 = int(floor(arc / bw10));
		for (int k = -1; k <= 1; k++) {
			int bb = b10 + k;
			float hb = h2(ivec2(bb, 176), SEED);
			if (hb > 0.55) continue;
			float cx = (float(bb) + 0.5) * bw10;
			float by = r - floor(surfA(cx / RS0).x);
			float fw = 3.0 + hb * 9.0, fh = 3.0 + hb * 8.0;
			float x = arc - cx;
			if (by < 0.0 || abs(x) > fw) continue;
			float yf = fh * (1.0 - (x / fw) * (x / fw));
			floraId = 0xC000u | uint(bb + 400000) % 16000u;
			if (abs(by - yf) < 0.9 || (abs(x) < 0.6 && by < fh)) return M_LEAF;
			floraId = 0u;
		}
		float hr = h2(ivec2(col, 177), SEED);
		if (hr < 0.4 && dy < 1.0 + floor(hr * 8.0)) return M_LEAF;
	}
	if (floraType == 17) {
		// a meadow: hedgerows, the odd dry-stone wall, and flowers everywhere (render.comp colours their heads)
		float bw11 = 41.0;
		int b11 = int(floor(arc / bw11));
		for (int k = -1; k <= 1; k++) {
			int bb = b11 + k;
			float hb = h2(ivec2(bb, 178), SEED);
			if (hb > 0.4) continue;
			float cx = (float(bb) + 0.5) * bw11;
			float hw = 7.0 + hb * 14.0;
			float x = arc - cx;
			float by = r - floor(surfA(cx / RS0).x);
			if (abs(x) > hw || by < 0.0) continue;
			if (hb < 0.25) {
				float hh2 = 4.0 + hb * 6.0;
				float top = hh2 - max(0.0, abs(x) - hw + 3.0) * 1.2;
				floraId = 0xC000u | uint(bb + 500000) % 16000u;
				if (by < top - nz * 1.2) return M_LEAF;
				floraId = 0u;
			} else if (by < 3.0 + step(0.5, h2(ivec2(int(arc) / 3, 179), SEED))) {
				floraId = 0u;
				return M_MASONRY;
			}
		}
		float hr = h2(ivec2(col, 180), SEED);
		if (hr < 0.55 && dy < 1.0 + floor(hr * 7.0)) return M_LEAF;
	}
	if (floraType == 4) {
		float hr = h2(ivec2(col, 80), SEED);
		if (hr < 0.3 && dy < 3.0 + floor(hr * 20.0)) return M_LEAF;
	}
	if (floraType == 6 && inWater && !TV3) {
		float hr = h2(ivec2(col, 81), SEED);
		if (hr < 0.2 && dy < 4.0 + floor(hr * 50.0)) return M_LEAF;
	}
	if ((floraType == 10 || (TV3 && floraType == 6)) && inWater) {
		// a deep ocean world's sea floor: kelp forests on the upper slopes; in the dark below, glowing coral
		// fans, tube worms with lit tips and pale glowcaps (the only light down there but yours)
		float wcol = surfB(th).y - floor(sa.x);
		float hr = h2(ivec2(col, 82), SEED);
		if (wcol < 170.0) {
			if (hr < 0.28 && dy < 6.0 + floor(hr * 150.0)) return M_LEAF;
		} else {
			float bw5 = 9.0;
			int b5 = int(floor(arc / bw5));
			for (int k = -1; k <= 1; k++) {
				int bb = b5 + k;
				float hb = h2(ivec2(bb, 93), SEED);
				if (hb > 0.42) continue;
				float cx = (float(bb) + 0.5) * bw5;
				float dx = arc - cx;
				float by = r - floor(surfA(cx / RS0).x);
				float hs = 3.0 + floor(hb * 30.0);
				if (by < 0.0 || by >= hs) continue;
				if (hb < 0.09) {
					// a coral fan, widening upward, lacy
					if (abs(dx) < (by / hs) * (2.0 + hb * 40.0) + 0.6 && h2(ivec2(int(arc * 2.0), int(r * 2.0)), SEED + 94) < 0.7) return M_CRYSTAL;
				} else if (hb < 0.24) {
					// tube worms: thin stalks with glowing tips
					if (abs(dx - sin(by * 0.4 + hb * 20.0)) < 0.6) return by > hs - 2.0 ? M_SHROOM : M_STALK;
				} else if (by < 2.0 + hb * 5.0 && abs(dx) < 1.0 + hb * 2.0) {
					return M_SHROOM;
				}
			}
		}
	}
	return 0u;
}

// The world mending itself (27 Nov; user: "a magical force that will slowly rebuild the terrain. maybe part of the
// story?"): pc.a.w = 1 runs this over a window (columns pc.b.x .. + pc.b.y of shell pc.a.x, rows pc.a.y .. pc.a.z) and,
// instead of writing what the planet was made with, puts a little of it back where it's gone: an empty cell whose
// first self was ground fills (if two of its sides are solid already, pc.b.z / 1000 of the time: a hole closes from
// its walls in), ore coming back as plain stone; a plant's cells grow back where nothing is. Never near anything built
// (blocks laid, back walls, furniture, chests: two cells round), never the world's heart. scripts/mending.gd.
bool mendBuiltNear(int s, int y, int x) {
	for (int dy = -2; dy <= 2; dy++) {
		int yy = y + dy;
		if (yy < SH_Y0(s) || yy >= SH_Y1(s) || yy < 0) continue;
		for (int dx = -2; dx <= 2; dx++) {
			int ii = cellIdx(s, yy, wrapc(x + dx, SH_N(s)));
			uint cc = world.cells[ii];
			uint aa = aux.a[ii];
			uint bb = aa & 255u;
			if ((cc & ST_BUILT) != 0u || (aa & BG_WALL) != 0u || bb == M_DECOR || bb == M_TORCH || bb == M_TREASURE || bb == M_OPENCHEST
					|| (cc & 255u) == M_TREASURE || (cc & 255u) == M_WOODDOOR) return true;
		}
	}
	return false;
}
bool mendSolidAt(int s, int y, int x) {
	if (y < SH_Y0(s) || y >= SH_Y1(s) || y < 0) return true;
	uint t = world.cells[cellIdx(s, y, wrapc(x, SH_N(s)))] & 255u;
	return KIND[t] == K_SOLID || KIND[t] == K_POWDER;
}
uint mendOre(uint m) {
	if (m == M_COPPER || m == M_COAL || m == M_WISP || m == M_EMBER || m == M_FROST || m == M_CRYSTAL || m == M_STARIRON
			|| (m >= M_FIREOPAL && m <= M_SILVER) || m == M_TREASURE) return M_STONE;
	return m;
}

void main() {
	int s = pc.a.x;
	bool mend = pc.a.w == 1;
	int x = int(gl_GlobalInvocationID.x);
	if (mend) {
		if (x >= pc.b.y) return;
		x = wrapc(pc.b.x + x, SH_N(s));
	}
	int y = pc.a.y + int(gl_GlobalInvocationID.y);
	if (x >= SH_N(s) || y >= pc.a.z || y >= SH_Y1(s)) return;
	if (mend && (y < 0 || y < SH_Y0(s))) return;
	if (y < 0) {                                     // the orbit band starts empty
		int oi = cellIdx(s, y, x);
		world.cells[oi] = 0u;
		aux.a[oi] = 0u;
		return;
	}
	SEED = int(P.p[0].w);
	TV2 = P.p[26].x > 1.5;
	TV3 = P.p[26].x > 2.5;
	vec2 p = cellCenter(s, y, x);
	float r = length(p);
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	int b = int(sa.y);
	// near a biome border, each cell picks one of the two biomes with ragged noise, so the layers
	// (topsoil, dirt, stone, underground biome) interfinger instead of meeting at a straight seam
	{
		float k = floor(sb.w);
		float bt = clamp((sb.w - k) / 0.9, 0.0, 1.0);
		int b0 = int(k) / 16, b1 = int(k) % 16;
		if (b0 != b1) {
			// three scales: broad lobes, fingers a few cells wide, and single-cell grains at the very
			// edge, so each side reaches into the other in pockets instead of one wavy line
			float rag = (fbm(p / 47.0, SEED + 62, 2) - 0.5) * 0.9 + (fbm(p / 10.0, SEED + 61, 2) - 0.5) * 2.2
				+ (fbm(p / 3.5, SEED + 63, 2) - 0.5) * 1.1 + (h2(ivec2(x, y), SEED + 64) - 0.5) * 0.18;
			b = (bt + rag) < 0.5 ? b0 : b1;
		}
	}
	float rs = sa.x;
	vec4 B = biomeB(b);
	int ug = int(B.w) & 15;
	// small plants follow the column's biome (trees take theirs from their own trunk, in flora()); near a
	// border each column picks one of the two by ragged noise, so grass, bushes and tufts mingle in clumps
	// instead of changing at one column
	int floraType = int(biomeB(int(sa.y)).w) >> 4;
	{
		float fk = floor(sb.w);
		int f0 = int(fk) / 16, f1 = int(fk) % 16;
		if (f0 != f1) {
			float fbt = clamp((sb.w - fk) / 0.9, 0.0, 1.0);
			float colA = th * RS0;
			float frag = (vnoise(vec2(colA / 13.0, 0.5), SEED + 65) - 0.5) * 1.5 + (vnoise(vec2(colA / 4.0, 0.5), SEED + 66) - 0.5) * 0.6
				+ (h2(ivec2(int(floor(colA)), 67), SEED) - 0.5) * 0.25;
			floraType = int(biomeB((fbt + frag) < 0.5 ? f0 : f1).w) >> 4;
		}
	}
	uint m = 0u;
	uint bgm = 0u;   // background decoration (no collisions)

	if (r < rs) {
		// tree roots in the background just under the surface (behind the earth until you dig)
		if (r > rs - 18.0) {
			floraId = 0u;
			uint rt = flora(p, r, th, floraType, false, true);
			if (rt != 0u) bgm = rt;
		}
		m = settleSafe(strata(p, r, th, sa, sb, b), p, r, th, rs);
		if (m != M_CORE && carvedAt(p, r, rs, sb.x) && !(TV2 && caveSpike(p, r, th, rs))) {
			m = 0u;
			// liquid pools resting on cave floors
			float pn = fbm(p / 58.0, SEED + 30, 1);
			if (pn > 0.62) {
				float depth = 3.0 + floor(h2(ivec2(int(p.x / 13.0), int(p.y / 13.0)), SEED + 31) * 7.0);
				vec2 dn = -normalize(p);
				bool floor_ = false;
				for (int k = 1; k <= 9; k++) { if (float(k) > depth) break; if (solidAt(p + dn * float(k))) { floor_ = true; break; } }
				if (floor_) {
					float lavaMul = P.p[7].z;
					if (r > sa.z) m = ug == 2 ? M_ICE : M_WATER;
					else if (r > sa.w) m = (r < (sa.z + sa.w) * 0.5 && pn > 0.75 - 0.05 * lavaMul) ? M_LAVA : M_WATER;
					else m = pn > 0.66 - 0.03 * lavaMul ? M_LAVA : 0u;
				}
			}
			// (terrain 3) the cave layer's plants: on the floors and hanging from the ceilings
			if (TV3 && m == 0u && r < rs - 10.0 && r > sa.w) {
				uint cp = caveFlora(p, r, th, ug, r > sa.z);
				if (cp != 0u) { bgm = cp; floraId = 0u; }
			}
			// cave plants and crystals growing from the floor (background layer)
			if (!TV3 && m == 0u && r < rs - 10.0) {
				vec2 dn = -normalize(p);
				for (int k = 1; k <= 7; k++) {
					if (solidAt(p + dn * float(k))) {
						float fr = floor(r - float(k));
						float hv = h2(ivec2(int(th * RS0), int(fr)), SEED + 40);
						float hgt = 0.0; uint mat = 0u;
						bool shallow = r > sa.z;
						if (ug == 0 && shallow && hv < 0.11) { mat = M_SHROOM; hgt = 2.0 + mod(floor(hv * 40.0), 4.0); }
						else if (ug == 1 && hv < 0.035) { mat = M_CRYSTAL; hgt = 2.0 + mod(floor(hv * 150.0), 6.0); }
						else if (ug == 2 && shallow && hv < 0.05) { mat = M_ICE; hgt = 2.0 + mod(floor(hv * 90.0), 4.0); }
						else if (ug == 3 && hv < 0.04) { mat = M_EMBER; hgt = 1.0 + mod(floor(hv * 90.0), 3.0); }
						else if (!shallow && r > sa.w && hv < 0.018) { mat = M_SHROOM; hgt = 2.0 + mod(floor(hv * 300.0), 3.0); }
						if (mat != 0u && float(k) <= hgt) { bgm = mat; floraId = 0u; }
						break;
					}
				}
			}
		}
		// rootlets under the small plants, in the soil's first rows (see rootlets())
		if (r > rs - 10.0 && rootSoil(m)) {
			uint rl = rootlets(r, th, floraType);
			if (rl != 0u) m = rl;
		}
	} else {
		// above ground: seas / ponds / lava lakes, then plants
		bool wet = sb.y > 0.0 && r < sb.y;
		if (wet) m = uint(sb.z);
		if (r < rs + 115.0) bgm = flora(p, r, th, floraType, wet, false);
	}

	// the heart boss's chamber, lined by the world's kind (P.p[121].z, Defs.HEART_CHAMBER): its floor half of
	// one stone, flecks of another round the rest; 7 (the deep ocean world's) is flooded
	vec4 boss = P.p[120];
	if (boss.y > 0.0) {
		vec2 bd = vec2(cos(boss.x), sin(boss.x));
		vec2 q = p - bd * boss.y;
		float u = dot(q, vec2(-bd.y, bd.x)), v = dot(q, bd);
		float e = u * u / (boss.z * boss.z) + v * v / (boss.w * boss.w);
		int th = int(P.p[121].z + 0.5);
		uint lining = M_OBSIDIAN, fleck = M_EMBER;
		if (th == 1 || th == 7) { lining = M_DEEPSTONE; fleck = M_CRYSTAL; }
		else if (th == 2) { lining = M_SANDSTONE; fleck = M_CRYSTAL; }
		else if (th == 3) { lining = M_MOSSBLOCK; fleck = M_SHROOM; }
		else if (th == 4) { lining = M_ICE; fleck = M_FROST; }
		else if (th == 5) { lining = M_MOSSBLOCK; fleck = M_AMBER; }
		else if (th == 6) { lining = M_MASONRY; fleck = M_RUNESTONE; }
		if (e < 1.0) { m = th == 7 ? M_WATER : 0u; bgm = 0u; }
		else if (e < 1.22 && v < 0.0) m = lining;
		else if (e < 1.22 && h2(ivec2(x, y), SEED + 50) < 0.12) m = fleck;
	}

	uint v = hashu(uint(x) * 2654435761u ^ uint(y) * 40503u ^ uint(s) * 977u) & 255u;
	int ci = cellIdx(s, y, x);
	if (mend) {
		uint c0 = world.cells[ci];
		uint a0 = aux.a[ci];
		uint t0 = c0 & 255u;
		if (KIND[t0] != K_EMPTY && KIND[t0] != K_GAS) return;
		if ((a0 & BG_WALL) != 0u || m == M_CORE) return;
		uint b0 = a0 & 255u;
		if (b0 == M_DECOR || b0 == M_TORCH || b0 == M_TREASURE || b0 == M_OPENCHEST) return;
		if (mendBuiltNear(s, y, x)) return;
		float roll = rnd3(uint(ci), uint(pc.b.w), 77u);
		if (KIND[m] == K_SOLID || KIND[m] == K_POWDER) {
			int sides = (mendSolidAt(s, y - 1, x) ? 1 : 0) + (mendSolidAt(s, y + 1, x) ? 1 : 0) + (mendSolidAt(s, y, x - 1) ? 1 : 0) + (mendSolidAt(s, y, x + 1) ? 1 : 0);
			if (sides < 2 || roll * 1000.0 > float(pc.b.z)) return;
			uint mm = mendOre(m);
			world.cells[ci] = mm | (v << 8) | (KIND[mm] == K_SOLID ? ST_ANCHOR : 0u);
			if (b0 == 0u && bgm != 0u) aux.a[ci] = bgm | (floraId != 0u ? floraId << 16 : 0u);
		} else if (m == 0u && b0 == 0u && bgm != 0u) {
			// a plant grows back where nothing is (all of it in one pass, out of sight: whole, as it stood)
			aux.a[ci] = bgm | (floraId != 0u ? floraId << 16 : 0u);
		}
		return;
	}
	// untouched natural solids are anchored: part of the planet until something disturbs them
	world.cells[ci] = m | (v << 8) | (KIND[m] == K_SOLID ? ST_ANCHOR : 0u);
	aux.a[ci] = bgm | (bgm != 0u && floraId != 0u ? floraId << 16 : 0u);
}
