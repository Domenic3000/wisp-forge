const uint PAL[192] = uint[192](1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u);
// Per-cell reactions: fire, burning, lava/water, melting, gas lifetimes, rain spawning.
// pc.a = (shell, y0, y1, x0)  pc.b = (count, frame, rainRow, rainMat); rain rate = P.p[3].x
// ---- shared helpers (pure functions, no buffer access) ----
// Main cell layout: bits 0-7 foreground material, 8-15 colour variant, 16-23 life
// (for falling blocks: how far they have fallen), 24-29 SUPPORT distance (how far
// this solid reaches out from something resting on the ground; above SPAN[t] it
// breaks loose), bit 30 ANCHORED (untouched natural terrain: part of the planet).
// The background layer (trees, back walls...) lives in a second buffer, see "aux".
#define ST_ANCHOR 0x40000000u
#define ST_MAX 63u
uint stOf(uint c) { return (c >> 24) & 63u; }
uint withST(uint c, uint st) { return (c & 0xc0ffffffu) | (min(st, ST_MAX) << 24); }
// changing a cell's material resets its structure state (not anchored, support 0)
uint withFG(uint c, uint t, uint life) { return t | (c & 0xff00u) | (life << 16); }
// what excavating a material puts in the satchel
uint collectAs(uint t) { return t == M_TIMBER ? M_WOOD : (t == M_LITTER ? M_LEAF : (t == M_OPENCHEST ? M_PLANK : t)); }
layout(std140, binding = 15) uniform PC { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

uint hashu(uint x) {
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}
float rnd3(uint a, uint b, uint c) { return float(hashu(a ^ hashu(b ^ hashu(c)))) * (1.0 / 4294967296.0); }
float h2(ivec2 p, int s) {
	return float(hashu(uint(p.x) * 73856093u ^ hashu(uint(p.y) * 19349663u ^ uint(s) * 83492791u))) * (1.0 / 4294967296.0);
}
float vnoise(vec2 p, int s) {
	vec2 i = floor(p); vec2 f = p - i; vec2 u = f * f * (3.0 - 2.0 * f);
	ivec2 ii = ivec2(i);
	float a = h2(ii, s), b = h2(ii + ivec2(1, 0), s), c = h2(ii + ivec2(0, 1), s), d = h2(ii + ivec2(1, 1), s);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p, int s, int oct) {
	float sum = 0.0, amp = 1.0, norm = 0.0;
	for (int o = 0; o < oct; o++) { sum += vnoise(p, s + o * 101) * amp; norm += amp; amp *= 0.5; p *= 2.03; }
	return sum / norm;
}

int shellOf(int y) {
	if (y < SH_Y0[1]) return 0;
	if (y < SH_Y0[2]) return 1;
	if (y < SH_Y0[3]) return 2;
	return 3;
}
int wrapc(int x, int n) { x = x % n; return x < 0 ? x + n : x; }
int cellIdx(int s, int y, int x) { return SH_OFF[s] + (y - SH_Y0[s]) * SH_N[s] + x; }
vec2 cellCenter(int s, int y, int x) {
	float r = R_TOP - (float(y) + 0.5);
	float th = (float(x) + 0.5) / float(SH_N[s]) * TAU;
	return vec2(cos(th), sin(th)) * r;
}
float angleOf(vec2 p) { float t = atan(p.y, p.x); return t < 0.0 ? t + TAU : t; }
// index of the cell containing world position p, or -1 outside the simulated shells
int idxAt(vec2 p) {
	float r = length(p);
	if (r >= R_TOP || r < R_IN) return -1;
	int y = min(int(R_TOP - r), ROWS - 1);
	int s = shellOf(y);
	int x = min(int(angleOf(p) / TAU * float(SH_N[s])), SH_N[s] - 1);
	return cellIdx(s, y, x);
}
vec3 palColor(uint t, uint v) {
	uint c = PAL[t * 4u + (v & 3u)];
	return vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0;
}
// is material t able to move into a cell holding u (falling / flowing)
bool canDisp(uint t, uint u) {
	uint ku = KIND[u];
	if (u == 0u || ku == K_GAS || ku == K_FIRE) return true;
	if (ku == K_LIQUID && DENS[u] < DENS[t]) return true;
	return false;
}
bool isBlock(uint t) { return KIND[t] == K_SOLID || KIND[t] == K_POWDER; }

// ---- binding 0: the planet's cells (type | variant<<8 | life<<16) ----
layout(std430, binding = 0) restrict buffer World { uint cells[]; } world;

uint cellTypeAt(vec2 p) {
	int i = idxAt(p);
	if (i < 0) return length(p) < R_IN ? M_CORE : 0u;
	return world.cells[i] & 255u;
}
// neighbour index: dir 0 = up (outward), 1 = down (inward), 2 = left, 3 = right. -1 if none.
int nbr(int s, int y, int x, int dir) {
	int n = SH_N[s];
	if (dir == 2) return cellIdx(s, y, x == 0 ? n - 1 : x - 1);
	if (dir == 3) return cellIdx(s, y, x == n - 1 ? 0 : x + 1);
	if (dir == 0) {
		int yy = y - 1;
		if (yy < 0) return -1;
		if (yy < SH_Y0[s]) return cellIdx(s - 1, yy, x * 2);
		return cellIdx(s, yy, x);
	}
	int yy = y + 1;
	if (yy >= ROWS) return -1;
	if (yy >= SH_Y0[s + 1]) return cellIdx(s + 1, yy, x / 2);
	return cellIdx(s, yy, x);
}
uint cellAt(vec2 p) {
	int i = idxAt(p);
	if (i < 0) return length(p) < R_IN ? M_CORE : 0u;
	return world.cells[i];
}
uint tAt(int i) { return i < 0 ? 0u : (world.cells[i] & 255u); }

// ---- binding 1: per-frame parameters (array of vec4, see gpu_world.gd for layout) ----
layout(std430, binding = 1) restrict readonly buffer Params { vec4 p[]; } P;

// camera: p[1] = (Cx, Cy, angle, zoom), p[2] = (VW, VH, LS, numLights)
vec2 camR() { float a = P.p[1].z; return vec2(sin(a), -cos(a)); }
vec2 camD() { float a = P.p[1].z; return vec2(-cos(a), -sin(a)); }
// Near the surface (zoom < 2.5) the view is "unrolled": screen x follows the angle around the
// planet (one pixel = one surface column) and screen y the height, so the ground reads flat and
// every building stands straight anywhere on screen. Zoomed out, you see the real round planet.
vec2 screenToWorld(vec2 px) {
	vec2 o = (px - P.p[2].xy * 0.5) * P.p[1].w;
	if (P.p[1].w < 2.5) {
		float th = P.p[1].z - o.x * (TAU / float(SH_N[0]));
		float r = length(P.p[1].xy) - o.y;
		return vec2(cos(th), sin(th)) * r;
	}
	return P.p[1].xy + camR() * o.x + camD() * o.y;
}
vec2 sunDir() { float a = P.p[0].z; return vec2(cos(a), sin(a)); }

// ---- binding 2: surface table, two vec4 per shell-0 column ----
// A = (surfaceR, biome, deepR, magmaR)   B = (coreR, waterlineR, waterMat, blend: b0*16 + b1 + t*0.9)
layout(std430, binding = 2) restrict readonly buffer Surf { vec4 s[]; } S;

int surfCol(float th) { return min(int(th / TAU * float(SH_N[0])), SH_N[0] - 1); }
vec4 surfA(float th) { return S.s[2 * surfCol(th)]; }
vec4 surfB(float th) { return S.s[2 * surfCol(th) + 1]; }

// ---- binding 8: the background layer, one uint per cell ----
// bits 0-7 background material (tree, plant, cave decoration or a building's back wall),
// bits 8-13 support distance (63 = nothing holds it up), bit 14 = built back wall,
// bit 15 = anchored (a generated building's wall: it stays as built until you dig near it).
layout(std430, binding = 8) restrict buffer Aux { uint a[]; } aux;
#define BG_WALL 0x4000u
#define BG_ANCHOR 0x8000u
uint bgAtIdx(int i) { return i < 0 ? 0u : (aux.a[i] & 255u); }
uint bgAtPos(vec2 p) { int i = idxAt(p); return i < 0 ? 0u : (aux.a[i] & 255u); }

layout(local_size_x = 16, local_size_y = 16) in;

void setc(int i, uint c, uint t, uint life) { world.cells[i] = withFG(c, t, life); }

// neighbour coordinates across shells: dir 0 up, 1 down, 2 left, 3 right
ivec3 stepC(int s, int y, int x, int dir) {
	int n = SH_N[s];
	if (dir == 2) return ivec3(s, y, x == 0 ? n - 1 : x - 1);
	if (dir == 3) return ivec3(s, y, x == n - 1 ? 0 : x + 1);
	if (dir == 0) {
		int yy = y - 1;
		if (yy < 0) return ivec3(-1);
		if (yy < SH_Y0[s]) return ivec3(s - 1, yy, x * 2);
		return ivec3(s, yy, x);
	}
	int yy = y + 1;
	if (yy >= ROWS) return ivec3(-1);
	if (yy >= SH_Y0[s + 1]) return ivec3(s + 1, yy, x / 2);
	return ivec3(s, yy, x);
}
uint cellC(ivec3 q) { return q.x < 0 ? 0u : world.cells[cellIdx(q.x, q.y, q.z)]; }
float dayAt(int s, int y, int x) { return clamp(dot(normalize(cellCenter(s, y, x)), sunDir()) * 1.6 + 0.15, 0.0, 1.0); }
int idxC(ivec3 q) { return q.x < 0 ? -1 : cellIdx(q.x, q.y, q.z); }
// which tree a background cell belongs to (bit 31 + bits 16-30, set by the generator; 0 = none).
// Plants only hold each other up within one tree, so cutting a trunk drops that whole tree even
// where its crown touches a neighbour's.
uint plantId(uint a) { return (a & 0x80000000u) != 0u ? (a >> 16) : 0u; }
// background support of a neighbour (62 = none)
uint supAt(ivec3 q, uint id) {
	if (q.x < 0) return 62u;
	uint a = aux.a[cellIdx(q.x, q.y, q.z)];
	return ((a & 255u) != 0u && plantId(a) == id) ? min((a >> 8) & 63u, 62u) : 62u;
}

void main() {
	int s = pc.a.x;
	int y = pc.a.y + int(gl_GlobalInvocationID.y);
	int k = int(gl_GlobalInvocationID.x);
	if (y >= pc.a.z || k >= pc.b.x) return;
	int x = wrapc(pc.a.w + k, SH_N[s]);
	int i = cellIdx(s, y, x);
	uint c = world.cells[i];
	uint t = c & 255u;
	uint fr = uint(pc.b.y);
	float R = rnd3(uint(i), fr, 17u);

	// ---- background objects need support: distance to solid ground through other background cells ----
	// Growing straight up is free (a trunk, a stack of leaves), reaching sideways, hanging or
	// leaning diagonally costs 1, so a tall tree stands while a cut-off piece counts up and drops.
	uint ab = aux.a[i];
	uint bgm = ab & 255u;
	if (bgm != 0u && (ab & BG_WALL) == 0u && (t == 0u || KIND[t] == K_GAS || KIND[t] == K_LIQUID)) {
		ivec3 qU = stepC(s, y, x, 0), qD = stepC(s, y, x, 1), qL = stepC(s, y, x, 2), qR = stepC(s, y, x, 3);
		uint cU = cellC(qU), cD = cellC(qD), cL = cellC(qL), cR = cellC(qR);
		uint ns;
		// touching ground holds it; so does growing up out of mud or water (marsh willows, reeds, kelp)
		if (isBlock(cU & 255u) || isBlock(cD & 255u) || isBlock(cL & 255u) || isBlock(cR & 255u) || KIND[cD & 255u] == K_LIQUID) ns = 0u;
		else {
			uint id = plantId(ab);
			uint mn = min(supAt(qU, id), min(supAt(qL, id), supAt(qR, id)));
			ivec3 qUL = qU.x < 0 ? ivec3(-1) : stepC(qU.x, qU.y, qU.z, 2), qUR = qU.x < 0 ? ivec3(-1) : stepC(qU.x, qU.y, qU.z, 3);
			ivec3 qDL = qD.x < 0 ? ivec3(-1) : stepC(qD.x, qD.y, qD.z, 2), qDR = qD.x < 0 ? ivec3(-1) : stepC(qD.x, qD.y, qD.z, 3);
			mn = min(mn, min(min(supAt(qUL, id), supAt(qUR, id)), min(supAt(qDL, id), supAt(qDR, id))));
			ns = min(min(supAt(qD, id), mn + 1u), 62u);
		}
		uint olds = (ab >> 8) & 63u;
		// A piece that has lost its hold counts up every pass; count in big steps so a cut tree
		// comes down within a few frames instead of hanging in the air. (A piece that is still held
		// only overshoots briefly: it is worked out again from its neighbours next pass.)
		if (ns > olds && olds < 62u) ns = min(max(ns, olds + 6u), 62u);
		if (ns != olds) { ab = (ab & ~0x3f00u) | (ns << 8); aux.a[i] = ab; }
		if (ns >= 62u && olds >= 62u && rnd3(uint(i), fr, 41u) < 0.6) {
			// nothing holds it up any more: it breaks loose as falling debris
			aux.a[i] = 0u;
			if (t == 0u || KIND[t] == K_GAS) world.cells[i] = BGDEBRIS[bgm] | (c & 0xff00u);
			return;
		}
	}
	if (t == 0u) {
		if (y == pc.b.z && R < P.p[3].x) {
			vec2 p = cellCenter(s, y, x);
			if (length(p) > surfA(angleOf(p)).x + 3.0) { setc(i, c, uint(pc.b.w), 1u); return; }  // life 1 = fresh precipitation
		}
		// background plants and wooden walls catch fire from burning neighbours, then are gone
		if (bgm != 0u && FUEL[bgm] > 0u) {
			int nu0 = nbr(s, y, x, 0), nd0 = nbr(s, y, x, 1), nl0 = nbr(s, y, x, 2), nr0 = nbr(s, y, x, 3);
			uint a0 = tAt(nu0), a1 = tAt(nd0), a2 = tAt(nl0), a3 = tAt(nr0);
			bool hot = a0 == M_FIRE || a1 == M_FIRE || a2 == M_FIRE || a3 == M_FIRE;
			bool lava = a0 == M_LAVA || a1 == M_LAVA || a2 == M_LAVA || a3 == M_LAVA;
			if ((hot && R < IGN[bgm] * 1.5) || (lava && R < IGN[bgm] * 3.0)) {
				if (bgm != M_TORCH) { world.cells[i] = M_FIRE | (c & 0xff00u) | (FUEL[bgm] << 16); aux.a[i] = 0u; }
			}
		}
		return;
	}
	uint kd = KIND[t];
	bool inert = kd == K_SOLID && FUEL[t] == 0u && t != M_ICE && t != M_FROST && t != M_GRASS && t != M_SAND;
	if (inert) return;
	uint life = (c >> 16) & 255u;
	int nu = nbr(s, y, x, 0), nd = nbr(s, y, x, 1), nl = nbr(s, y, x, 2), nr = nbr(s, y, x, 3);
	uint tu = tAt(nu), td = tAt(nd), tl = tAt(nl), tr = tAt(nr);
	bool nWater = tu == M_WATER || td == M_WATER || tl == M_WATER || tr == M_WATER;
	bool nLava = tu == M_LAVA || td == M_LAVA || tl == M_LAVA || tr == M_LAVA;
	bool nFire = tu == M_FIRE || td == M_FIRE || tl == M_FIRE || tr == M_FIRE;

	if (t == M_FIRE) {
		if (nWater) { setc(i, c, M_STEAM, 30u); return; }
		if (life <= 1u) {
			float r2 = rnd3(uint(i), fr, 23u);
			if (r2 < 0.3) setc(i, c, M_SMOKE, 40u + uint(r2 * 150.0));
			else if (r2 < 0.34) setc(i, c, M_ASH, 0u);
			else setc(i, c, 0u, 0u);
			return;
		}
		setc(i, c, M_FIRE, life - 1u);
		return;
	}
	if (FUEL[t] > 0u) {
		if ((nFire && R < IGN[t]) || (nLava && R < IGN[t] * 2.0)) { setc(i, c, M_FIRE, FUEL[t]); return; }
		if (t == M_GRASS && R < 0.01 && nu >= 0 && isBlock(tu) && tu != M_LEAF && tu != M_WOOD) setc(i, c, M_DIRT, 0u);
		return;
	}
	if (kd == K_GAS) {
		if (life <= 1u) {
			if (t == M_STEAM && R < 0.3) setc(i, c, M_WATER, 0u); else setc(i, c, 0u, 0u);
		} else setc(i, c, t, life - 1u);
		return;
	}
	if (t == M_LAVA) {
		if (nWater) setc(i, c, M_OBSIDIAN, 0u);
		return;
	}
	if (t == M_WATER) {
		if (nLava) { setc(i, c, M_STEAM, 60u + uint(R * 60.0)); return; }
		bool nFrost = tu == M_FROST || td == M_FROST || tl == M_FROST || tr == M_FROST;
		if (nFrost && R < 0.02) { setc(i, c, M_ICE, 0u); return; }
		// thin puddles soak into soil
		if (tu == 0u && (td == M_DIRT || td == M_GRASS || td == M_SAND) && R < 0.002) { setc(i, c, 0u, 0u); return; }
		if (life == 1u) {
			// rain water: merges into lakes instead of raising them forever, and dries up in the sun
			if (td == M_WATER && R < 0.04) { setc(i, c, 0u, 0u); return; }
			if (tu == 0u && R < 0.0025 * dayAt(s, y, x)) { setc(i, c, 0u, 0u); return; }
		}
		return;
	}
	if (t == M_SAND) { if (nLava && R < 0.003) setc(i, c, M_GLASS, 0u); return; }
	if (t == M_ICE || t == M_SNOW) { if ((nLava || nFire) && R < 0.05) { setc(i, c, M_WATER, 0u); return; } }
	if ((t == M_SNOW || t == M_ASH) && tu == 0u) {
		// exposed snow melts in sunlight (slowly in cold biomes); ash slowly blows away
		vec2 p = cellCenter(s, y, x);
		int b = int(surfA(angleOf(p)).y);
		bool cold = (int(P.p[9 + 2 * b].w) & 15) == 2;
		float rate = t == M_SNOW ? (cold ? 0.00002 : 0.0007) * dayAt(s, y, x) : 0.0002;
		if (R < rate) { setc(i, c, t == M_SNOW ? M_WATER : 0u, 1u); return; }
		// fresh snowfall / ashfall packs down once a drift is deep
		if (life == 1u && rnd3(uint(i), fr, 29u) < 0.03) {
			ivec3 q = ivec3(s, y, x);
			int depth = 0;
			for (int k = 0; k < 6; k++) { q = stepC(q.x, q.y, q.z, 1); if (q.x < 0 || (cellC(q) & 255u) != t) break; depth++; }
			if (depth >= 5) { setc(i, c, 0u, 0u); return; }
		}
	}
	if (t == M_ICE || t == M_SNOW) return;
	if (t == M_FROST) return;
}

