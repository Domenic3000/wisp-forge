const uint PAL[192] = uint[192](1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u);
// Planet generation. One thread per cell; runs once per planet in row bands.
// pc.a = (shell, rowStart, rowEnd, 0)
// ---- shared helpers (pure functions, no buffer access) ----
// Main cell layout: bits 0-7 foreground material, 8-15 colour variant, 16-23 life
// (for falling blocks: how far they have fallen), 24-29 SUPPORT distance (how far
// this solid reaches out from something resting on the ground; above SPAN[t] it
// breaks loose), bit 30 ANCHORED (untouched natural terrain: part of the planet).
// The background layer (trees, back walls...) lives in a second buffer, see "aux".
#define ST_ANCHOR 0x40000000u
#define ST_MAX 63u
uint stOf(uint c) { return (c >> 24) & 63u; }
uint withST(uint c, uint st) { return (c & 0xc0ffffffu) | (min(st, ST_MAX) << 24); }
// changing a cell's material resets its structure state (not anchored, support 0)
uint withFG(uint c, uint t, uint life) { return t | (c & 0xff00u) | (life << 16); }
// what excavating a material puts in the satchel
uint collectAs(uint t) { return t == M_TIMBER ? M_WOOD : (t == M_LITTER ? M_LEAF : (t == M_OPENCHEST ? M_PLANK : t)); }
layout(std140, binding = 15) uniform PC { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

uint hashu(uint x) {
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}
float rnd3(uint a, uint b, uint c) { return float(hashu(a ^ hashu(b ^ hashu(c)))) * (1.0 / 4294967296.0); }
float h2(ivec2 p, int s) {
	return float(hashu(uint(p.x) * 73856093u ^ hashu(uint(p.y) * 19349663u ^ uint(s) * 83492791u))) * (1.0 / 4294967296.0);
}
float vnoise(vec2 p, int s) {
	vec2 i = floor(p); vec2 f = p - i; vec2 u = f * f * (3.0 - 2.0 * f);
	ivec2 ii = ivec2(i);
	float a = h2(ii, s), b = h2(ii + ivec2(1, 0), s), c = h2(ii + ivec2(0, 1), s), d = h2(ii + ivec2(1, 1), s);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p, int s, int oct) {
	float sum = 0.0, amp = 1.0, norm = 0.0;
	for (int o = 0; o < oct; o++) { sum += vnoise(p, s + o * 101) * amp; norm += amp; amp *= 0.5; p *= 2.03; }
	return sum / norm;
}

int shellOf(int y) {
	if (y < SH_Y0[1]) return 0;
	if (y < SH_Y0[2]) return 1;
	if (y < SH_Y0[3]) return 2;
	return 3;
}
int wrapc(int x, int n) { x = x % n; return x < 0 ? x + n : x; }
int cellIdx(int s, int y, int x) { return SH_OFF[s] + (y - SH_Y0[s]) * SH_N[s] + x; }
vec2 cellCenter(int s, int y, int x) {
	float r = R_TOP - (float(y) + 0.5);
	float th = (float(x) + 0.5) / float(SH_N[s]) * TAU;
	return vec2(cos(th), sin(th)) * r;
}
float angleOf(vec2 p) { float t = atan(p.y, p.x); return t < 0.0 ? t + TAU : t; }
// index of the cell containing world position p, or -1 outside the simulated shells
int idxAt(vec2 p) {
	float r = length(p);
	if (r >= R_TOP || r < R_IN) return -1;
	int y = min(int(R_TOP - r), ROWS - 1);
	int s = shellOf(y);
	int x = min(int(angleOf(p) / TAU * float(SH_N[s])), SH_N[s] - 1);
	return cellIdx(s, y, x);
}
vec3 palColor(uint t, uint v) {
	uint c = PAL[t * 4u + (v & 3u)];
	return vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0;
}
// is material t able to move into a cell holding u (falling / flowing)
bool canDisp(uint t, uint u) {
	uint ku = KIND[u];
	if (u == 0u || ku == K_GAS || ku == K_FIRE) return true;
	if (ku == K_LIQUID && DENS[u] < DENS[t]) return true;
	return false;
}
bool isBlock(uint t) { return KIND[t] == K_SOLID || KIND[t] == K_POWDER; }

// ---- binding 0: the planet's cells (type | variant<<8 | life<<16) ----
layout(std430, binding = 0) restrict buffer World { uint cells[]; } world;

uint cellTypeAt(vec2 p) {
	int i = idxAt(p);
	if (i < 0) return length(p) < R_IN ? M_CORE : 0u;
	return world.cells[i] & 255u;
}
// neighbour index: dir 0 = up (outward), 1 = down (inward), 2 = left, 3 = right. -1 if none.
int nbr(int s, int y, int x, int dir) {
	int n = SH_N[s];
	if (dir == 2) return cellIdx(s, y, x == 0 ? n - 1 : x - 1);
	if (dir == 3) return cellIdx(s, y, x == n - 1 ? 0 : x + 1);
	if (dir == 0) {
		int yy = y - 1;
		if (yy < 0) return -1;
		if (yy < SH_Y0[s]) return cellIdx(s - 1, yy, x * 2);
		return cellIdx(s, yy, x);
	}
	int yy = y + 1;
	if (yy >= ROWS) return -1;
	if (yy >= SH_Y0[s + 1]) return cellIdx(s + 1, yy, x / 2);
	return cellIdx(s, yy, x);
}
uint cellAt(vec2 p) {
	int i = idxAt(p);
	if (i < 0) return length(p) < R_IN ? M_CORE : 0u;
	return world.cells[i];
}
uint tAt(int i) { return i < 0 ? 0u : (world.cells[i] & 255u); }

// ---- binding 1: per-frame parameters (array of vec4, see gpu_world.gd for layout) ----
layout(std430, binding = 1) restrict readonly buffer Params { vec4 p[]; } P;

// camera: p[1] = (Cx, Cy, angle, zoom), p[2] = (VW, VH, LS, numLights)
vec2 camR() { float a = P.p[1].z; return vec2(sin(a), -cos(a)); }
vec2 camD() { float a = P.p[1].z; return vec2(-cos(a), -sin(a)); }
// Near the surface (zoom < 2.5) the view is "unrolled": screen x follows the angle around the
// planet (one pixel = one surface column) and screen y the height, so the ground reads flat and
// every building stands straight anywhere on screen. Zoomed out, you see the real round planet.
vec2 screenToWorld(vec2 px) {
	vec2 o = (px - P.p[2].xy * 0.5) * P.p[1].w;
	if (P.p[1].w < 2.5) {
		float th = P.p[1].z - o.x * (TAU / float(SH_N[0]));
		float r = length(P.p[1].xy) - o.y;
		return vec2(cos(th), sin(th)) * r;
	}
	return P.p[1].xy + camR() * o.x + camD() * o.y;
}
vec2 sunDir() { float a = P.p[0].z; return vec2(cos(a), sin(a)); }

// ---- binding 2: surface table, two vec4 per shell-0 column ----
// A = (surfaceR, biome, deepR, magmaR)   B = (coreR, waterlineR, waterMat, blend: b0*16 + b1 + t*0.9)
layout(std430, binding = 2) restrict readonly buffer Surf { vec4 s[]; } S;

int surfCol(float th) { return min(int(th / TAU * float(SH_N[0])), SH_N[0] - 1); }
vec4 surfA(float th) { return S.s[2 * surfCol(th)]; }
vec4 surfB(float th) { return S.s[2 * surfCol(th) + 1]; }

// ---- binding 8: the background layer, one uint per cell ----
// bits 0-7 background material (tree, plant, cave decoration or a building's back wall),
// bits 8-13 support distance (63 = nothing holds it up), bit 14 = built back wall,
// bit 15 = anchored (a generated building's wall: it stays as built until you dig near it).
layout(std430, binding = 8) restrict buffer Aux { uint a[]; } aux;
#define BG_WALL 0x4000u
#define BG_ANCHOR 0x8000u
uint bgAtIdx(int i) { return i < 0 ? 0u : (aux.a[i] & 255u); }
uint bgAtPos(vec2 p) { int i = idxAt(p); return i < 0 ? 0u : (aux.a[i] & 255u); }

// building sites (shell-0 column ranges) where no trees grow: s[0].x = count, s[1 + k] = (x0, x1, 0, 0)
layout(std430, binding = 9) restrict readonly buffer Sites { vec4 s[]; } sites;
layout(local_size_x = 16, local_size_y = 16) in;

int SEED;

bool onSite(float th, float margin) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(SH_N[0]);
	float N0 = float(SH_N[0]);
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start, 0..N0
		if (d0 < q.y - q.x + margin || d0 > N0 - margin) return true;
	}
	return false;
}

vec4 biomeA(int b) { return P.p[8 + 2 * b]; }   // off, amp, topMat, flags
vec4 biomeB(int b) { return P.p[9 + 2 * b]; }   // subMat, topD, subD, ug + flora*16

// how many surface columns from the nearest building site (0 inside one)
float siteDist(float th) {
	int n = int(sites.s[0].x);
	float col = th / TAU * float(SH_N[0]);
	float N0 = float(SH_N[0]);
	float best = 1e6;
	for (int k = 0; k < n; k++) {
		vec4 q = sites.s[1 + k];
		float d0 = col - q.x; d0 -= N0 * floor(d0 / N0);   // columns past the site start
		float len = q.y - q.x;
		float dist = d0 <= len ? 0.0 : min(d0 - len, N0 - d0);
		best = min(best, dist);
	}
	return best;
}

// Caves: winding tunnels (a thin band of one noise field) and caverns (high values of another).
// How much cave there is fades smoothly, never stopping at a hard line: toward the surface
// (except at cave mouths) and toward building sites (so foundations don't hang over a hole),
// the tunnels narrow to rounded tips and the caverns shrink, instead of ending in flat walls.
bool carvedAt(vec2 p, float r, float rs, float coreR) {
	float d = rs - r;
	if (d < 2.0 || r <= coreR + 3.0) return false;
	float th = angleOf(p);
	float entr = fbm(normalize(p) * RS0 / 34.0, SEED + 11, 1);
	float wob = (fbm(p / 23.0, SEED + 13, 2) - 0.5) * 14.0;
	float ks = entr >= 0.72 ? 1.0 : smoothstep(6.0, 22.0, d + wob);
	float kt = d > 75.0 ? 1.0 : max(smoothstep(4.0, 34.0, siteDist(th) + wob), smoothstep(40.0, 75.0, d + wob));
	float k = ks * kt;
	if (k < 0.02) return false;
	float df = clamp(d / max(rs - coreR, 1.0), 0.0, 1.0);
	// tunnels and caverns sized for the 17-cell-tall mage (scaled up 1.4x)
	float n1 = fbm(p / 62.0, SEED + 10, 2);
	if (abs(n1 - 0.5) < (0.022 + 0.016 * df) * k) return true;
	if (d > 24.0) {
		float n2 = fbm(p / 110.0, SEED + 12, 2);
		if (n2 > 0.675 - 0.07 * df + (1.0 - k) * 0.3 + (1.0 - smoothstep(24.0, 40.0, d)) * 0.1) return true;
	}
	return false;
}

// is the base terrain (strata minus caves) solid at p?
bool solidAt(vec2 p) {
	float r = length(p);
	if (r < R_IN) return true;
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	if (r >= sa.x) return false;
	return !carvedAt(p, r, sa.x, sb.x);
}

// Loose powders (sand, gravel, snow, ash) are only generated where they can rest. Where one
// would sit over a cave, on a steep slope, or around a building site (whose yard is dug out of
// the hillside), it is generated as the solid it packs into instead, so nothing pours down the
// moment you arrive.
uint packedSolid(uint m) {
	if (m == M_SAND) return M_SANDSTONE;
	if (m == M_SNOW) return M_ICE;
	return M_STONE;   // gravel, ash
}
uint settleSafe(uint m, vec2 p, float r, float th, float rs) {
	if (KIND[m] != K_POWDER) return m;
	vec2 dn = -p / r;
	if (!solidAt(p + dn)) return packedSolid(m);                       // over a cave
	float d = rs - r;
	if (d < 14.0) {
		float stp = 1.0 / RS0;
		float sl = max(abs(surfA(th - 2.0 * stp).x - rs), abs(surfA(th + 2.0 * stp).x - rs)) * 0.5;
		if (sl > 0.85) return packedSolid(m);                          // a steep face
		if (onSite(th, 14.0)) return packedSolid(m);                   // around a building's yard
	}
	return m;
}

float oreN(vec2 p, int k) { return fbm(p / 6.5 + vec2(float(k) * 17.3, float(k) * 9.1), SEED + 20 + k, 2); }

uint strata(vec2 p, float r, float th, vec4 sa, vec4 sb, int b) {
	float rs = sa.x, deepR = sa.z, magmaR = sa.w, coreR = sb.x;
	vec4 A = biomeA(b), B = biomeB(b);
	int flags = int(A.w);
	int ug = int(B.w) & 15;
	float d = rs - r;
	float subD = B.z + floor(h2(ivec2(int(th * RS0), 3), SEED) * 6.0);
	bool snowy = (flags & 1) != 0 && rs > RS0 + 48.0;
	uint m;
	if (snowy && d < 3.0) m = M_SNOW;
	else if (d < B.y) m = uint(A.z);
	else if (d < B.y + subD) m = uint(B.x);
	else if (r > deepR) m = M_STONE;
	else if (r > magmaR) m = M_DEEPSTONE;
	else if (r > coreR) m = M_MAGMAROCK;
	else return M_CORE;

	// ores and pockets
	float rich = (P.p[7].w - 1.0) * 0.03;
	if (m == M_STONE) {
		if (oreN(p, 0) > 0.815 - rich) return M_COPPER;
		if (oreN(p, 1) > 0.815 - rich) return M_COAL;
		if (ug == 1 && oreN(p, 2) > 0.76 - rich) return M_CRYSTAL;
		if (ug == 2 && d < 200.0 && oreN(p, 3) > 0.76 - rich) return M_FROST;
		if (ug == 3 && d < 160.0 && oreN(p, 4) > 0.77 - rich) return M_EMBER;
		if (oreN(p, 6) > 0.82) return M_GRAVEL;
		if (d < 100.0 && oreN(p, 7) > 0.82) return M_DIRT;
	} else if (m == M_DEEPSTONE) {
		float dd = (deepR - r) / max(deepR - magmaR, 1.0);
		if (dd > 0.4 && oreN(p, 4) > 0.82 - rich) return M_EMBER;
		if (oreN(p, 5) > 0.82 - rich) return M_WISP;
		if (oreN(p, 2) > 0.84 - rich) return M_CRYSTAL;
		if (oreN(p, 3) > 0.85 - rich) return M_FROST;
	} else if (m == M_MAGMAROCK) {
		if (oreN(p, 4) > 0.80 - rich) return M_EMBER;
		if (oreN(p, 8) > 0.79) return M_OBSIDIAN;
		if (oreN(p, 9) > 0.78) return M_DEEPSTONE;
	}
	return m;
}

// ---- trees: one kind per biome, sized for the 17-cell mage -----------------------------
// Each tree is evaluated per cell. q = (da, dy) is the offset from the tree's base: da along
// the surface, dy up. hh, h3 and h4 are the tree's own random numbers.
float segDist(vec2 q, vec2 a, vec2 b) {
	vec2 pa = q - a, ba = b - a;
	float t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * t);
}

// broad oak: a flared trunk, two branches and a lumpy crown of overlapping blobs; some are giants
uint oakTree(vec2 q, float hh, float h3, float h4, float nz) {
	bool giant = h3 < 0.12;
	float h = giant ? 58.0 + floor(hh * 14.0) : 30.0 + floor(hh * 24.0);
	float tw = giant ? 5.0 : (h > 42.0 ? 4.0 : 3.0);
	float R = 9.0 + h * 0.16;
	float da = q.x, dy = q.y;
	float hw = tw * 0.5 + max(0.0, 3.0 - dy) * 0.7;
	if (dy >= 0.0 && dy < h - R * 0.3 && abs(da) < hw) return M_WOOD;
	float side = h4 < 0.5 ? 1.0 : -1.0;
	if (segDist(q, vec2(0.0, h * 0.5), vec2(side * R * 0.55, h - R * 0.35)) < (giant ? 1.4 : 1.0)) return M_WOOD;
	if (segDist(q, vec2(0.0, h * 0.62), vec2(-side * R * 0.5, h - R * 0.2)) < 0.9) return M_WOOD;
	float rag = 1.0 - nz * 0.28;
	vec2 c0 = vec2(0.0, h), c1 = vec2(-R * 0.55, h - R * 0.3), c2 = vec2(R * 0.55, h - R * 0.25), c3 = vec2(R * 0.2 * side, h + R * 0.35);
	float e = min(min(length((q - c0) / vec2(R, R * 0.8)), length((q - c1) / vec2(R * 0.62, R * 0.5))),
	              min(length((q - c2) / vec2(R * 0.62, R * 0.52)), length((q - c3) / vec2(R * 0.6, R * 0.45))));
	if (e < rag) return M_LEAF;
	return 0u;
}

// pine: a straight trunk under tiers of needles, each tier wide at the bottom; snow on the tiers
uint pineTree(vec2 q, float hh, float h3, bool snowy) {
	float h = 28.0 + floor(hh * 30.0) + (h3 < 0.1 ? 18.0 : 0.0);
	float tw = h > 45.0 ? 3.0 : 2.0;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	float dy0 = 5.0 + h * 0.08;
	float P = 5.0 + h * 0.05;
	if (dy >= dy0 && dy <= h + 2.0) {
		float w = (h + 2.0 - dy) * 0.26 * (1.0 - 0.45 * fract((dy - dy0) / P)) + 0.6;
		if (abs(da) < w) {
			float dyU = dy + 1.0;
			float wU = dyU > h + 2.0 ? 0.0 : (h + 2.0 - dyU) * 0.26 * (1.0 - 0.45 * fract((dyU - dy0) / P)) + 0.6;
			return (snowy && abs(da) >= wU) ? M_SNOW : M_LEAF;
		}
	}
	if (dy < h && abs(da) < tw * 0.5) return M_WOOD;
	return 0u;
}

// saguaro: a thick column with arms that elbow out and turn up
uint cactusTree(vec2 q, float hh, float h3) {
	float h = 10.0 + floor(hh * 12.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < 1.5) return M_CACTUS;
	if (dy < h + 1.0 && abs(da) < 0.9) return M_CACTUS;
	float a1 = floor(h * (0.3 + h3 * 0.15)), a2 = floor(h * (0.45 + hh * 0.15));
	if (dy >= a1 && dy < a1 + 2.0 && da <= -1.5 && da > -4.5) return M_CACTUS;
	if (dy >= a1 && dy < a1 + floor(h * 0.4) && da <= -3.0 && da > -5.0) return M_CACTUS;
	if (h > 14.0) {
		if (dy >= a2 && dy < a2 + 2.0 && da >= 1.5 && da < 4.5) return M_CACTUS;
		if (dy >= a2 && dy < a2 + floor(h * 0.3) && da >= 3.0 && da < 5.0) return M_CACTUS;
	}
	return 0u;
}

// palm: a leaning, curving trunk with drooping fronds
uint palmTree(vec2 q, float hh, float h3) {
	float h = 20.0 + floor(hh * 14.0);
	float lean = (h3 < 0.5 ? 1.0 : -1.0) * (3.0 + h3 * 6.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h) {
		float t = dy / h;
		if (abs(da - lean * t * t) < 1.1) return M_WOOD;
	}
	vec2 top = vec2(lean, h);
	if (length(q - top - vec2(0.0, 1.0)) < 2.0) return M_LEAF;
	for (int k = 0; k < 3; k++) {
		float fk = float(k);
		float L = 8.0 + fk * 2.5;
		for (int sd = -1; sd <= 1; sd += 2) {
			float x = (da - lean) * float(sd);
			if (x < 0.0 || x > L) continue;
			float yf = h + 2.0 + fk * 0.8 - 0.07 * (1.0 + 0.5 * fk) * x * x;
			if (abs(dy - yf) < 0.8) return M_LEAF;
		}
	}
	return 0u;
}

// willow: a thick trunk, a low dome of leaves and long strands hanging from it
uint willowTree(vec2 q, float hh, float h3, int bb, float nz) {
	float h = 22.0 + floor(hh * 14.0);
	float R = 11.0 + h3 * 5.0;
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < 1.5 + max(0.0, 2.0 - dy) * 0.6) return M_WOOD;
	float e = length((q - vec2(0.0, h)) / vec2(R, R * 0.55));
	if (dy >= h - 2.0 && e < 1.0 - nz * 0.2) return M_LEAF;
	if (abs(da) < R * 0.95 && dy < h - 1.0) {
		int ci = int(floor(da + 200.0));
		float hs = h2(ivec2(bb * 7 + ci, 91), SEED);
		float Ls = R * 0.5 + h2(ivec2(bb * 7 + ci, 92), SEED) * R * 0.9;
		if (hs < 0.55 && dy > max(2.0, h - 1.0 - Ls)) return M_LEAF;
	}
	return 0u;
}

// charred tree: a burnt black trunk with bare, jagged branches
uint charredTree(vec2 q, float hh, int bb) {
	float h = 18.0 + floor(hh * 22.0);
	float da = q.x, dy = q.y;
	if (dy < 0.0) return 0u;
	if (dy < h && abs(da) < (h > 30.0 ? 1.5 : 1.0) + max(0.0, 2.0 - dy) * 0.5) return M_COAL;
	for (int k = 0; k < 4; k++) {
		float hk = h2(ivec2(bb, 90 + k), SEED);
		float y0 = h * (0.35 + 0.15 * float(k));
		float sd = (k % 2 == 0) ? 1.0 : -1.0;
		if (hk < 0.3) sd = -sd;
		float L = 5.0 + hk * 8.0;
		vec2 a = vec2(0.0, y0), b = vec2(sd * L * 0.8, y0 + L * 0.7);
		if (segDist(q, a, b) < 0.7) return M_COAL;
		if (segDist(q, b, b + vec2(sd * 2.5, 3.5 - hk * 3.0)) < 0.6) return M_COAL;
	}
	return 0u;
}

uint floraId = 0u;   // which tree the cell flora() returned belongs to (aux bits 16-31, see react.comp)
// trees and other surface plants, evaluated per cell from hashed "buckets" along the surface arc
uint flora(vec2 p, float r, float th, int floraType, bool inWater) {
	float arc = th * RS0;
	// One spacing grid for every kind of tree, and each tree takes its kind from the biome at its
	// own trunk, so a crown reaching over a biome border is still drawn whole (it used to switch
	// kind column by column there and get cut off). Density per kind: oaks, pines, cacti, willows,
	// charred trees, palms.
	float BW = 14.0;
	float nB = floor(TAU * RS0 / BW);
	float L = nB * BW;
	int b = int(floor(arc / BW));
	float spawnA = P.p[121].x;
	float nz = h2(ivec2(int(arc), int(r)), SEED + 5);
	for (int k = -2; k <= 2; k++) {
		int bb = int(mod(float(b + k), nB));
		float hb = h2(ivec2(bb, 77), SEED);
		float st = (float(bb) + 0.2 + 0.6 * h2(ivec2(bb, 78), SEED)) * BW;
		float da = arc - st; da -= floor(da / L + 0.5) * L;
		if (abs(da) > 26.0) continue;
		float tth = st / RS0;
		vec4 ta = surfA(tth), tb = surfB(tth);
		int ft = int(biomeB(int(ta.y)).w) >> 4;
		float dens = ft == 1 ? 0.62 : (ft == 2 ? 0.7 : (ft == 4 ? 0.32 : (ft == 5 ? 0.33 : (ft == 3 ? 0.22 : (ft == 6 ? 0.24 : 0.0)))));
		if (hb >= dens) continue;
		float sp = abs(tth - spawnA); sp = min(sp, TAU - sp);
		if (sp * RS0 < 30.0) continue;
		if (onSite(tth, 26.0)) continue;
		if (tb.y > ta.x + 0.5) continue; // trunk would be underwater
		float base = floor(ta.x);
		vec2 q = vec2(da, r - base);
		if (q.y > 95.0) continue;
		float hh = h2(ivec2(bb, 79), SEED), h3 = h2(ivec2(bb, 83), SEED), h4 = h2(ivec2(bb, 84), SEED);
		uint m = 0u;
		if (ft == 1) m = oakTree(q, hh, h3, h4, nz);
		else if (ft == 2) {
			vec4 A = biomeA(int(ta.y));
			bool snowy = uint(A.z) == M_SNOW || ((int(A.w) & 1) != 0 && ta.x > RS0 + 20.0);
			m = pineTree(q, hh, h3, snowy);
		}
		else if (ft == 3) m = hb < 0.05 ? palmTree(q, hh, h3) : cactusTree(q, hh, h3);
		else if (ft == 4) m = willowTree(q, hh, h3, bb, nz);
		else if (ft == 5) m = charredTree(q, hh, bb);
		else if (ft == 6) m = palmTree(q, hh, h3);
		if (m != 0u) { floraId = 0x8000u | uint(bb + 1); return m; }
	}
	// undergrowth and small plants
	if (onSite(th, 1.0)) return 0u;
	int col = int(floor(arc));
	vec4 sa = surfA(th);
	float dy = r - floor(sa.x);
	if (dy < 0.0) return 0u;
	if (floraType == 1 || floraType == 2 || floraType == 4) {
		// bushes (and young pines in pine country)
		float bw2 = 9.0;
		int b2 = int(floor(arc / bw2));
		for (int k = -1; k <= 1; k++) {
			int bb = b2 + k;
			float hb = h2(ivec2(bb, 85), SEED);
			if (hb > (floraType == 4 ? 0.3 : 0.5)) continue;
			float cx = (float(bb) + 0.5) * bw2;
			float dx = arc - cx;
			vec4 ba = surfA(cx / RS0);
			float by = r - floor(ba.x);
			if (floraType == 2) {
				float hs = 4.0 + floor(hb * 8.0);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 1.0 && by < hs && abs(dx) < (hs - by) * 0.4 + 0.5) return M_LEAF;
				if (by >= 0.0 && by < 1.0 && abs(dx) < 0.6) return M_WOOD;
			} else {
				float rx = 2.5 + hb * 4.0, ry = 2.0 + hb * 3.0;
				float e = (dx * dx) / (rx * rx) + (by - ry * 0.6) * (by - ry * 0.6) / (ry * ry);
				floraId = 0xC000u | uint(bb + 100000) % 16000u;
				if (by >= 0.0 && e < 1.0 - nz * 0.25) return M_LEAF;
			}
			floraId = 0u;
		}
		// grass tufts
		float hr = h2(ivec2(col, 86), SEED);
		if (floraType != 2 && hr < 0.35 && dy < 1.0 + floor(hr * 9.0)) return M_LEAF;
	}
	if (floraType == 3) {
		float hr = h2(ivec2(col, 87), SEED);
		if (hr < 0.04 && dy < 2.0 + floor(hr * 60.0)) return M_CACTUS;
	}
	if (floraType == 4) {
		float hr = h2(ivec2(col, 80), SEED);
		if (hr < 0.3 && dy < 3.0 + floor(hr * 20.0)) return M_LEAF;
	}
	if (floraType == 6 && inWater) {
		float hr = h2(ivec2(col, 81), SEED);
		if (hr < 0.2 && dy < 4.0 + floor(hr * 50.0)) return M_LEAF;
	}
	return 0u;
}

void main() {
	int s = pc.a.x;
	int x = int(gl_GlobalInvocationID.x);
	int y = pc.a.y + int(gl_GlobalInvocationID.y);
	if (x >= SH_N[s] || y >= pc.a.z || y >= SH_Y0[s + 1]) return;
	SEED = int(P.p[0].w);
	vec2 p = cellCenter(s, y, x);
	float r = length(p);
	float th = angleOf(p);
	vec4 sa = surfA(th), sb = surfB(th);
	int b = int(sa.y);
	// near a biome border, each cell picks one of the two biomes with ragged noise, so the layers
	// (topsoil, dirt, stone, underground biome) interfinger instead of meeting at a straight seam
	{
		float k = floor(sb.w);
		float bt = clamp((sb.w - k) / 0.9, 0.0, 1.0);
		int b0 = int(k) / 16, b1 = int(k) % 16;
		if (b0 != b1) {
			float rag = (fbm(p / 11.0, SEED + 61, 2) - 0.5) * 0.9 + (fbm(p / 47.0, SEED + 62, 2) - 0.5) * 0.6;
			b = (bt + rag) < 0.5 ? b0 : b1;
		}
	}
	float rs = sa.x;
	vec4 B = biomeB(b);
	int ug = int(B.w) & 15;
	int floraType = int(biomeB(int(sa.y)).w) >> 4;   // plants follow the column's biome (whole trees)
	uint m = 0u;
	uint bgm = 0u;   // background decoration (no collisions)

	if (r < rs) {
		m = settleSafe(strata(p, r, th, sa, sb, b), p, r, th, rs);
		if (m != M_CORE && carvedAt(p, r, rs, sb.x)) {
			m = 0u;
			// liquid pools resting on cave floors
			float pn = fbm(p / 40.0, SEED + 30, 1);
			if (pn > 0.62) {
				float depth = 2.0 + floor(h2(ivec2(int(p.x / 9.0), int(p.y / 9.0)), SEED + 31) * 5.0);
				vec2 dn = -normalize(p);
				bool floor_ = false;
				for (int k = 1; k <= 6; k++) { if (float(k) > depth) break; if (solidAt(p + dn * float(k))) { floor_ = true; break; } }
				if (floor_) {
					float lavaMul = P.p[7].z;
					if (r > sa.z) m = ug == 2 ? M_ICE : M_WATER;
					else if (r > sa.w) m = (r < (sa.z + sa.w) * 0.5 && pn > 0.75 - 0.05 * lavaMul) ? M_LAVA : M_WATER;
					else m = pn > 0.66 - 0.03 * lavaMul ? M_LAVA : 0u;
				}
			}
			// cave plants and crystals growing from the floor (background layer)
			if (m == 0u && r < rs - 10.0) {
				vec2 dn = -normalize(p);
				for (int k = 1; k <= 4; k++) {
					if (solidAt(p + dn * float(k))) {
						float fr = floor(r - float(k));
						float hv = h2(ivec2(int(th * RS0), int(fr)), SEED + 40);
						float hgt = 0.0; uint mat = 0u;
						bool shallow = r > sa.z;
						if (ug == 0 && shallow && hv < 0.11) { mat = M_SHROOM; hgt = 1.0 + mod(floor(hv * 40.0), 3.0); }
						else if (ug == 1 && hv < 0.06) { mat = M_CRYSTAL; hgt = 1.0 + mod(floor(hv * 90.0), 4.0); }
						else if (ug == 2 && shallow && hv < 0.05) { mat = M_ICE; hgt = 1.0 + mod(floor(hv * 90.0), 3.0); }
						else if (ug == 3 && hv < 0.04) { mat = M_EMBER; hgt = 1.0 + mod(floor(hv * 90.0), 2.0); }
						else if (!shallow && r > sa.w && hv < 0.018) { mat = M_SHROOM; hgt = 1.0 + mod(floor(hv * 300.0), 2.0); }
						if (float(k) <= hgt) bgm = mat;
						break;
					}
				}
			}
		}
	} else {
		// above ground: seas / ponds / lava lakes, then plants
		bool wet = sb.y > 0.0 && r < sb.y;
		if (wet) m = uint(sb.z);
		if (r < rs + 100.0) bgm = flora(p, r, th, floraType, wet);
	}

	// the mantle guardian's arena
	vec4 boss = P.p[120];
	if (boss.y > 0.0) {
		vec2 bd = vec2(cos(boss.x), sin(boss.x));
		vec2 q = p - bd * boss.y;
		float u = dot(q, vec2(-bd.y, bd.x)), v = dot(q, bd);
		float e = u * u / (boss.z * boss.z) + v * v / (boss.w * boss.w);
		if (e < 1.0) { m = 0u; bgm = 0u; }
		else if (e < 1.22 && v < 0.0) m = M_OBSIDIAN;
		else if (e < 1.22 && h2(ivec2(x, y), SEED + 50) < 0.12) m = M_EMBER;
	}

	uint v = hashu(uint(x) * 2654435761u ^ uint(y) * 40503u ^ uint(s) * 977u) & 255u;
	int ci = cellIdx(s, y, x);
	// untouched natural solids are anchored: part of the planet until something disturbs them
	world.cells[ci] = m | (v << 8) | (KIND[m] == K_SOLID ? ST_ANCHOR : 0u);
	aux.a[ci] = bgm | (bgm != 0u && floraId != 0u ? floraId << 16 : 0u);
}

