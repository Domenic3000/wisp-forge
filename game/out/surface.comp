// Builds the per-column surface table: terrain height, biome and layer radii.
// ---- shared helpers (pure functions, no buffer access) ----
// Main cell layout: bits 0-7 foreground material, 8-15 colour variant, 16-23 life
// (for falling blocks: how far they have fallen), 24-29 SUPPORT distance (how far
// this solid reaches out from something resting on the ground; above SPAN[t] it
// breaks loose), bit 30 ANCHORED (untouched natural terrain: part of the planet).
// The background layer (trees, back walls...) lives in a second buffer, see "aux".
#define ST_ANCHOR 0x40000000u
#define ST_MAX 63u
uint stOf(uint c) { return (c >> 24) & 63u; }
uint withST(uint c, uint st) { return (c & 0xc0ffffffu) | (min(st, ST_MAX) << 24); }
// changing a cell's material resets its structure state (not anchored, support 0)
uint withFG(uint c, uint t, uint life) { return t | (c & 0xff00u) | (life << 16); }
// what excavating a material puts in the satchel
uint collectAs(uint t) { return t == M_TIMBER ? M_WOOD : (t == M_LITTER ? M_LEAF : (t == M_OPENCHEST ? M_PLANK : t)); }
layout(std140, binding = 15) uniform PC { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

uint hashu(uint x) {
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}
float rnd3(uint a, uint b, uint c) { return float(hashu(a ^ hashu(b ^ hashu(c)))) * (1.0 / 4294967296.0); }
float h2(ivec2 p, int s) {
	return float(hashu(uint(p.x) * 73856093u ^ hashu(uint(p.y) * 19349663u ^ uint(s) * 83492791u))) * (1.0 / 4294967296.0);
}
float vnoise(vec2 p, int s) {
	vec2 i = floor(p); vec2 f = p - i; vec2 u = f * f * (3.0 - 2.0 * f);
	ivec2 ii = ivec2(i);
	float a = h2(ii, s), b = h2(ii + ivec2(1, 0), s), c = h2(ii + ivec2(0, 1), s), d = h2(ii + ivec2(1, 1), s);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p, int s, int oct) {
	float sum = 0.0, amp = 1.0, norm = 0.0;
	for (int o = 0; o < oct; o++) { sum += vnoise(p, s + o * 101) * amp; norm += amp; amp *= 0.5; p *= 2.03; }
	return sum / norm;
}

int shellOf(int y) {
	if (y < SH_Y0[1]) return 0;
	if (y < SH_Y0[2]) return 1;
	if (y < SH_Y0[3]) return 2;
	return 3;
}
int wrapc(int x, int n) { x = x % n; return x < 0 ? x + n : x; }
int cellIdx(int s, int y, int x) { return SH_OFF[s] + (y - SH_Y0[s]) * SH_N[s] + x; }
vec2 cellCenter(int s, int y, int x) {
	float r = R_TOP - (float(y) + 0.5);
	float th = (float(x) + 0.5) / float(SH_N[s]) * TAU;
	return vec2(cos(th), sin(th)) * r;
}
float angleOf(vec2 p) { float t = atan(p.y, p.x); return t < 0.0 ? t + TAU : t; }
// index of the cell containing world position p, or -1 outside the simulated shells
int idxAt(vec2 p) {
	float r = length(p);
	if (r >= R_TOP || r < R_IN) return -1;
	int y = min(int(R_TOP - r), ROWS - 1);
	int s = shellOf(y);
	int x = min(int(angleOf(p) / TAU * float(SH_N[s])), SH_N[s] - 1);
	return cellIdx(s, y, x);
}
vec3 palColor(uint t, uint v) {
	uint c = PAL[t * 4u + (v & 3u)];
	return vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0;
}
// is material t able to move into a cell holding u (falling / flowing)
bool canDisp(uint t, uint u) {
	uint ku = KIND[u];
	if (u == 0u || ku == K_GAS || ku == K_FIRE) return true;
	if (ku == K_LIQUID && DENS[u] < DENS[t]) return true;
	return false;
}
bool isBlock(uint t) { return KIND[t] == K_SOLID || KIND[t] == K_POWDER; }

// ---- binding 1: per-frame parameters (array of vec4, see gpu_world.gd for layout) ----
layout(std430, binding = 1) restrict readonly buffer Params { vec4 p[]; } P;

// camera: p[1] = (Cx, Cy, angle, zoom), p[2] = (VW, VH, LS, numLights)
vec2 camR() { float a = P.p[1].z; return vec2(sin(a), -cos(a)); }
vec2 camD() { float a = P.p[1].z; return vec2(-cos(a), -sin(a)); }
// Near the surface (zoom < 2.5) the view is "unrolled": screen x follows the angle around the
// planet (one pixel = one surface column) and screen y the height, so the ground reads flat and
// every building stands straight anywhere on screen. Zoomed out, you see the real round planet.
vec2 screenToWorld(vec2 px) {
	vec2 o = (px - P.p[2].xy * 0.5) * P.p[1].w;
	if (P.p[1].w < 2.5) {
		float th = P.p[1].z - o.x * (TAU / float(SH_N[0]));
		float r = length(P.p[1].xy) - o.y;
		return vec2(cos(th), sin(th)) * r;
	}
	return P.p[1].xy + camR() * o.x + camD() * o.y;
}
vec2 sunDir() { float a = P.p[0].z; return vec2(cos(a), sin(a)); }

layout(std430, binding = 2) restrict buffer Surf { vec4 s[]; } S;
layout(local_size_x = 64) in;

void main() {
	int i = int(gl_GlobalInvocationID.x);
	if (i >= pc.a.x) return;
	float th = (float(i) + 0.5) / float(SH_N[0]) * TAU;
	vec2 dir = vec2(cos(th), sin(th));
	int nb = max(1, int(P.p[4].w));
	float seg = th / TAU * float(nb);
	int bi = int(floor(seg)) % nb;
	float local = fract(seg);
	float E = 0.07;
	int b0 = bi, b1 = bi; float t = 0.0;
	if (local > 1.0 - E) { b1 = (bi + 1) % nb; t = (local - (1.0 - E)) / (2.0 * E); }
	else if (local < E) { b0 = (bi - 1 + nb) % nb; t = 0.5 + local / (2.0 * E); }
	t = t * t * (3.0 - 2.0 * t);
	vec4 A = P.p[8 + 2 * b0], B = P.p[8 + 2 * b1];
	float off = mix(A.x, B.x, t), amp = mix(A.y, B.y, t);
	int bsel = t < 0.5 ? b0 : b1;
	int seed = int(P.p[0].w);
	float n1 = fbm(dir * RS0 / 110.0, seed + 1, 3) - 0.5;
	float n2 = fbm(dir * RS0 / 26.0, seed + 2, 2) - 0.5;
	float rs = RS0 - off - n1 * amp * 3.4 - n2 * amp * 0.7;
	float magmaR = P.p[7].x + (fbm(dir * RS0 / 50.0, seed + 4, 2) - 0.5) * 50.0;
	float deepR = min(RS0 - 270.0 + (fbm(dir * RS0 / 60.0, seed + 3, 2) - 0.5) * 40.0, rs - 40.0);
	deepR = max(deepR, magmaR + 30.0);
	float coreR = 420.0 + (fbm(dir * RS0 / 40.0, seed + 5, 2) - 0.5) * 24.0;

	// surface liquids: sea level, bog ponds, lava lakes
	float flags = P.p[8 + 2 * bsel].w;
	int fl = int(flags);
	float waterR = -1.0, waterMat = float(M_WATER);
	if (P.p[7].y >= 0.0) waterR = RS0 - P.p[7].y;
	if ((fl & 2) != 0) waterR = max(waterR, RS0 - P.p[8 + 2 * bsel].x - 2.0);
	if ((fl & 4) != 0 && waterR < 0.0) { waterR = RS0 - P.p[8 + 2 * bsel].x - 6.0; waterMat = float(M_LAVA); }

	S.s[2 * i] = vec4(rs, float(bsel), deepR, magmaR);
	// the two biomes this column sits between, and how far across the border it is, so the ground
	// can blend their layers instead of switching at one column: (b0 * 16 + b1) + t * 0.9
	S.s[2 * i + 1] = vec4(coreR, waterR, waterMat, float(b0 * 16 + b1) + t * 0.9);
}

