	"k": [0, ["#...", "#...", "#..#", "#.#.", "##..", "#.#.", "#..#"]],
	"l": [0, ["#.", "#.", "#.", "#.", "#.", "#.", ".#"]],
	"m": [2, ["####.", "#.#.#", "#.#.#", "#.#.#", "#.#.#"]],
	"n": [2, ["###.", "#..#", "#..#", "#..#", "#..#"]],
	"o": [2, [".##.", "#..#", "#..#", "#..#", ".##."]],
	"p": [2, ["###.", "#..#", "#..#", "#..#", "###.", "#...", "#..."]],
