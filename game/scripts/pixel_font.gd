static var _cache := {}

## the font (cached): regular, or bold
static func make(bold := false) -> FontFile:
	var key := "b" if bold else "r"
	if _cache.has(key):
		return _cache[key]
	# lay every glyph out on one atlas, a row of cells
	var cells := []
	var x := 1
	var y := 1
	var row_h := 0
	const W := 256
	for ch in GLYPHS:
		var top: int = GLYPHS[ch][0]
		var rows: Array = GLYPHS[ch][1]
		var w := 0
		for r in rows:
			w = maxi(w, (r as String).length())
		if bold and ch != " ":
			w += 1
		var h := rows.size()
		if x + w + 1 > W:
			x = 1
			y += row_h + 1
			row_h = 0
		cells.append([ch, top, rows, w, h, x, y])
		x += w + 1
		row_h = maxi(row_h, h)
	var img := Image.create(W, y + row_h + 2, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	for c in cells:
		var rows2: Array = c[2]
		for j in rows2.size():
			var r2: String = rows2[j]
			for i in r2.length():
				if r2[i] == "#":
					img.set_pixel(int(c[5]) + i, int(c[6]) + j, Color(1, 1, 1, 1))
					if bold:
						img.set_pixel(int(c[5]) + i + 1, int(c[6]) + j, Color(1, 1, 1, 1))
	var f := FontFile.new()
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.generate_mipmaps = false
	f.allow_system_fallback = false
	f.hinting = TextServer.HINTING_NONE
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	var sz := Vector2i(SIZE, 0)
	f.set_texture_image(0, sz, 0, img)
	for c2 in cells:
		var gi := String(c2[0]).unicode_at(0)
		var w2: int = c2[3]
		f.set_glyph_advance(0, SIZE, gi, Vector2(w2 + 1, 0))
		f.set_glyph_offset(0, sz, gi, Vector2(0, int(c2[1]) - 7))
		f.set_glyph_size(0, sz, gi, Vector2(w2, int(c2[4])))
		f.set_glyph_uv_rect(0, sz, gi, Rect2(int(c2[5]), int(c2[6]), w2, int(c2[4])))
		f.set_glyph_texture_idx(0, sz, gi, 0)
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, DESCENT)
	_cache[key] = f
	return f
