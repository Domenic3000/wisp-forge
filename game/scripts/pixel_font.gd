	"B": [0, ["####.", "#...#", "#...#", "####.", "#...#", "#...#", "####."]],
	"C": [0, [".###.", "#...#", "#....", "#....", "#....", "#...#", ".###."]],
	"D": [0, ["###..", "#..#.", "#...#", "#...#", "#...#", "#..#.", "###.."]],
