	"^": [0, [".#.", "#.#"]],
	"_": [7, ["#####"]],
	"`": [0, ["#.", ".#"]],
	"{": [0, ["..#", ".#.", ".#.", "#..", ".#.", ".#.", "..#"]],
	"|": [0, ["#", "#", "#", "#", "#", "#", "#", "#"]],
	"}": [0, ["#..", ".#.", ".#.", "..#", ".#.", ".#.", "#.."]],
	"~": [2, [".#.#", "#.#."]],
	"·": [3, ["#"]],
	"—": [3, ["######"]],
	"–": [3, ["####"]],
	"’": [0, ["#", "#"]],
	"‘": [0, ["#", "#"]],
	"“": [0, ["#.#", "#.#"]],
	"”": [0, ["#.#", "#.#"]],
	"…": [6, ["#.#.#"]],
	"×": [2, ["#...#", ".#.#.", "..#..", ".#.#.", "#...#"]],
	"✓": [1, ["....#", "....#", "...#.", "#..#.", ".##..", ".#..."]],
	"✦": [0, ["..#..", "..#..", ".###.", "#####", ".###.", "..#..", "..#.."]],
	"→": [1, ["..#..", "...#.", "#####", "...#.", "..#.."]],
